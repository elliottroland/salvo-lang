fn main::kind_name(FsError)(lent kind: NotFound | PermissionDenied | AlreadyExists | NotADirectory | PathEscapes | IoError | Streaming) -> Str {
  branch#1 cond#0 check#2 (read kind is arm 0) {
    narrow#3[check#2] kind~1: NotFound = kind
    return "not found"
  }
  narrow#6[after branch#1.cond#0] kind~2: PermissionDenied | AlreadyExists | NotADirectory | PathEscapes | IoError | Streaming = kind
  branch#4 cond#0 check#5 (read kind is arm 3) {
    narrow#7[check#5] kind~3: NotADirectory = kind~2
    return "not a directory"
  }
  narrow#10[after branch#4.cond#0] kind~4: PermissionDenied | AlreadyExists | PathEscapes | IoError | Streaming = kind
  branch#8 cond#0 check#9 (read kind is arm 4) {
    narrow#11[check#9] kind~5: PathEscapes = kind~4
    return "escapes the sandbox"
  }
  narrow#14[after branch#8.cond#0] kind~6: PermissionDenied | AlreadyExists | IoError | Streaming = kind
  branch#12 cond#0 check#13 (read kind is arm 6) {
    narrow#15[check#13] kind~7: Streaming = kind~6
    return call main::kind_name(StreamError)(read kind~7.error)
  }
  return "other"
}

fn main::kind_name(StreamError)(lent kind: InvalidUtf8 | StreamFailed) -> Str {
  branch#1 cond#0 check#2 (read kind is arm 0) {
    narrow#3[check#2] kind~1: InvalidUtf8 = kind
    return "not valid UTF-8"
