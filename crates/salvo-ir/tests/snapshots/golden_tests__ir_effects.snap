module main

interface Clock {
  fn now() -> Int
}

impl TickingClock() of Clock stateful {
  state tick: Int = 0
  fn now() -> Int {
    assign tick = op Add(read tick, 5)
    return !read tick
  }
}

fn main::stamp(lent __eff0: Clock, lent __eff1: Console; lent label: Str) -> None {
  bind#1 let t: Int = member main::Clock#0(read __eff0)
  call main::banner(read __eff1, concat(read label, " at t=", call core.basic::to_str(Int)(read t)))
}

fn main::banner(lent __eff0: Console; lent text: Str) -> None {
  call core.console::println(read __eff0, concat("   ", read text))
}

interface Logger {
  fn log(lent message: Str) -> None
}

impl PlainLogger() of Logger deps [Console] {
  fn log(lent message: Str) -> None {
    call core.console::println(read __dep0, concat("   ", read message))
  }
}

impl QuietLogger() of Logger {
  fn log(lent message: Str) -> None {
  }
}

impl Stamped() of Logger deps [Logger, Clock] {
  fn log(lent message: Str) -> None {
    member main::Logger#0(read __dep0, concat("[t=", call core.basic::to_str(Int)(member main::Clock#0(read __dep1)), "] ", read message))
  }
}

impl Numbered() of Logger deps [Logger] stateful {
  state seen: Int = 0
  fn log(lent message: Str) -> None {
    assign seen = op Add(read seen, 1)
    member main::Logger#0(read __dep0, concat("#", call core.basic::to_str(Int)(read seen), " ", read message))
  }
}

fn main::work(lent __eff0: Logger; lent step: Str) -> None {
  member main::Logger#0(read __eff0, read step)
}

fn main::interception(lent __eff0: Logger, lent __eff1: Clock) -> None {
  call main::work(read __eff0, "4. plain")
  bind#1 let __use~1: Stamped = construct Stamped { __dep0: read __eff0, __dep1: read __eff1 }
  bind#2 let __handle~2: Logger = handle[Logger](read __use~1)
  call main::work(read __handle~2, "4. stamped")
  bind#3 let __use~3: Numbered = construct Numbered { __dep0: read __handle~2 }
  bind#4 let __handle~4: Logger = handle[Logger](read __use~3)
  call main::work(read __handle~4, "4. numbered, then stamped")
  call main::work(read __handle~4, "4. and again")
}

fn main::scoping(lent __eff0: Logger) -> None {
  call main::work(read __eff0, "5. before the block")
  branch#1 cond#0 true {
    bind#2 let __use~1: QuietLogger = construct QuietLogger { }
    bind#3 let __handle~2: Logger = handle[Logger](read __use~1)
    call main::work(read __handle~2, "5. this line is swallowed")
  }
  call main::work(read __eff0, "5. after the block, logging again")
}

interface Audit {
  fn record(lent what: Str) -> None
}

interface Metrics {
  fn record(lent what: Str) -> None
}

impl ConsoleAudit() of Audit deps [Console] {
  fn record(lent what: Str) -> None {
    call core.console::println(read __dep0, concat("   audit: ", read what))
  }
}

impl ConsoleMetrics() of Metrics deps [Console] {
  fn record(lent what: Str) -> None {
    call core.console::println(read __dep0, concat("   metric: ", read what))
  }
}

fn main::audit_only(lent __eff0: Audit; lent what: Str) -> None {
  member main::Audit#0(read __eff0, read what)
}

fn main::audit_and_measure(lent __eff0: Audit, lent __eff1: Metrics; lent what: Str) -> None {
  member main::Audit#0(read __eff0, read what)
  member main::Metrics#0(read __eff1, read what)
}

interface Setting<T> {
  fn setting(lent copy: (T) -> T) -> T
}

impl Fixed<T>(lent value: T) of Setting<T> {
  fn setting(; ?lent copy: (T) -> T) -> T {
    return call local copy(read value)
  }
}

fn main::settings(lent __eff0: Setting<Int>, lent __eff1: Setting<Str>, lent __eff2: Console) -> None {
  bind#1 let retries: Int = member main::Setting#0(read __eff0, fn core.basic::copy)
  bind#2 let region: Str = member main::Setting#0(read __eff1, fn core.basic::copy)
  call core.console::println(read __eff2, concat("   retries=", call core.basic::to_str(Int)(read retries), " region=", read region))
}

fn main::main() -> None {
  bind#1 let __use~1: StdOutConsole = construct StdOutConsole { }
  bind#2 let __handle~2: Console = handle[Console](read __use~1)
  bind#3 let __use~3: TickingClock = construct TickingClock { }
  bind#4 let __handle~4: Clock = handle[Clock](read __use~3)
  call core.console::println(read __handle~2, concat("1. the clock reads ", call core.basic::to_str(Int)(member main::Clock#0(read __handle~4)), ", then ", call core.basic::to_str(Int)(member main::Clock#0(read __handle~4))))
  call core.console::println(read __handle~2, "2. two effects in one signature:")
  call main::stamp(read __handle~4, read __handle~2, "2. a labelled moment")
  call core.console::println(read __handle~2, "3. a logger whose handler needs the console:")
  bind#5 let __use~5: PlainLogger = construct PlainLogger { __dep0: read __handle~2 }
  bind#6 let __handle~6: Logger = handle[Logger](read __use~5)
  call main::work(read __handle~6, "3. logged through the console")
  call core.console::println(read __handle~2, "4. interception — each `use` wraps the one before it:")
  call main::interception(read __handle~6, read __handle~4)
  call core.console::println(read __handle~2, "5. shadowing is not wrapping:")
  call main::scoping(read __handle~6)
  call core.console::println(read __handle~2, "6. two effects, one member name:")
  bind#7 let __use~7: ConsoleAudit = construct ConsoleAudit { __dep0: read __handle~2 }
  bind#8 let __handle~8: Audit = handle[Audit](read __use~7)
  call main::audit_only(read __handle~8, "6. audited only")
  bind#9 let __use~9: ConsoleMetrics = construct ConsoleMetrics { __dep0: read __handle~2 }
  bind#10 let __handle~10: Metrics = handle[Metrics](read __use~9)
  call main::audit_and_measure(read __handle~8, read __handle~10, "6. audited and measured")
  call core.console::println(read __handle~2, "7. two instances of one generic effect:")
  bind#11 let __use~11: Fixed<Int> = construct Fixed<Int> { value: 3 }
  bind#12 let __handle~12: Setting<Int> = handle[Setting<Int>](read __use~11)
  bind#13 let __use~13: Fixed<Str> = construct Fixed<Str> { value: "eu-west-1" }
  bind#14 let __handle~14: Setting<Str> = handle[Setting<Str>](read __use~13)
  call main::settings(read __handle~12, read __handle~14, read __handle~2)
}
