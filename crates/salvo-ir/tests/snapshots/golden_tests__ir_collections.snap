fn main::cmp(lent a: Point, lent b: Point) -> Int {
  bind#1 let c__c1: Int = call core.compare::cmp(Int, Int)(read a.x, read b.x)
  branch#2 cond#0 op Not(call core.compare::eq(Int, Int)(read c__c1, 0)) {
    return !read c__c1
  }
  bind#3 let c__c2: Int = call core.compare::cmp(Int, Int)(read a.y, read b.y)
  branch#4 cond#0 op Not(call core.compare::eq(Int, Int)(read c__c2, 0)) {
    return !read c__c2
  }
  return 0
}

fn main::hash(lent value: Point) -> Long {
  bind#1 let h: Long = 17L
  assign h = call core.compare::mix_hash(read h, call core.compare::hash(Int)(read value.x))
  assign h = call core.compare::mix_hash(read h, call core.compare::hash(Int)(read value.y))
  return !read h
}

fn main::eq(Point, Point)(lent a: Point, lent b: Point) -> Bool {
  branch#1 cond#0 op Not(call core.compare::eq(Int, Int)(read a.x, read b.x)) {
    return false
  }
  branch#2 cond#0 op Not(call core.compare::eq(Int, Int)(read a.y, read b.y)) {
    return false
  }
  return true
}

fn main::eq(Note, Note)(lent a: Note, lent b: Note) -> Bool {
