fn __dispatch_Counting_Counter(lent_mut __handler: Counting, moved __msg: __Msg_Counter) -> None {
  switch#1 read __msg {
    arm#0 (arm 0) {
      unpack#2 (n: Int) = __msg as variant 0
      handler_call main::Counter#0(read __handler, !read n)
    }
    arm#1 (arm 1) {
      unpack#3 (out: Reply<Int>) = __msg as variant 1
      handler_call main::Counter#1(read __handler, !read out)
    }
  }
}

fn __dispatch_Bookkeeping_Ledger(lent_mut __handler: Bookkeeping, moved __msg: __Msg_Ledger) -> None {
  switch#1 read __msg {
    arm#0 (arm 0) {
      unpack#2 (label: Str, out: Reply<Str>) = __msg as variant 0
      handler_call main::Ledger#0(read __handler, !read label, !read out)
    }
    arm#1 (arm 1) {
      unpack#3 (label: Str, out: Reply<Str>, total: Int) = __msg as variant 1
      handler_call main::Ledger#1(read __handler, !read label, !read out, !read total)
    }
  }
}

fn __dispatch_Desking_Desk(lent_mut __handler: Desking, moved __msg: __Msg_Desk) -> None {
  switch#1 read __msg {
    arm#0 (arm 0) {
      unpack#2 (out: Reply<Str>) = __msg as variant 0
      handler_call main::Desk#0(read __handler, !read out)
    }
