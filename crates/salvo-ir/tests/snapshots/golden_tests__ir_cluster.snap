module main

actor interface Sequencer {
  send fn next(moved out: Reply<Str>) -> None
}

actor interface Inventory {
  send fn reserve(moved sku: Str, moved qty: Int, moved out: Reply<Str>) -> None
}

actor interface Search {
  send fn query(moved word: Str, moved out: Reply<Int>) -> None
}

actor interface Lookup {
  send fn lookup(moved key: Str, moved out: Reply<Str>) -> None
}

impl Sequencing(lent who: Str) of Sequencer stateful {
  mailbox construct Mailbox { capacity: 16 }
  state n: Int = 0
  fn next(lent out: Reply<Str>) -> None {
    assign n = op Add(read n, 1)
    call core.actor::send<Str>(!read out, concat(read who, "#", call core.basic::to_str(Int)(read n)))
  }
}

impl Stocking(lent shard: Str) of Inventory stateful {
  mailbox construct Mailbox { capacity: 32 }
  state served: Int = 0
  fn reserve(lent sku: Str, lent qty: Int, lent out: Reply<Str>) -> None {
    assign served = op Add(read served, read qty)
    call core.actor::send<Str>(!read out, concat(read shard, ":", call core.basic::to_str(Int)(read served)))
  }
}

impl Indexing(lent words: List<Str>) of Search {
  mailbox construct Mailbox { capacity: 16 }
  fn query(lent word: Str, lent out: Reply<Int>) -> None {
    bind#1 let n: Int = 0
    foreach#2 w: Str in read words {
      branch#3 cond#0 call core.compare::eq(Str, Str)(read w, read word) {
        assign n = op Add(read n, 1)
      }
    }
    call core.actor::send<Int>(!read out, !read n)
  }
}

impl Looking(lent who: Str) of Lookup {
  mailbox construct Mailbox { capacity: 16 }
  fn lookup(lent key: Str, lent out: Reply<Str>) -> None {
    call core.actor::send<Str>(!read out, concat(read key, " from ", read who))
  }
}

impl SlowLooking(lent who: Str, lent timer: Addr<Timer>) of Lookup stateful {
  mailbox construct Mailbox { capacity: 16 }
  fn lookup(lent key: Str, lent out: Reply<Str>) -> None {
    send time::Timer#0(read timer, call time::millis(150), replyto answer(read key, !read out))
  }
  fn answer(lent key: Str, lent out: Reply<Str>, lent fired: Fired) -> None {
    call core.actor::send<Str>(!read out, concat(read key, " from ", read who))
  }
}

impl Scattering(lent group: Addr<ActorGroup<Search>>, lent gather: Addr<Gather>) of any Search {
  mailbox construct Mailbox { capacity: 16 }
  fn query(lent word: Str, lent out: Reply<Int>) -> None {
    bind#1 let members: List<Addr<Search>> = waitfor ms: Reply<List<Addr<Search>>> {
      send net::ActorGroup#2(read group, !read ms)
    }
    send main::Gather#0(read gather, read word, read members, !read out)
  }
}

actor interface Gather {
  send fn scatter(moved word: Str, moved members: List<Addr<Search>>, moved out: Reply<Int>) -> None
}

impl Gathering() of Gather stateful {
  mailbox construct Mailbox { capacity: 16 }
  state pending: Mut Deque<Reply<Int>> = call core.deque::mut_deque_of()<Reply<Int>>()
  state left: Int = 0
  state total: Int = 0
  fn scatter(lent word: Str, lent members: List<Addr<Search>>, lent out: Reply<Int>) -> None {
    call core.deque::add_last<Reply<Int>>(read pending, !read out)
    assign left = call core.list::size<Addr<Search>>(read members)
    assign total = 0
    foreach#1 m: Addr<Search> in read members {
      send main::Search#0(read m, call core.basic::copy<Str>(read word), replyto partial())
    }
  }
  fn partial(lent n: Int) -> None {
    assign total = op Add(read total, read n)
    assign left = op Sub(read left, 1)
    branch#1 cond#0 call core.compare::eq(Int, Int)(read left, 0) {
      bind#2 let out: Reply<Int>? = call core.deque::remove_first<Reply<Int>>(read pending)
      switch#3 read out {
        arm#0 (arm 0) {
          narrow#4[switch#3.arm#0] out~1: Reply<Int> = out
          call core.actor::send<Int>(!read out~1, call core.basic::copy<Int>(read total))
        }
        arm#1 (none) {
          narrow#5[switch#3.arm#1] out~2: None = out
        }
      }
    }
  }
}

impl Hedging(lent group: Addr<ActorGroup<Lookup>>, lent racer: Addr<Race>) of any Lookup {
  mailbox construct Mailbox { capacity: 16 }
  fn lookup(lent key: Str, lent out: Reply<Str>) -> None {
    bind#1 let members: List<Addr<Lookup>> = waitfor ms: Reply<List<Addr<Lookup>>> {
      send net::ActorGroup#2(read group, !read ms)
    }
    send main::Race#0(read racer, read key, read members, !read out)
  }
}

actor interface Race {
  send fn race(moved key: Str, moved members: List<Addr<Lookup>>, moved out: Reply<Str>) -> None
}

impl Racing() of Race stateful {
  mailbox construct Mailbox { capacity: 16 }
  state pending: Mut Deque<Reply<Str>> = call core.deque::mut_deque_of()<Reply<Str>>()
  fn race(lent key: Str, lent members: List<Addr<Lookup>>, lent out: Reply<Str>) -> None {
    call core.deque::add_last<Reply<Str>>(read pending, !read out)
    foreach#1 m: Addr<Lookup> in read members {
      send main::Lookup#0(read m, call core.basic::copy<Str>(read key), replyto first())
    }
  }
  fn first(lent answer: Str) -> None {
    bind#1 let out: Reply<Str>? = call core.deque::remove_first<Reply<Str>>(read pending)
    switch#2 read out {
      arm#0 (arm 0) {
        narrow#3[switch#2.arm#0] out~1: Reply<Str> = out
        call core.actor::send<Str>(!read out~1, !read answer)
      }
      arm#1 (none) {
        narrow#4[switch#2.arm#1] out~2: None = out
        call core.basic::discard<Str>(!read answer)
      }
    }
  }
}

impl LastHost(lent nodes: Addr<NodeGroup>, lent me: NodeEndpoint) of Leader {
  fn leader() -> NodeId? {
    bind#1 let peers: List<Node> = waitfor out: Reply<List<Node>> {
      send net::NodeGroup#0(read nodes, !read out)
    }
    bind#2 let best_host: Str = call core.basic::copy<Str>(read me.host)
    bind#3 let best: NodeId = call net::this_node()
    foreach#4 n: Node in read peers {
      branch#5 cond#0 op Gt(call core.compare::cmp(Str, Str)(read n.at.host, read best_host), 0) {
        assign best_host = call core.basic::copy<Str>(read n.at.host)
        assign best = call core.basic::copy<NodeId>(read n.id)
      }
    }
    return !read best
  }
}

fn main::fresh_id(lent __eff0: Sequencer) -> Str {
  return waitfor out: Reply<Str> {
    member main::Sequencer#0(read __eff0, !read out)
  }
}

