actor interface Boot {
  send fn boot(moved done: Reply<Addr<Sequencer>>) -> None
  send fn stop(moved done: Reply<Bool>) -> None
}

impl Booting(lent at: NodeEndpoint, lent all: List<NodeEndpoint>, lent net: Addr<MemNet>) of Boot deps [Transport] stateful {
  mailbox construct Mailbox { capacity: 2 }
  state nodes: Addr<NodeGroup>? = none[None]
  fn boot(lent done: Reply<Addr<Sequencer>>) -> None {
    bind#1 let p: Pool = call core.actor::pool(Int)(1)
    bind#2 let group: Addr<NodeGroup> = spawn[Addr<NodeGroup>](construct StaticNodeGroup { name: "cluster", all: call core.basic::copy<List<NodeEndpoint>>(read all), __dep0: read __dep0 }, on: read p) serves [NodeGroup]
    assign nodes = call core.basic::copy<Addr<NodeGroup>>(read group)
    bind#3 let seq: Addr<ActorGroup<Sequencer>> = call net::actor_group(Addr<NodeGroup>)<Sequencer>(call core.basic::copy<Addr<NodeGroup>>(read group), fn net::protocol)
    bind#4 let mine: Addr<Sequencer> = spawn[Addr<Sequencer>](construct Sequencing { who: "b" }, on: read p, in: read seq) serves [Sequencer]
    bind#5 let stock: Addr<ActorGroup<Inventory>> = call net::actor_group(Addr<NodeGroup>)<Inventory>(call core.basic::copy<Addr<NodeGroup>>(read group), fn net::protocol)
    spawn[Addr<Inventory>](construct Stocking { shard: "shard-b" }, on: read p, in: read stock) serves [Inventory]
    bind#6 let index: Addr<ActorGroup<Search>> = call net::actor_group(Addr<NodeGroup>)<Search>(call core.basic::copy<Addr<NodeGroup>>(read group), fn net::protocol)
    spawn[Addr<Search>](construct Indexing { words: list[List<Str>]("salvo", "actors", "salvo", "nodes") }, on: read p, in: read index) serves [Search]
    bind#7 let looks: Addr<ActorGroup<Lookup>> = call net::actor_group(Addr<NodeGroup>)<Lookup>(!read group, fn net::protocol)
    bind#8 let timer: Addr<Timer> = spawn[Addr<Timer>](construct DefaultTimer { }, on: read p) serves [Timer]
    spawn[Addr<Lookup>](construct SlowLooking { who: "b (slow)", timer: read timer }, on: read p, in: read looks) serves [Lookup]
    call core.actor::send<Addr<Sequencer>>(!read done, !read mine)
  }
  fn stop(lent done: Reply<Bool>) -> None {
    bind#1 let group: Addr<NodeGroup>? = read nodes
    branch#2 cond#0 op Not(check#3 (read group is none)) {
      narrow#4[check#3] group~1: None = group
      narrow#5[branch#2.cond#0] group~2: Addr<NodeGroup> = group~1
      send net::NodeGroup#2(read group~2)
    }
    call core.actor::send<Bool>(!read done, true)
  }
}

fn main::settle(lent timer: Addr<Timer>) -> None {
  bind#1 let _f: Fired = waitfor f: Reply<Fired> {
    send time::Timer#0(read timer, call time::millis(400), !read f)
  }
}

fn main::main() -> None {
  bind#1 let __use~1: StdOutConsole = construct StdOutConsole { }
  bind#2 let a: NodeEndpoint = construct NodeEndpoint { host: "a", port: 1 }
  bind#3 let b: NodeEndpoint = construct NodeEndpoint { host: "b", port: 1 }
  bind#4 let all: List<NodeEndpoint> = list[List<NodeEndpoint>](call core.basic::copy<NodeEndpoint>(read a), call core.basic::copy<NodeEndpoint>(read b))
  bind#5 let network: Addr<MemNet> = spawn[Addr<MemNet>](construct MemNetwork { }, on: call core.actor::pool(Int)(1)) serves [MemNet]
  bind#6 let __use~2: MemTransport = construct MemTransport { me: call core.basic::copy<NodeEndpoint>(read a), net: call core.basic::copy<Addr<MemNet>>(read network) }
  bind#7 let p: Pool = call core.actor::pool(Int)(2)
  bind#8 let nodes: Addr<NodeGroup> = spawn[Addr<NodeGroup>](construct StaticNodeGroup { name: "cluster", all: call core.basic::copy<List<NodeEndpoint>>(read all), __dep0: read __use~2 }, on: read p) serves [NodeGroup]
  bind#9 let seq: Addr<ActorGroup<Sequencer>> = call net::actor_group(Addr<NodeGroup>)<Sequencer>(call core.basic::copy<Addr<NodeGroup>>(read nodes), fn net::protocol)
  spawn[Addr<Sequencer>](construct Sequencing { who: "a" }, on: read p, in: read seq) serves [Sequencer]
  bind#10 let stock: Addr<ActorGroup<Inventory>> = call net::actor_group(Addr<NodeGroup>)<Inventory>(call core.basic::copy<Addr<NodeGroup>>(read nodes), fn net::protocol)
  spawn[Addr<Inventory>](construct Stocking { shard: "shard-a" }, on: read p, in: read stock) serves [Inventory]
  bind#11 let index: Addr<ActorGroup<Search>> = call net::actor_group(Addr<NodeGroup>)<Search>(call core.basic::copy<Addr<NodeGroup>>(read nodes), fn net::protocol)
  spawn[Addr<Search>](construct Indexing { words: list[List<Str>]("salvo", "is", "salvo") }, on: read p, in: read index) serves [Search]
  bind#12 let looks: Addr<ActorGroup<Lookup>> = call net::actor_group(Addr<NodeGroup>)<Lookup>(call core.basic::copy<Addr<NodeGroup>>(read nodes), fn net::protocol)
  spawn[Addr<Lookup>](construct Looking { who: "a" }, on: read p, in: read looks) serves [Lookup]
  bind#13 let pb: Pool = call net::pool_at(call net::new_node(), 1)
  bind#14 let booter: Addr<Boot> = spawn[Addr<Boot>](construct Booting { at: call core.basic::copy<NodeEndpoint>(read b), all: call core.basic::copy<List<NodeEndpoint>>(read all), net: call core.basic::copy<Addr<MemNet>>(read network), __dep0: construct MemTransport { me: call core.basic::copy<NodeEndpoint>(read b), net: call core.basic::copy<Addr<MemNet>>(read network) } }, on: read pb) serves [Boot]
  bind#15 let remote_seq: Addr<Sequencer> = waitfor done: Reply<Addr<Sequencer>> {
    send main::Boot#0(read booter, !read done)
  }
  bind#16 let timer: Addr<Timer> = spawn[Addr<Timer>](construct DefaultTimer { }, on: call core.actor::pool(Int)(1)) serves [Timer]
  call main::settle(call core.basic::copy<Addr<Timer>>(read timer))
  bind#17 let members: List<Node> = waitfor out: Reply<List<Node>> {
    send net::NodeGroup#0(read nodes, !read out)
  }
  call core.console::println(read __use~1, concat("nodes: ", call core.basic::to_str(Int)(op Add(call core.list::size<Node>(read members), 1)), ", sequencers: ", call core.basic::to_str(Int)(call core.list::size<Addr<Sequencer>>(waitfor out: Reply<List<Addr<Sequencer>>> {
    send net::ActorGroup#2(read seq, !read out)
  }))))
  call core.console::println(read __use~1, concat("singleton (b's sequencer is remote: ", call core.basic::to_str(Bool)(op Not(call net::eq(NodeId, NodeId)(call net::node_of<Sequencer>(read remote_seq), call net::this_node()))), "):"))
  bind#18 let __use~3: LastHost = construct LastHost { nodes: call core.basic::copy<Addr<NodeGroup>>(read nodes), me: call core.basic::copy<NodeEndpoint>(read a) }
  call main::two_ids(read __use~3, read __use~1, call core.basic::copy<Addr<ActorGroup<Sequencer>>>(read seq))
  call core.console::println(read __use~1, "sharded:")
  call main::shop(read __use~1, !read stock)
  call core.console::println(read __use~1, "scatter:")
  bind#19 let __use~4: Scattering = construct Scattering { group: call core.basic::copy<Addr<ActorGroup<Search>>>(read index), gather: spawn[Addr<Gather>](construct Gathering { }, on: read p) serves [Gather] }
  call core.console::println(read __use~1, concat("  salvo: ", call core.basic::to_str(Int)(call main::count(read __use~4, "salvo")), ", actors: ", call core.basic::to_str(Int)(call main::count(read __use~4, "actors")), ", none: ", call core.basic::to_str(Int)(call main::count(read __use~4, "none"))))
  call core.console::println(read __use~1, "hedge:")
  bind#20 let __use~5: Hedging = construct Hedging { group: call core.basic::copy<Addr<ActorGroup<Lookup>>>(read looks), racer: spawn[Addr<Race>](construct Racing { }, on: read p) serves [Race] }
  call core.console::println(read __use~1, concat("  ", call main::find(read __use~5, "k1")))
  bind#21 let _stopped: Bool = waitfor done: Reply<Bool> {
    send main::Boot#1(read booter, !read done)
  }
  call main::settle(call core.basic::copy<Addr<Timer>>(read timer))
  call core.console::println(read __use~1, "after b left:")
  call core.console::println(read __use~1, concat("  sequencers: ", call core.basic::to_str(Int)(call core.list::size<Addr<Sequencer>>(waitfor out: Reply<List<Addr<Sequencer>>> {
    send net::ActorGroup#2(read seq, !read out)
  }))))
  call main::two_ids(read __use~3, read __use~1, !read seq)
}

