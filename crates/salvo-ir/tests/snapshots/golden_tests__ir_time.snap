fn __dispatch_Sessions_Session(lent_mut __handler: Sessions, moved __msg: __Msg_Session) -> None {
  switch#1 read __msg {
    arm#0 (arm 0) {
      unpack#2 (started: Tick, budget: Duration, out: Reply<Str>) = __msg as variant 0
      handler_call main::Session#0(read __handler, !read started, !read budget, !read out)
    }
    arm#1 (arm 1) {
      unpack#3 (started: Tick, budget: Duration, out: Reply<Str>, f: Fired) = __msg as variant 1
      handler_call main::Session#1(read __handler, !read started, !read budget, !read out, !read f)
    }
  }
}

