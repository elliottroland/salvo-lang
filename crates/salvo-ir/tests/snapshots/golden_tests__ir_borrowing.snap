module main

struct Fighter canbe Mut wire {
  name: Str
  hp: Int
  energy: Int
}

fn main::named(lent roster: List<Fighter>, lent name: Str) -> Fighter? {
  foreach#1 f: Fighter in read roster {
    branch#2 cond#0 call core.compare::eq(Str, Str)(read f.name, read name) {
      return !read f
    }
  }
  return none[None]
}

struct Window canbe Mut {
  roster: List<Fighter>
  at: Int
}

fn main::window(lent roster: List<Fighter>) -> Mut Window borrows [roster] {
  return construct Mut Window { roster: read roster, at: 0 }
}

fn main::peek(lent w: Window) -> Fighter? {
  return call core.list::get(List<T>, Int)<Fighter>(read w.roster, read w.at)
}

fn main::heal(lent_mut f: Mut Fighter) -> None {
  assign f.hp = op Add(read f.hp, 10)
  return none[None]
}

fn main::wounded(lent_mut squad: List<Mut Fighter>) -> Mut Fighter? {
  foreach#1 f: Mut Fighter in read squad {
    branch#2 cond#0 op Lt(call core.compare::cmp(Int, Int)(read f.hp, 10), 0) {
      return !read f
    }
  }
  return none[None]
}

fn main::rally_at<L>(lent_mut squad: List<Mut Fighter>, lent l: L; ?lent at: (List<Mut Fighter>, L) -> Mut Fighter?) -> None {
  call main::heal(branch#4 cond#0 true {
    bind#2 let __nn~1: Mut Fighter? = call local at(read squad, read l)
    value switch#1 read __nn~1 {
      arm#0 (none) {
        unreachable("salvo: value is absent at main.sv:4032")
      }
      arm#1 (else) {
        narrow#3[switch#1.arm#1] __some~2: Mut Fighter = __nn~1
        value !read __some~2
      }
    }
  })
  return none[None]
}

fn main::duel(lent_mut a: Mut Fighter, lent_mut d: Mut Fighter) -> None {
  assign a.hp = op Sub(read a.hp, 1)
  assign d.hp = op Sub(read d.hp, 2)
  return none[None]
}

fn main::strike(lent_mut a: Mut Fighter, lent_mut d: Mut Fighter) -> None {
  assign a.energy = op Sub(read a.energy, 1)
  assign d.hp = op Sub(read d.hp, 2)
  return none[None]
}

struct Squad canbe Mut wire {
  banner: Str
  members: List<Mut Fighter>
}

fn main::rotate(lent_mut squad: Mut Squad, lent_mut from: Mut Fighter, lent_mut to: Mut Fighter) -> None {
  assign from.energy = op Sub(read from.energy, 1)
  assign to.energy = op Add(read to.energy, 1)
  return none[None]
}

struct Camp canbe Mut wire {
  supplies: Int
  banners: Mut List<Str>
}

fn main::spend(lent_mut camp: Mut Camp, lent n: Int) -> None {
  assign camp.supplies = op Sub(read camp.supplies, read n)
  return none[None]
}

fn main::hoist(lent_mut camp: Mut Camp, moved banner: Str) -> None {
  call core.list::add<Str>(read camp.banners, !read banner)
  return none[None]
}

