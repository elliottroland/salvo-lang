module main

struct Fighter canbe Mut wire {
  name: Str
  hp: Int
  energy: Int
}

fn main::named(lent roster: List<Fighter>, lent name: Str) -> proj Fighter? borrows [roster] {
  foreach#1 f: proj Fighter in read roster {
    branch#2 cond#0 call core.compare::eq(Str, Str)(read f.name, read name) {
      return present(read f)
    }
  }
  return none[None]
}

struct Window canbe Mut {
  roster: proj List<Fighter>
  at: Int
}

fn main::window(lent roster: List<Fighter>) -> Mut Window borrows [roster] {
  return construct Mut Window { roster: read roster, at: 0 }
}

fn main::peek(lent w: Window) -> proj Fighter? borrows [w] {
  return call core.list::get(List<T>, Int)<Fighter>(read w.roster, read w.at)
}

fn main::heal(lent_mut f: Mut Fighter) -> None {
  assign f.hp = (read f.hp + 10)
  return none[None]
}

fn main::wounded(lent_mut squad: List<Mut Fighter>) -> proj Mut Fighter? borrows [squad] {
  foreach#1 f: proj Mut Fighter in read squad {
    branch#2 cond#0 (read f.hp < 10) {
      return present(read f)
    }
  }
  return none[None]
}

fn main::rally_at<L>(lent_mut squad: List<Mut Fighter>, lent l: L; ?lent at: (List<Mut Fighter>, L) -> proj Mut Fighter?) -> None {
  call main::heal(branch#4 cond#0 true {
    bind#2 let __nn~1: proj Mut Fighter? = call local at(read squad, read l)
    value switch#1 read __nn~1 {
      arm#0 (none) {
        unreachable("value is absent") at main:100:10
      }
      arm#1 (else) {
        narrow#3[switch#1.arm#1] __some~2: proj Mut Fighter = __nn~1
        value !read __some~2
      }
    }
  })
  return none[None]
}

fn main::duel(lent_mut a: Mut Fighter, lent_mut d: Mut Fighter) -> None {
  assign a.hp = (read a.hp - 1)
  assign d.hp = (read d.hp - 2)
  return none[None]
}

fn main::strike(lent_mut a: Mut Fighter, lent_mut d: Mut Fighter) -> None => a canbe d {
  assign a.energy = (read a.energy - 1)
  assign d.hp = (read d.hp - 2)
  return none[None]
}

struct Squad canbe Mut wire {
  banner: Str
  members: List<Mut Fighter>
}

fn main::rotate(lent_mut squad: Mut Squad, lent_mut from: Mut Fighter, lent_mut to: Mut Fighter) -> None => from canbe in squad.members, to canbe in squad.members {
  assign from.energy = (read from.energy - 1)
  assign to.energy = (read to.energy + 1)
  return none[None]
}

struct Camp canbe Mut wire {
  supplies: Int
  banners: Mut List<Str>
}

fn main::spend(lent_mut camp: Mut Camp, lent n: Int) -> None {
  assign camp.supplies = (read camp.supplies - read n)
  return none[None]
}

fn main::hoist(lent_mut camp: Mut Camp, moved banner: Str) -> None {
  call core.list::add<Str>(read camp.banners, !read banner)
  return none[None]
}

