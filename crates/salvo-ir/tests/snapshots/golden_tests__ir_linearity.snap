module main

linear struct Ticket wire {
  id: Int
  seat: Str
}

fn main::issue(lent __eff0: Console; moved id: Int, moved seat: Str) -> Ticket {
  call core.console::println(read __eff0, concat("1. issued #", call core.basic::to_str(Int)(read id), " for ", read seat))
  return construct Ticket { id: read id, seat: read seat }
}

fn main::redeem(lent __eff0: Console; moved ticket: Ticket) -> None {
  call core.console::println(read __eff0, concat("1. redeemed #", call core.basic::to_str(Int)(read ticket.id)))
  call core.basic::discard<Ticket>(!read ticket)
}

fn main::one_use(lent __eff0: Console) -> None {
  bind#1 let ticket: Ticket = call main::issue(read __eff0, 1, "12A")
  call main::redeem(read __eff0, !read ticket)
  call core.console::println(read __eff0, "2. gone after one use")
}

fn main::describe(lent __eff0: Console; lent ticket: Ticket) -> None {
  call core.console::println(read __eff0, concat("3. still holding #", call core.basic::to_str(Int)(read ticket.id), " (", read ticket.seat, ")"))
}

fn main::borrow_then_use(lent __eff0: Console) -> None {
  bind#1 let ticket: Ticket = call main::issue(read __eff0, 2, "3C")
  call main::describe(read __eff0, read ticket)
  call main::describe(read __eff0, read ticket)
  call main::redeem(read __eff0, !read ticket)
}

fn main::read_a_field(lent __eff0: Console) -> None {
  bind#1 let ticket: Ticket = call main::issue(read __eff0, 3, "1A")
  bind#2 let seat: Str = read ticket.seat
  call core.console::println(read __eff0, concat("4. read ", read seat, ", and #", call core.basic::to_str(Int)(read ticket.id), " is still owed"))
  call main::redeem(read __eff0, !read ticket)
}

fn main::hand_over<T canbe linear>(lent __eff0: Console; moved value: T, moved to: (T) [Console] -> None) -> None {
  call local to(read __eff0, !read value)
}

fn main::generic_handoff(lent __eff0: Console) -> None {
  bind#1 let ticket: Ticket = call main::issue(read __eff0, 4, "9B")
  call main::hand_over<Ticket>(read __eff0, !read ticket, lambda(lent __leff0: Console, lent t: Ticket) -> None {
    value call main::redeem(read __leff0, !read t)
  })
}

fn main::scrap(moved ticket: Ticket) -> None {
  call core.basic::discard<Ticket>(!read ticket)
}

fn main::a_queue_of_tickets(lent __eff0: Console) -> None {
  bind#1 let queue: Mut Deque<Ticket> = call core.deque::mut_deque_of()<Ticket>()
  call core.deque::add_last<Ticket>(read queue, call main::issue(read __eff0, 5, "2B"))
  call core.deque::add_last<Ticket>(read queue, call main::issue(read __eff0, 6, "2C"))
  call core.console::println(read __eff0, concat("6. queued ", call core.basic::to_str(Int)(call core.deque::size<Ticket>(drop_mut(read queue)))))
  bind#2 let first: Ticket? = call core.deque::remove_first<Ticket>(read queue)
  switch#3 read first {
    arm#0 (arm 0) {
      narrow#4[switch#3.arm#0] first~1: Ticket = first
      call main::redeem(read __eff0, !read first~1)
    }
    arm#1 (none) {
    }
  }
  loop#5 {
    bind#7 let __subject~2: Ticket? = call core.deque::remove_first<Ticket>(read queue)
    branch#9 cond#0 op Not(check#6 (read __subject~2 is arm 0)) {
      break
    }
    narrow#8[check#6] next: Ticket = __subject~2
    call main::redeem(read __eff0, !read next)
  }
  call core.deque::drain<Ticket>(drop_mut(!read queue), fn main::scrap)
  call core.console::println(read __eff0, "6. queue drained")
}

fn main::main() -> None {
  bind#1 let __use~1: StdOutConsole = construct StdOutConsole { }
  bind#2 let __handle~2: Console = handle[Console](read __use~1)
  call main::one_use(read __handle~2)
  call main::borrow_then_use(read __handle~2)
  call main::read_a_field(read __handle~2)
  call main::generic_handoff(read __handle~2)
  call main::a_queue_of_tickets(read __handle~2)
}
