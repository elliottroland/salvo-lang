use crate::core_array::*;
use crate::core_console::*;
use crate::core_iterator::*;
use crate::core_list::*;
use crate::core_string::*;

#[derive(Clone, Debug)]
pub struct Person {
    pub name: String,
    pub surname: Option<String>,
    pub age: i32,
}

pub fn full_name(person: &Person) -> String {
    if person.surname.is_some() {
        let mut surname = person.surname.as_ref().unwrap().clone();
        return format!("{} {}", person.name.clone(), surname);
    }
    return person.name.clone();
}

pub fn greet(console: &mut dyn Console, person: &Person) {
    println(console, &(format!("Hello, {}!", full_name(person))));
    let mut __loop1_pass = __Pass_Range::new(range(1, 4));
    while let Some(mut i) = __loop1_pass.__advance() {
        println(console, &(format!("  {}: {}", i, person.age + i)));
    }
    __loop1_pass.__close();
}

#[derive(Clone, Debug)]
pub struct Range {
    pub start: i32,
    pub end: i32,
}

pub fn range(start: i32, end: i32) -> Range {
    return Range { start: start, end: end };
}

pub fn main() {
    let mut console = StdOutConsole::new();
    let mut person = Person { name: "Roland".to_string(), surname: Some("Elliott".to_string()), age: 36 };
    greet(&mut console, &person);
    let mut anon = Person { surname: None, ..person.clone() };
    greet(&mut console, &anon);
    let mut names = vec!["a".to_string(), "b".to_string()];
    println(&mut console, &(format!("first: {}", names.first().unwrap())));
    let mut mut_names = vec!["x".to_string()];
    mut_names.push("y".to_string());
    println(&mut console, &(format!("size: {}", (mut_names.len() as i32))));
}

#[derive(Clone)]
pub struct __Pass_Range {
    r: Range,
    i: i32,
    __state: u32,
}

impl __Pass_Range {
    pub fn new(r: Range) -> Self {
        Self {
            r,
            i: 0,
            __state: 0,
        }
    }

    pub fn __advance(&mut self) -> Option<i32> {
        loop {
            match self.__state {
                0 => {
                    self.i = self.r.start;
                    self.__state = 1;
                    continue;
                }
                1 => {
                    if !((({ let __t = self.i; self.i += 1; __t }) < self.r.end)) {
                        self.__state = 2;
                        continue;
                    }
                    let __v = self.i - 1;
                    self.__state = 1;
                    return Some(__v);
                }
                2 => {
                    self.__state = 2;
                    return None;
                }
                _ => return None,
            }
        }
    }

    pub fn __close(&mut self) {
        self.__state = 2;
    }
}

// ===== unions.rs =====
// Generated by the Salvo compiler: enums for union types.

#[derive(Clone, Debug)]
pub enum Union2<T1, T2> {
    U1(T1),
    U2(T2),
}

impl<T1, T2> Union2<T1, T2> {
    pub fn u1(&self) -> &T1 {
        match self {
            Union2::U1(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u2(&self) -> &T2 {
        match self {
            Union2::U2(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
}

impl<T1, T2> std::fmt::Display for Union2<T1, T2>
where
    T1: std::fmt::Display,
    T2: std::fmt::Display,
{
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Union2::U1(v) => write!(f, "{}", v),
            Union2::U2(v) => write!(f, "{}", v),
        }
    }
}
