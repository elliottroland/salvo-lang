// ===== core/string.rs =====
use crate::core_iterator::*;
use crate::core_list::*;
use crate::unions::*;

pub fn iter__3(str: String) -> StrPass {
    return StrPass { text: str, at: 0 };
}

#[derive(Clone, Debug)]
pub struct StrPass {
    pub text: String,
    pub at: i32,
}

pub fn next__5(pass: &mut StrPass) -> Union2<char, Finished> {
    let mut chr = pass.text.chars().nth((pass.at) as usize);
    if chr.is_none() {
        return Union2::<char, Finished>::U2(finished());
    }
    pass.at = pass.at + 1;
    return Union2::<char, Finished>::U1(emitted(chr.unwrap()));
}

