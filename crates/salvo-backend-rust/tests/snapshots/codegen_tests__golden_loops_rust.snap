use crate::core_console::*;
use crate::core_iterator::*;
use crate::core_result::*;
use crate::core_string::*;
use crate::unions::*;

#[derive(Clone, Debug)]
pub struct Range {
    pub start: i32,
    pub end: i32,
}

pub fn range(start: i32, end: i32) -> Range {
    return Range { start: start, end: end };
}

#[derive(Clone, Debug)]
pub struct __Pass_Range {
    pub end: i32,
    pub at: i32,
}

pub fn iter__4(r: &Range) -> __Pass_Range {
    return __Pass_Range { end: r.end, at: r.start };
}

pub fn next__4(__p: &mut __Pass_Range) -> Union2<i32, Finished> {
    if __p.at >= __p.end {
        return Union2::<i32, Finished>::U2(finished());
    }
    let mut v = __p.at;
    __p.at = __p.at + 1;
    return Union2::<i32, Finished>::U1(emitted(v));
}

pub fn main() {
    let mut console = StdOutConsole::new();
    let mut i = 0;
    let mut last = ({
let mut __loop1: Option<i32> = None;
let mut __loop1_ran = false;
while (({ let __t = i; i += 1; __t }) < 4) {
__loop1_ran = true;
__loop1 = Some(i * 10);
}
if !__loop1_ran {
__loop1 = Some(-1);
}
__loop1.unwrap()
});
    println(&mut console, &(format!("last: {}", last)));
    let mut j = 9;
    let mut never = ({
let mut __loop2: Option<i32> = None;
let mut __loop2_ran = false;
while j < 3 {
__loop2_ran = true;
__loop2 = Some(j);
}
if !__loop2_ran {
__loop2 = Some(-1);
}
__loop2.unwrap()
});
    println(&mut console, &(format!("never: {}", never)));
    let mut found = ({
let mut __loop3: Option<i32> = None;
for mut x in vec![0, 1, 2, 3, 4, 5] {
if x * x > 10 {
    __loop3 = Some(x);
    break;
}
__loop3 = Some(x);
}
__loop3
});
    if found.is_some() {
        let mut f = found.unwrap();
        println(&mut console, &(format!("found: {}", f)));
    }
    let mut __loop4_ran = false;
    let mut __loop5_pass = iter__4(&(range(0, 0)));
    while let Union2::U1(mut x) = next__4(&mut __loop5_pass) {
        __loop4_ran = true;
        println(&mut console, &("unreachable".to_string()));
    }
    if !__loop4_ran {
        println(&mut console, &("empty range".to_string()));
    }
    let mut k = 0;
    let mut capped = ({
let mut __loop6: Option<i32> = None;
while k < 5 {
k += 1;
if k == 3 {
    break;
}
__loop6 = Some(k);
}
__loop6
});
    println(&mut console, &(format!("capped: {}", capped.unwrap())));
    let mut n = 0;
    let mut verdict: Union2<i32, String> = (match ({
let mut __loop7: Option<Union2<String, i32>> = None;
let mut __loop7_ran = false;
while n < 3 {
__loop7_ran = true;
if n == 2 {
    __loop7 = Some(Union2::<String, i32>::U2(ok(n)));
    break;
}
n += 1;
__loop7 = Some(Union2::<String, i32>::U1(err("not yet".to_string())));
}
if !__loop7_ran {
__loop7 = Some(Union2::<String, i32>::U1(err("empty".to_string())));
}
__loop7.unwrap()
}) { Union2::U1(__v) => Union2::<i32, String>::U2(__v), Union2::U2(__v) => Union2::<i32, String>::U1(__v), });
    match verdict {
        Union2::U1(_) => {
            println(&mut console, &(format!("ok: {}", *verdict.u1())));
        }
        Union2::U2(_) => {
            println(&mut console, &(format!("err: {}", verdict.u2().clone())));
        }
    }
}

// ===== unions.rs =====
// Generated by the Salvo compiler: enums for union types.

#[derive(Clone, Debug)]
pub enum Union2<T1, T2> {
    U1(T1),
    U2(T2),
}

impl<T1, T2> Union2<T1, T2> {
    pub fn u1(&self) -> &T1 {
        match self {
            Union2::U1(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u1_mut(&mut self) -> &mut T1 {
        match self {
            Union2::U1(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u2(&self) -> &T2 {
        match self {
            Union2::U2(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u2_mut(&mut self) -> &mut T2 {
        match self {
            Union2::U2(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
}

impl<T1, T2> std::fmt::Display for Union2<T1, T2>
where
    T1: std::fmt::Display,
    T2: std::fmt::Display,
{
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Union2::U1(v) => write!(f, "{}", v),
            Union2::U2(v) => write!(f, "{}", v),
        }
    }
}
