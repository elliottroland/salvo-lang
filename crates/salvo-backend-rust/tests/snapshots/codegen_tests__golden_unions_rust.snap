// Generated by the Salvo compiler: enums for union types.

#[derive(Clone, Debug)]
pub enum Union2<T1, T2> {
    U1(T1),
    U2(T2),
}

impl<T1, T2> Union2<T1, T2> {
    pub fn u1(&self) -> &T1 {
        match self {
            Union2::U1(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u2(&self) -> &T2 {
        match self {
            Union2::U2(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
}

impl<T1, T2> std::fmt::Display for Union2<T1, T2>
where
    T1: std::fmt::Display,
    T2: std::fmt::Display,
{
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Union2::U1(v) => write!(f, "{}", v),
            Union2::U2(v) => write!(f, "{}", v),
        }
    }
}

#[derive(Clone, Debug)]
pub enum Union3<T1, T2, T3> {
    U1(T1),
    U2(T2),
    U3(T3),
}

impl<T1, T2, T3> Union3<T1, T2, T3> {
    pub fn u1(&self) -> &T1 {
        match self {
            Union3::U1(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u2(&self) -> &T2 {
        match self {
            Union3::U2(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u3(&self) -> &T3 {
        match self {
            Union3::U3(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
}

impl<T1, T2, T3> std::fmt::Display for Union3<T1, T2, T3>
where
    T1: std::fmt::Display,
    T2: std::fmt::Display,
    T3: std::fmt::Display,
{
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Union3::U1(v) => write!(f, "{}", v),
            Union3::U2(v) => write!(f, "{}", v),
            Union3::U3(v) => write!(f, "{}", v),
        }
    }
