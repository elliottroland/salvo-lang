    let mut i = 0;
    while i < size_platform(list) {
        let mut x = get_platform(list, i).unwrap();
        if pick(x) {
            add_platform(&mut yes, copy(x));
        } else {
            add_platform(&mut no, copy(x));
        }
        i = i32::wrapping_add(i, 1);
    }
    return (yes, no);
}

