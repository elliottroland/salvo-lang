/// [rs-elem-mut] Two `&mut` elements of one `Vec` at once — the rendering
/// of a call taking two mutable element handles the checker proved apart
/// (`Distinct`, [elem-distinct]): one `split_at_mut` at the higher index,
/// one element out of each half. `i != j` is checker-guaranteed; `None`
/// when either index is out of range, so the caller's `.expect` carries
/// the same message and timing as a single handle's `!`.
pub fn salvo_pair_mut<T>(xs: &mut [T], i: usize, j: usize) -> Option<(&mut T, &mut T)> {
    if i == j || i >= xs.len() || j >= xs.len() {
        return None;
    }
    if i < j {
        let (lo, hi) = xs.split_at_mut(j);
        Some((&mut lo[i], &mut hi[0]))
    } else {
        let (lo, hi) = xs.split_at_mut(i);
        Some((&mut hi[0], &mut lo[j]))
    }
}

// ===== hosttime.rs =====
// Generated by the Salvo compiler: the two clock readings std's `time`
// module is built on [time-types] [rs-time].
//
// Both answer nanoseconds in an `i64`, which is what `Instant`, `Tick` and
// `Duration` carry — one field each, so the seam between the language and the
// host is a number and nothing else.

use std::sync::OnceLock;
use std::time::Instant;

/// [time-ticker] The monotonic clock, in nanoseconds from an arbitrary
/// origin — this process's first reading, established here.
///
/// The origin has to live somewhere: Rust's `Instant` is opaque and cannot be
/// turned into a number, so a *process-wide* base is what makes two readings
/// comparable. One `OnceLock` for the whole program is the point — a base per
/// call site would put two origins in one program and make `between` answer
/// nonsense.
///
/// Never negative, and monotonically non-decreasing: `Instant` guarantees it,
/// and `duration_since` on the process base cannot underflow.
pub fn salvo_mono_nanos() -> i64 {
    static ORIGIN: OnceLock<Instant> = OnceLock::new();
    let origin = ORIGIN.get_or_init(Instant::now);
    Instant::now().duration_since(*origin).as_nanos() as i64
}

// ===== platform/core/console.rs =====
// [platform-tree] std's console, for `core.console`'s
// `threadsafe platform handler StdOutConsole` (ROADMAP 0.5): standard output,
// with no buffering of its own, so a line printed before a trap is seen.

use std::io::Write;

pub struct StdOutConsole;

impl StdOutConsole {
    pub fn new() -> Self {
        StdOutConsole
    }
}

impl crate::core_console::ConsolePlatformSync for StdOutConsole {
    fn print(&self, message: &String) {
        let mut out = std::io::stdout().lock();
        let _ = out.write_all(message.as_bytes());
    }
}

// ===== platform/core/list.rs =====
// [platform-value-type] std's list, for `core.list`'s
// `platform type List<T> canbe Mut` (ROADMAP 0.7): a `Vec`. `Mut List` is the
// same type, passed as `&mut`.

pub type List<T> = Vec<T>;
pub type MutList<T> = Vec<T>;

// [platform-iterable] The host's loop over a list, by reference.
pub fn each<T>(list: &List<T>) -> std::slice::Iter<'_, T> {
    list.iter()
}

pub fn each_mut<T>(list: &mut List<T>) -> std::slice::IterMut<'_, T> {
    list.iter_mut()
}

pub fn into_each<T>(list: List<T>) -> std::vec::IntoIter<T> {
    list.into_iter()
}

pub fn get<T>(list: &List<T>, index: i32) -> Option<&T> {
    if index < 0 { None } else { list.get(index as usize) }
}

// [col-idx] The total read: the index was proven in range.
pub fn get_at<T>(list: &List<T>, index: i32) -> &T {
    &list[index as usize]
}

pub fn first<T>(list: &List<T>) -> Option<&T> {
    list.first()
}

pub fn size<T>(list: &List<T>) -> i32 {
    list.len() as i32
}

pub fn add<T>(list: &mut List<T>, elem: T) {
    list.push(elem);
}

pub fn remove_first<T>(list: &mut List<T>) -> Option<T> {
    if list.is_empty() { None } else { Some(list.remove(0)) }
}

pub fn remove_last<T>(list: &mut List<T>) -> Option<T> {
    list.pop()
}

pub fn remove_at<T>(list: &mut List<T>, index: i32) -> Option<T> {
    if index < 0 || index as usize >= list.len() { None } else { Some(list.remove(index as usize)) }
}

// [col-insert] The element back when the index is outside `0..=len`.
pub fn insert_at<T>(list: &mut List<T>, index: i32, elem: T) -> Option<T> {
    if index < 0 || index as usize > list.len() {
        return Some(elem);
    }
    list.insert(index as usize, elem);
    None
}

// [col-remove-range] Clamped to the list.
pub fn remove_range<T>(list: &mut List<T>, from: i32, to: i32) -> List<T> {
    let len = list.len() as i64;
    let from = (from as i64).clamp(0, len) as usize;
    let to = (to as i64).clamp(from as i64, len) as usize;
    list.drain(from..to).collect()
}

// [col-bounds] Out of range moves nothing and answers `false`.
pub fn swap_at<T>(list: &mut List<T>, i: i32, j: i32) -> bool {
    let n = list.len() as i32;
    if i < 0 || j < 0 || i >= n || j >= n {
        return false;
    }
    list.swap(i as usize, j as usize);
    true
}

// [col-replace] The index was proven in range by the caller's `Idx` claim.
pub fn replace<T>(list: &mut List<T>, index: i32, value: T) -> T {
    std::mem::replace(&mut list[index as usize], value)
}

pub fn into_mut<T>(list: List<T>) -> List<T> {
    list
}

// [linear-container] Ending one that still holds elements would drop them.
pub fn end_empty<T>(list: List<T>) {
    assert!(list.is_empty(), "salvo: a list was ended with elements in it");
}

// A stable sort, in the language's ordering, of a copy.
pub fn sort_by<T: Clone>(list: &List<T>, cmp: &mut dyn FnMut(&T, &T) -> i32) -> List<T> {
    let mut out = list.clone();
    out.sort_by(|a, b| cmp(a, b).cmp(&0));
    out
}

// A **lower bound**: an equal run is entered from the front, so both backends
// land on the same index.
pub fn insert_sorted_by<T>(list: &mut List<T>, elem: T, cmp: &mut dyn FnMut(&T, &T) -> i32) {
    let at = list.partition_point(|x| cmp(x, &elem) < 0);
    list.insert(at, elem);
}

// Lower bound, then a tie in the same ordering [col-membership].
pub fn search_sorted_by<T>(list: &List<T>, elem: &T, cmp: &mut dyn FnMut(&T, &T) -> i32) -> Option<i32> {
    let at = list.partition_point(|x| cmp(x, elem) < 0);
    if at < list.len() && cmp(&list[at], elem) == 0 { Some(at as i32) } else { None }
}

// ===== platform/core/map.rs =====
// [platform-value-type] [platform-slots] std's map, for `core.map`'s `platform
// type Map<K, V>(?hash, ?eq) canbe Mut`: one insertion-ordered slab for every
// identity (ROADMAP §0j step 7, user decision 2026-10-06). Every operation is
// handed the `hash` and `eq` its call resolved, lent for the call
// [platform-fn-value]; the map keeps the entries and the digest each key was
// filed under, nothing else. `Mut Map` is the same type, passed as `&mut`.

use std::collections::HashMap;
use std::fmt;

type HashFn<'a, K> = &'a mut dyn FnMut(&K) -> i64;
type EqFn<'a, K> = &'a mut dyn FnMut(&K, &K) -> bool;

/// Entries in first-insertion order (`None` where one was removed) with each
/// key's digest; `buckets` maps a digest to its slots. An overwrite keeps the
/// key's position [col-insertion-order].
#[derive(Clone)]
pub struct Map<K, V> {
    slots: Vec<Option<(i64, K, V)>>,
    buckets: HashMap<i64, Vec<usize>>,
    live: usize,
}

pub type MutMap<K, V> = Map<K, V>;

impl<K, V> Map<K, V> {
    fn new() -> Self {
        Map { slots: Vec::new(), buckets: HashMap::new(), live: 0 }
    }

    fn find(&self, key: &K, hash: HashFn<K>, eq: EqFn<K>) -> Option<usize> {
        let bucket = self.buckets.get(&hash(key))?;
        bucket
            .iter()
            .copied()
            .find(|&i| self.slots[i].as_ref().is_some_and(|(_, k, _)| eq(k, key)))
    }

    fn append(&mut self, digest: i64, key: K, value: V) {
        self.slots.push(Some((digest, key, value)));
        self.buckets.entry(digest).or_default().push(self.slots.len() - 1);
        self.live += 1;
    }

    /// Stores `value` under `key`: an existing key keeps its place and takes
    /// the new key and value. Answers the displaced value.
    fn store(&mut self, key: K, value: V, hash: HashFn<K>, eq: EqFn<K>) -> Option<V> {
        match self.find(&key, &mut *hash, eq) {
            Some(i) => {
                let (digest, _, old) = self.slots[i].take().expect("a found slot is live");
                self.slots[i] = Some((digest, key, value));
                Some(old)
            }
            None => {
                let digest = hash(&key);
                self.append(digest, key, value);
                None
            }
        }
    }

    fn remove_at(&mut self, i: usize) -> Option<V> {
        let (digest, _, value) = self.slots[i].take()?;
        if let Some(bucket) = self.buckets.get_mut(&digest) {
            bucket.retain(|&j| j != i);
            if bucket.is_empty() {
                self.buckets.remove(&digest);
            }
        }
        self.live -= 1;
        if self.slots.len() > 2 * self.live + 8 {
            let slots = std::mem::take(&mut self.slots);
            self.buckets.clear();
            self.live = 0;
            for (d, k, v) in slots.into_iter().flatten() {
                self.append(d, k, v);
            }
        }
        Some(value)
    }

    /// The entries, in insertion order.
    pub fn iter(&self) -> impl Iterator<Item = (&K, &V)> + '_ {
        self.slots.iter().filter_map(|s| s.as_ref().map(|(_, k, v)| (k, v)))
    }
}

/// Order-blind, on host equality (what a struct holding a map compares by;
/// ROADMAP §0j step 8 owns replacing it).
impl<K: PartialEq, V: PartialEq> PartialEq for Map<K, V> {
    fn eq(&self, other: &Self) -> bool {
        self.live == other.live
            && self.slots.iter().flatten().all(|(d, k, v)| {
                other.buckets.get(d).is_some_and(|b| {
                    b.iter().any(|&j| other.slots[j].as_ref().is_some_and(|(_, ok, ov)| ok == k && ov == v))
                })
            })
    }
}

impl<K: PartialEq, V: PartialEq> Eq for Map<K, V> {}

impl<K: fmt::Debug, V: fmt::Debug> fmt::Debug for Map<K, V> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_map().entries(self.iter()).finish()
    }
}

/// `{a: 1, b: 2}`, in insertion order — the map literal that would build it
/// [col-to-str].
impl<K: fmt::Display, V: fmt::Display> fmt::Display for Map<K, V> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{{")?;
        for (i, (k, v)) in self.iter().enumerate() {
            if i > 0 {
                write!(f, ", ")?;
            }
            write!(f, "{k}: {v}")?;
        }
        write!(f, "}}")
    }
}

/// [platform-value-type] For host code: the digest Salvo's canonical `hash`
/// answers for an intrinsic key type (`Str`, `Int`, `Long`, `Char`, `Bool`,
/// `Byte`) — the standard library's `DefaultHasher` over the value, which is
/// what the `hash` intrinsics lower to.
pub fn canonical_hash<K: std::hash::Hash + ?Sized>(k: &K) -> i64 {
    let mut h = std::collections::hash_map::DefaultHasher::new();
    k.hash(&mut h);
    std::hash::Hasher::finish(&h) as i64
}

/// [platform-value-type] For host code: a map keyed **canonically** (the
/// identity Salvo resolves for an intrinsic key type), in the order given; a
/// repeated key keeps its first place and takes its last value
/// [col-duplicate-keys].
pub fn canonical_map<K: std::hash::Hash + PartialEq, V>(entries: Vec<(K, V)>) -> Map<K, V> {
    map_of(entries, &mut |k: &K| canonical_hash(k), &mut |a: &K, b: &K| a == b)
}

// [platform-iterable] [col-map-iter] The host's loop over a map: its keys,
// in insertion order.
pub fn each<K, V>(map: &Map<K, V>) -> impl Iterator<Item = &K> + '_ {
    map.iter().map(|(k, _)| k)
}

pub fn each_mut<K, V>(_map: &mut Map<K, V>) -> std::iter::Empty<&mut K> {
    // A key is written in place nowhere: it would move in the map.
    unreachable!("salvo: a map's keys are not written in place")
}

pub fn into_each<K, V>(map: Map<K, V>) -> std::vec::IntoIter<K> {
    map.slots.into_iter().flatten().map(|(_, k, _)| k).collect::<Vec<K>>().into_iter()
}

// A repeated key keeps the position of its first appearance and takes the
// value of its last [col-duplicate-keys].
pub fn map_of<K, V>(entries: Vec<(K, V)>, hash: HashFn<K>, eq: EqFn<K>) -> Map<K, V> {
    let mut m = Map::new();
    for (k, v) in entries {
        m.store(k, v, &mut *hash, &mut *eq);
    }
    m
}

pub fn mut_map_of<K, V>(entries: Vec<(K, V)>, hash: HashFn<K>, eq: EqFn<K>) -> Map<K, V> {
    map_of(entries, hash, eq)
}

pub fn map_by<K, V>(size: i32, init: &mut dyn FnMut(i32) -> (K, V), hash: HashFn<K>, eq: EqFn<K>) -> Map<K, V> {
    let mut m = Map::new();
    for i in 0..size.max(0) {
        let (k, v) = init(i);
        m.store(k, v, &mut *hash, &mut *eq);
    }
    m
}

pub fn mut_map_by<K, V>(size: i32, init: &mut dyn FnMut(i32) -> (K, V), hash: HashFn<K>, eq: EqFn<K>) -> Map<K, V> {
    map_by(size, init, hash, eq)
}

pub fn to_map<K: Clone, V: Clone>(pairs: &Vec<(K, V)>, hash: HashFn<K>, eq: EqFn<K>) -> Map<K, V> {
    map_of(pairs.clone(), hash, eq)
}

pub fn get<'a, K, V>(map: &'a Map<K, V>, key: &K, hash: HashFn<K>, eq: EqFn<K>) -> Option<&'a V> {
    let i = map.find(key, hash, eq)?;
    map.slots[i].as_ref().map(|(_, _, v)| v)
}

// The claim proved the key present [qual-depend].
pub fn get_present<'a, K, V>(map: &'a Map<K, V>, key: &K, hash: HashFn<K>, eq: EqFn<K>) -> &'a V {
    get(map, key, hash, eq).expect("salvo: a `KeyOf` key is absent")
}

pub fn put<K, V>(map: &mut Map<K, V>, key: K, value: V, hash: HashFn<K>, eq: EqFn<K>) {
    map.store(key, value, hash, eq);
}

pub fn replace<K, V>(map: &mut Map<K, V>, key: K, value: V, hash: HashFn<K>, eq: EqFn<K>) -> Option<V> {
    map.store(key, value, hash, eq)
}

pub fn remove<K, V>(map: &mut Map<K, V>, key: &K, hash: HashFn<K>, eq: EqFn<K>) -> Option<V> {
    let i = map.find(key, hash, eq)?;
    map.remove_at(i)
}

pub fn contains_key<K, V>(map: &Map<K, V>, key: &K, hash: HashFn<K>, eq: EqFn<K>) -> bool {
    map.find(key, hash, eq).is_some()
}

pub fn size<K, V>(map: &Map<K, V>) -> i32 {
    map.live as i32
}

pub fn keys<K: Clone, V>(map: &Map<K, V>) -> Vec<K> {
    map.iter().map(|(k, _)| k.clone()).collect()
}

// [linear-container] The values, owned, in insertion order.
pub fn into_values<K, V>(map: Map<K, V>) -> Vec<V> {
    map.slots.into_iter().flatten().map(|(_, _, v)| v).collect()
}

// ===== platform/core/set.rs =====
// [platform-value-type] [platform-slots] std's set, for `core.set`'s `platform
// type Set<T>(?hash, ?eq) canbe Mut`: one insertion-ordered slab for every
// identity (ROADMAP §0j step 7, user decision 2026-10-06). Every operation is
// handed the `hash` and `eq` its call resolved, lent for the call
// [platform-fn-value]; the set keeps the elements and the digest each was
// filed under, nothing else. `Mut Set` is the same type, passed as `&mut`.

use std::collections::HashMap;
use std::fmt;

type HashFn<'a, T> = &'a mut dyn FnMut(&T) -> i64;
type EqFn<'a, T> = &'a mut dyn FnMut(&T, &T) -> bool;

/// Elements in first-insertion order (`None` where one was removed) with the
/// digest each was filed under; `buckets` maps a digest to its slots. The
/// cached digests let compaction and equality run without an identity.
#[derive(Clone)]
pub struct Set<T> {
    slots: Vec<Option<(i64, T)>>,
    buckets: HashMap<i64, Vec<usize>>,
    live: usize,
}

pub type MutSet<T> = Set<T>;

impl<T> Set<T> {
    fn new() -> Self {
        Set { slots: Vec::new(), buckets: HashMap::new(), live: 0 }
    }

    fn find(&self, elem: &T, hash: HashFn<T>, eq: EqFn<T>) -> Option<usize> {
        let bucket = self.buckets.get(&hash(elem))?;
        bucket
            .iter()
            .copied()
            .find(|&i| self.slots[i].as_ref().is_some_and(|(_, e)| eq(e, elem)))
    }

    fn append(&mut self, digest: i64, elem: T) {
        self.slots.push(Some((digest, elem)));
        self.buckets.entry(digest).or_default().push(self.slots.len() - 1);
        self.live += 1;
    }

    /// Adds `elem`, or overwrites an equal one in place: the last wins
    /// [col-duplicate-keys].
    fn put(&mut self, elem: T, hash: HashFn<T>, eq: EqFn<T>) {
        match self.find(&elem, &mut *hash, eq) {
            Some(i) => {
                let digest = self.slots[i].as_ref().map(|(d, _)| *d).unwrap_or_default();
                self.slots[i] = Some((digest, elem));
            }
            None => {
                let digest = hash(&elem);
                self.append(digest, elem);
            }
        }
    }

    fn remove_at(&mut self, i: usize) {
        if let Some((digest, _)) = self.slots[i].take() {
            if let Some(bucket) = self.buckets.get_mut(&digest) {
                bucket.retain(|&j| j != i);
                if bucket.is_empty() {
                    self.buckets.remove(&digest);
                }
            }
            self.live -= 1;
        }
        if self.slots.len() > 2 * self.live + 8 {
            let slots = std::mem::take(&mut self.slots);
            self.buckets.clear();
            self.live = 0;
            for (digest, elem) in slots.into_iter().flatten() {
                self.append(digest, elem);
            }
        }
    }

    /// The elements, in insertion order.
    pub fn iter(&self) -> impl Iterator<Item = &T> + '_ {
        self.slots.iter().filter_map(|s| s.as_ref().map(|(_, e)| e))
    }
}

/// Order-blind, as a set is: the same elements, each found under the digest
/// the other filed it by. Host equality on the elements — what a struct
/// holding a set compares by (ROADMAP §0j step 8 owns replacing it).
impl<T: PartialEq> PartialEq for Set<T> {
    fn eq(&self, other: &Self) -> bool {
        self.live == other.live
            && self.slots.iter().flatten().all(|(d, e)| {
                other
                    .buckets
                    .get(d)
                    .is_some_and(|b| b.iter().any(|&j| other.slots[j].as_ref().is_some_and(|(_, o)| o == e)))
            })
    }
}

impl<T: PartialEq> Eq for Set<T> {}

impl<T: fmt::Debug> fmt::Debug for Set<T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_set().entries(self.iter()).finish()
    }
}

/// `{1, 2, 3}`: the set literal that would build it.
impl<T: fmt::Display> fmt::Display for Set<T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{{")?;
        for (i, e) in self.iter().enumerate() {
            if i > 0 {
                write!(f, ", ")?;
            }
            write!(f, "{e}")?;
        }
        write!(f, "}}")
    }
}

/// [platform-value-type] For host code: a set kept **canonically** (the
/// identity Salvo resolves for an intrinsic element type: the standard
/// library's `DefaultHasher` over the value, and `==`). A repeated element:
/// the last wins.
pub fn canonical_set<T: std::hash::Hash + PartialEq>(elems: Vec<T>) -> Set<T> {
    set_of(
        elems,
        &mut |e: &T| {
            let mut h = std::collections::hash_map::DefaultHasher::new();
            e.hash(&mut h);
            std::hash::Hasher::finish(&h) as i64
        },
        &mut |a: &T, b: &T| a == b,
    )
}

// [platform-iterable] The host's loop over a set, in insertion order.
pub fn each<T>(set: &Set<T>) -> impl Iterator<Item = &T> + '_ {
    set.iter()
}

pub fn each_mut<T>(_set: &mut Set<T>) -> std::iter::Empty<&mut T> {
    // An element is a key: writing through one would move it in the set.
    unreachable!("salvo: a set's elements are not written in place")
}

pub fn into_each<T>(set: Set<T>) -> std::vec::IntoIter<T> {
    set.slots.into_iter().flatten().map(|(_, e)| e).collect::<Vec<T>>().into_iter()
}

pub fn set_of<T>(elems: Vec<T>, hash: HashFn<T>, eq: EqFn<T>) -> Set<T> {
    let mut s = Set::new();
    for e in elems {
        s.put(e, &mut *hash, &mut *eq);
    }
    s
}

pub fn mut_set_of<T>(elems: Vec<T>, hash: HashFn<T>, eq: EqFn<T>) -> Set<T> {
    set_of(elems, hash, eq)
}

pub fn set_by<T>(size: i32, init: &mut dyn FnMut(i32) -> T, hash: HashFn<T>, eq: EqFn<T>) -> Set<T> {
    let mut s = Set::new();
    for i in 0..size.max(0) {
        s.put(init(i), &mut *hash, &mut *eq);
    }
    s
}

pub fn mut_set_by<T>(size: i32, init: &mut dyn FnMut(i32) -> T, hash: HashFn<T>, eq: EqFn<T>) -> Set<T> {
    set_by(size, init, hash, eq)
}

pub fn to_set<T: Clone>(list: &Vec<T>, hash: HashFn<T>, eq: EqFn<T>) -> Set<T> {
    set_of(list.clone(), hash, eq)
}

pub fn add<T>(set: &mut Set<T>, elem: T, hash: HashFn<T>, eq: EqFn<T>) -> bool {
    if set.find(&elem, &mut *hash, eq).is_some() {
        return false;
    }
    let digest = hash(&elem);
    set.append(digest, elem);
    true
}

pub fn remove<T>(set: &mut Set<T>, elem: &T, hash: HashFn<T>, eq: EqFn<T>) -> bool {
    match set.find(elem, hash, eq) {
        Some(i) => {
            set.remove_at(i);
            true
        }
        None => false,
    }
}

pub fn contains<T>(set: &Set<T>, elem: &T, hash: HashFn<T>, eq: EqFn<T>) -> bool {
    set.find(elem, hash, eq).is_some()
}

pub fn size<T>(set: &Set<T>) -> i32 {
    set.live as i32
}

// In insertion order [col-insertion-order].
pub fn to_list<T: Clone>(set: &Set<T>) -> Vec<T> {
    set.iter().cloned().collect()
}

// ===== platform/core/sorted.rs =====
// [platform-value-type] [platform-slots] std's sorted pair, for `core.sorted`'s
// `platform type SortedSet<T>(?cmp)` and `SortedMap<K, V>(?cmp)`: a sorted
// `Vec` searched by bisection (ROADMAP §0j step 7, user decision 2026-10-06).
// Every operation is handed the `cmp` its call resolved, lent for the call
// [platform-fn-value]; the value keeps only its members, in order. Two
// members are one when `cmp` answers 0 [col-membership]. A `Mut` one is the
// same type, passed as `&mut`.

use std::fmt;

type CmpFn<'a, T> = &'a mut dyn FnMut(&T, &T) -> i32;

/// Where `x` is in `items`: `Ok(i)`, or `Err(insertion point)`.
fn bisect<T>(items: &[T], x: &T, cmp: CmpFn<T>) -> Result<usize, usize> {
    items.binary_search_by(|e| cmp(e, x).cmp(&0))
}

#[derive(Clone, PartialEq, Eq)]
pub struct SortedSet<T> {
    items: Vec<T>,
}

pub type MutSortedSet<T> = SortedSet<T>;

#[derive(Clone, PartialEq, Eq)]
pub struct SortedMap<K, V> {
    keys: Vec<K>,
    values: Vec<V>,
}

pub type MutSortedMap<K, V> = SortedMap<K, V>;

impl<T> SortedSet<T> {
    /// The members, in order.
    pub fn iter(&self) -> impl Iterator<Item = &T> + '_ {
        self.items.iter()
    }
}

impl<K, V> SortedMap<K, V> {
    /// The entries, in key order.
    pub fn iter(&self) -> impl Iterator<Item = (&K, &V)> + '_ {
        self.keys.iter().zip(self.values.iter())
    }

    /// Stores under `key`; an equal key is replaced, key and value. Answers
    /// the displaced value.
    fn store(&mut self, key: K, value: V, cmp: CmpFn<K>) -> Option<V> {
        match bisect(&self.keys, &key, cmp) {
            Ok(i) => {
                self.keys[i] = key;
                Some(std::mem::replace(&mut self.values[i], value))
            }
            Err(i) => {
                self.keys.insert(i, key);
                self.values.insert(i, value);
                None
            }
        }
    }
}

impl<T: fmt::Debug> fmt::Debug for SortedSet<T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_set().entries(self.items.iter()).finish()
    }
}

impl<T: fmt::Display> fmt::Display for SortedSet<T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{{")?;
        for (i, e) in self.items.iter().enumerate() {
            if i > 0 {
                write!(f, ", ")?;
            }
            write!(f, "{e}")?;
        }
        write!(f, "}}")
    }
}

impl<K: fmt::Debug, V: fmt::Debug> fmt::Debug for SortedMap<K, V> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_map().entries(self.keys.iter().zip(self.values.iter())).finish()
    }
}

/// `{a: 1, b: 2}`, in key order [col-to-str].
impl<K: fmt::Display, V: fmt::Display> fmt::Display for SortedMap<K, V> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{{")?;
        for (i, (k, v)) in self.keys.iter().zip(self.values.iter()).enumerate() {
            if i > 0 {
                write!(f, ", ")?;
            }
            write!(f, "{k}: {v}")?;
        }
        write!(f, "}}")
    }
}

/// [platform-value-type] For host code: a sorted set under the canonical
/// ordering of an intrinsic type, which is `Ord` (a `String` compares by
/// bytes, which is code-point order).
pub fn canonical_sorted_set<T: Ord>(elems: Vec<T>) -> SortedSet<T> {
    sorted_set_of(elems, &mut |a: &T, b: &T| a.cmp(b) as i32)
}

/// [platform-value-type] For host code: a sorted map under the canonical
/// ordering of an intrinsic key type.
pub fn canonical_sorted_map<K: Ord, V>(entries: Vec<(K, V)>) -> SortedMap<K, V> {
    sorted_map_of(entries, &mut |a: &K, b: &K| a.cmp(b) as i32)
}

// [platform-iterable] The host's loops: a set's elements and a map's keys,
// in order. Elements and keys are not written in place.
pub fn each_sorted_set<T>(set: &SortedSet<T>) -> impl Iterator<Item = &T> + '_ {
    set.items.iter()
}

pub fn each_sorted_set_mut<T>(_set: &mut SortedSet<T>) -> std::iter::Empty<&mut T> {
    unreachable!("salvo: a sorted set's elements are not written in place")
}

pub fn into_each_sorted_set<T>(set: SortedSet<T>) -> std::vec::IntoIter<T> {
    set.items.into_iter()
}

pub fn each_sorted_map<K, V>(map: &SortedMap<K, V>) -> impl Iterator<Item = &K> + '_ {
    map.keys.iter()
}

pub fn each_sorted_map_mut<K, V>(_map: &mut SortedMap<K, V>) -> std::iter::Empty<&mut K> {
    unreachable!("salvo: a sorted map's keys are not written in place")
}

pub fn into_each_sorted_map<K, V>(map: SortedMap<K, V>) -> std::vec::IntoIter<K> {
    map.keys.into_iter()
}

// A repeated member: the last wins, in the place they share.
pub fn sorted_set_of<T>(elems: Vec<T>, cmp: CmpFn<T>) -> SortedSet<T> {
    let mut s = SortedSet { items: Vec::with_capacity(elems.len()) };
    for e in elems {
        match bisect(&s.items, &e, &mut *cmp) {
            Ok(i) => s.items[i] = e,
            Err(i) => s.items.insert(i, e),
        }
    }
    s
}

pub fn mut_sorted_set_of<T>(elems: Vec<T>, cmp: CmpFn<T>) -> SortedSet<T> {
    sorted_set_of(elems, cmp)
}

pub fn add<T>(set: &mut SortedSet<T>, elem: T, cmp: CmpFn<T>) -> bool {
    match bisect(&set.items, &elem, cmp) {
        Ok(_) => false,
        Err(i) => {
            set.items.insert(i, elem);
            true
        }
    }
}

pub fn remove_elem<T>(set: &mut SortedSet<T>, elem: &T, cmp: CmpFn<T>) -> bool {
    match bisect(&set.items, elem, cmp) {
        Ok(i) => {
            set.items.remove(i);
            true
        }
        Err(_) => false,
    }
}

pub fn contains<T>(set: &SortedSet<T>, elem: &T, cmp: CmpFn<T>) -> bool {
    bisect(&set.items, elem, cmp).is_ok()
}

pub fn set_size<T>(set: &SortedSet<T>) -> i32 {
    set.items.len() as i32
}

pub fn min<T: Clone>(set: &SortedSet<T>) -> Option<T> {
    set.items.first().cloned()
}

pub fn max<T: Clone>(set: &SortedSet<T>) -> Option<T> {
    set.items.last().cloned()
}

pub fn to_list<T: Clone>(set: &SortedSet<T>) -> Vec<T> {
    set.items.clone()
}

pub fn sorted_map_of<K, V>(entries: Vec<(K, V)>, cmp: CmpFn<K>) -> SortedMap<K, V> {
    let mut m = SortedMap { keys: Vec::with_capacity(entries.len()), values: Vec::with_capacity(entries.len()) };
    for (k, v) in entries {
        m.store(k, v, &mut *cmp);
    }
    m
}

pub fn mut_sorted_map_of<K, V>(entries: Vec<(K, V)>, cmp: CmpFn<K>) -> SortedMap<K, V> {
    sorted_map_of(entries, cmp)
}

pub fn get<'a, K, V>(map: &'a SortedMap<K, V>, key: &K, cmp: CmpFn<K>) -> Option<&'a V> {
    bisect(&map.keys, key, cmp).ok().map(|i| &map.values[i])
}

pub fn put<K, V>(map: &mut SortedMap<K, V>, key: K, value: V, cmp: CmpFn<K>) {
    map.store(key, value, cmp);
}

pub fn remove_key<K, V>(map: &mut SortedMap<K, V>, key: &K, cmp: CmpFn<K>) -> Option<V> {
    let i = bisect(&map.keys, key, cmp).ok()?;
    map.keys.remove(i);
    Some(map.values.remove(i))
}

pub fn contains_key<K, V>(map: &SortedMap<K, V>, key: &K, cmp: CmpFn<K>) -> bool {
    bisect(&map.keys, key, cmp).is_ok()
}

pub fn map_size<K, V>(map: &SortedMap<K, V>) -> i32 {
    map.keys.len() as i32
}

pub fn first_key<K: Clone, V>(map: &SortedMap<K, V>) -> Option<K> {
    map.keys.first().cloned()
}

pub fn last_key<K: Clone, V>(map: &SortedMap<K, V>) -> Option<K> {
    map.keys.last().cloned()
}

pub fn keys<K: Clone, V>(map: &SortedMap<K, V>) -> Vec<K> {
    map.keys.clone()
}

// ===== platform/core/string.rs =====
// [platform-value-type] std's string, for `core.string`'s
// `platform type Str canbe Mut` (ROADMAP 0.7). A `Str` is a `String`, and so
// is a `Mut Str`, passed as `&mut`. Indices count characters, not bytes.

pub type Str = String;
pub type MutStr = String;

// [platform-iterable] The host's loop over a string: its characters.
pub fn each(str: &String) -> std::str::Chars<'_> {
    str.chars()
}

pub fn empty_str() -> MutStr {
    String::new()
}

pub fn size(str: &String) -> i32 {
    str.chars().count() as i32
}

// The UTF-8 byte count, which the filesystem's offsets are in [fs-token].
pub fn byte_size(str: &String) -> i64 {
    str.len() as i64
}

pub fn char_at(str: &String, index: i32) -> Option<char> {
    if index < 0 { None } else { str.chars().nth(index as usize) }
}

pub fn split(str: &String, sep: &String) -> Vec<String> {
    str.split(&sep[..]).map(|p| p.to_string()).collect()
}

fn chars_before(s: &str, byte: usize) -> i32 {
    s[..byte].chars().count() as i32
}

pub fn index_of(str: &String, needle: &String) -> Option<i32> {
    str.find(&needle[..]).map(|b| chars_before(str, b))
}

// [str-search] From a character offset; below 0 is the start.
pub fn index_of_from(str: &String, needle: &String, from: i32) -> Option<i32> {
    let from = from.max(0) as usize;
    if from > str.chars().count() {
        return None;
    }
    let start = str.char_indices().nth(from).map(|(b, _)| b).unwrap_or(str.len());
    str[start..].find(&needle[..]).map(|k| chars_before(str, start + k))
}

pub fn last_index_of(str: &String, needle: &String) -> Option<i32> {
    str.rfind(&needle[..]).map(|b| chars_before(str, b))
}

pub fn replace(str: &String, from: &String, to: &String) -> String {
    str.replace(&from[..], &to[..])
}

pub fn trim_start(str: &String) -> String {
    str.trim_start().to_string()
}

pub fn trim_end(str: &String) -> String {
    str.trim_end().to_string()
}

pub fn contains(str: &String, needle: &String) -> bool {
    str.contains(&needle[..])
}

pub fn starts_with(str: &String, prefix: &String) -> bool {
    str.starts_with(&prefix[..])
}

pub fn ends_with(str: &String, suffix: &String) -> bool {
    str.ends_with(&suffix[..])
}

pub fn trim(str: &String) -> String {
    str.trim().to_string()
}

// Unchanged when the affix is absent.
pub fn trim_prefix(str: &String, prefix: &String) -> String {
    str.strip_prefix(&prefix[..]).unwrap_or(str).to_string()
}

pub fn trim_suffix(str: &String, suffix: &String) -> String {
    str.strip_suffix(&suffix[..]).unwrap_or(str).to_string()
}

// Out of range is `None`, not a panic.
pub fn substr(str: &String, start: i32, end: i32) -> Option<String> {
    let n = str.chars().count() as i32;
    if start >= 0 && end >= start && end <= n {
        Some(str.chars().skip(start as usize).take((end - start) as usize).collect())
    } else {
        None
    }
}

pub fn to_upper(str: &String) -> String {
    str.to_uppercase()
}

pub fn to_lower(str: &String) -> String {
    str.to_lowercase()
}

pub fn join(parts: &Vec<String>, sep: &String) -> String {
    parts.join(&sep[..])
}

pub fn parse_int(str: &String) -> Option<i32> {
    str.parse::<i32>().ok()
}

pub fn append(str: &mut String, text: &String) {
    str.push_str(text);
}

// [col-bounds] Out of range writes nothing and answers `false`.
pub fn set(str: &mut String, index: i32, chr: char) -> bool {
    if index < 0 || index as usize >= str.chars().count() {
        return false;
    }
    let i = index as usize;
    *str = str.chars().enumerate().map(|(k, c)| if k == i { chr } else { c }).collect();
    true
}

pub fn clear(str: &mut String) {
    str.clear();
}
