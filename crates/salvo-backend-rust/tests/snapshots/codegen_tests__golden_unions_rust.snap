// ===== core/string.rs =====
use crate::core_iterator::*;
use crate::core_list::*;
use crate::unions::*;

pub fn iter__3(str: String) -> StrYield {
    return StrYield { text: str, at: 0 };
}

#[derive(Clone, Debug)]
pub struct StrYield {
    pub text: String,
    pub at: i32,
}

pub fn next__5(p: &mut StrYield) -> Union2<char, Finished> {
    let mut chr = p.text.chars().nth((p.at) as usize);
    if chr.is_none() {
        return Union2::<char, Finished>::U2(finished());
    }
    p.at = p.at + 1;
    return Union2::<char, Finished>::U1(emitted(chr.unwrap()));
}

// ===== main.rs =====
#![allow(non_snake_case, non_camel_case_types, unused_mut, unused_parens, unused_imports, dead_code, unreachable_code, unused_variables, path_statements, unused_must_use, suspicious_double_ref_op)]
#[path = "unions.rs"]
pub mod unions;
#[path = "core/array.rs"]
pub mod core_array;
#[path = "core/console.rs"]
pub mod core_console;
#[path = "core/iterator.rs"]
pub mod core_iterator;
#[path = "core/list.rs"]
pub mod core_list;
#[path = "core/result.rs"]
pub mod core_result;
#[path = "core/string.rs"]
pub mod core_string;

use crate::core_console::*;
use crate::core_iterator::*;
use crate::core_result::*;
use crate::core_string::*;
use crate::unions::*;

pub fn parse_age(input: i32) -> Union2<i32, String> {
    if input >= 0 {
        return Union2::<i32, String>::U1(ok(input));
    }
    return Union2::<i32, String>::U2(err("negative age".to_string()));
}

pub fn describe(result: &Union2<i32, String>) -> String {
    let mut msg = match result {
        Union2::U1(_) => {
            format!("age {}", *result.u1())
        }
        Union2::U2(_) => {
            format!("error: {}", result.u2().clone())
        }
    };
    return msg;
}

pub fn main() {
    let mut console = StdOutConsole::new();
    let mut good = parse_age(36);
    println(&mut console, &(describe(&good)));
    let mut bad = parse_age(-1);
    println(&mut console, &(describe(&bad)));
    let mut precise: Union3<String, String, bool> = Union3::<String, String, bool>::U1(ok("yes".to_string()));
    if matches!(precise, Union3::U2(_)) {
        println(&mut console, &(format!("err str: {}", precise.u2().clone())));
    } else if matches!(precise, Union3::U1(_)) {
        println(&mut console, &(format!("ok: {}", precise.u1().clone())));
    } else {
        println(&mut console, &(format!("err bool: {}", *precise.u3())));
    }
    let mut value = match good {
        Union2::U1(_) => {
            *good.u1()
        }
        Union2::U2(_) => {
            return;
        }
    };
    println(&mut console, &(format!("value plus one is {}", value + 1)));
}

