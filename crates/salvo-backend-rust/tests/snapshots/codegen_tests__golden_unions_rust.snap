    fn __enc(&self, out: &mut Vec<u8>) {
        match self {
            Union2::U1(v) => {
                out.push(0);
                crate::wire::__Wire::__enc(v, out);
            }
            Union2::U2(v) => {
                out.push(1);
                crate::wire::__Wire::__enc(v, out);
            }
        }
    }
    fn __dec(r: &mut crate::wire::__Reader<'_>) -> Option<Self> {
        match r.u8()? {
            0 => Some(Union2::U1(crate::wire::__Wire::__dec(r)?)),
            1 => Some(Union2::U2(crate::wire::__Wire::__dec(r)?)),
            _ => None,
        }
    }
}

