pub fn contains<T: Clone>(list: &Vec<T>, elem: &T, eq: &mut dyn FnMut(&T, &T) -> bool) -> bool {
    let mut i = 0;
    while i < size_platform(list) {
        if eq(&get_platform(list, i).expect("salvo: value is absent at core.list:438:15"), elem) {
            return true;
        }
        i = i + 1;
