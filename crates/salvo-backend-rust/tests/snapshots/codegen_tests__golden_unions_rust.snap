// ===== wire.rs =====
// Generated by the Salvo compiler: the wire — the canonical encoding's codec
// trait and the language's own codecs [wire-format] [rs-wire].
//
// One half of the encoding: the Rust runtime's codec trait and its impls for every type the language defines
// without the program's help. The Kotlin runtime's `wire.kt` produces and
// reads the same bytes, which is what lets the two share a group; the
// encoding is stated once, in `salvo-core`'s `wire.rs`, and implemented here
// twice. Struct, union and message codecs are *generated* by the emitter
// beside their declarations as `impl __Wire`.
//
// Every integer is big-endian; every length is a `u32`; an optional is a
// presence byte; a union is a tag byte holding the arm's declared index.
// Decoding is total: a malformed input answers `None` rather than panicking,
// and `salvo_decode` refuses trailing bytes so a frame is exactly one value.

pub struct __Reader<'a> {
    data: &'a [u8],
    pos: usize,
}

impl<'a> __Reader<'a> {
    pub fn new(data: &'a [u8]) -> Self {
        Self { data, pos: 0 }
    }

    fn take(&mut self, n: usize) -> Option<&'a [u8]> {
        let end = self.pos.checked_add(n)?;
        if end > self.data.len() {
            return None;
        }
        let out = &self.data[self.pos..end];
        self.pos = end;
        Some(out)
    }

    pub fn u8(&mut self) -> Option<u8> {
        self.take(1).map(|b| b[0])
    }

    pub fn u32(&mut self) -> Option<u32> {
        let b = self.take(4)?;
        Some(u32::from_be_bytes([b[0], b[1], b[2], b[3]]))
    }

    pub fn u64(&mut self) -> Option<u64> {
        let b = self.take(8)?;
        let mut a = [0u8; 8];
        a.copy_from_slice(b);
        Some(u64::from_be_bytes(a))
    }

    /// A length prefix, bounded by what is left so a hostile length cannot
    /// ask for an allocation the input does not carry.
    pub fn len(&mut self) -> Option<usize> {
        let n = self.u32()? as usize;
        if n > self.data.len() - self.pos {
            return None;
        }
        Some(n)
    }

    pub fn done(&self) -> bool {
        self.pos == self.data.len()
    }
}

pub trait __Wire: Sized {
    fn __enc(&self, out: &mut Vec<u8>);
    fn __dec(r: &mut __Reader<'_>) -> Option<Self>;
}

/// `encode(value)`: the whole value, as one frame.
pub fn salvo_encode<T: __Wire>(v: &T) -> Vec<u8> {
    let mut out = Vec::new();
    v.__enc(&mut out);
    out
}

/// `decode<T>(bytes)`: `None` on a malformed input, including trailing bytes.
pub fn salvo_decode<T: __Wire>(data: &[u8]) -> Option<T> {
    let mut r = __Reader::new(data);
    let v = T::__dec(&mut r)?;
    if !r.done() {
        return None;
    }
    Some(v)
}

impl __Wire for bool {
    fn __enc(&self, out: &mut Vec<u8>) {
        out.push(u8::from(*self));
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        match r.u8()? {
            0 => Some(false),
            1 => Some(true),
            _ => None,
        }
    }
}

impl __Wire for u8 {
    fn __enc(&self, out: &mut Vec<u8>) {
        out.push(*self);
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        r.u8()
    }
}

impl __Wire for i32 {
    fn __enc(&self, out: &mut Vec<u8>) {
        out.extend_from_slice(&self.to_be_bytes());
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        r.u32().map(|v| v as i32)
    }
}

impl __Wire for i64 {
    fn __enc(&self, out: &mut Vec<u8>) {
        out.extend_from_slice(&self.to_be_bytes());
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        r.u64().map(|v| v as i64)
    }
}

impl __Wire for f32 {
    fn __enc(&self, out: &mut Vec<u8>) {
        out.extend_from_slice(&self.to_bits().to_be_bytes());
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        r.u32().map(f32::from_bits)
    }
}

impl __Wire for f64 {
    fn __enc(&self, out: &mut Vec<u8>) {
        out.extend_from_slice(&self.to_bits().to_be_bytes());
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        r.u64().map(f64::from_bits)
    }
}

impl __Wire for char {
    fn __enc(&self, out: &mut Vec<u8>) {
        out.extend_from_slice(&(*self as u32).to_be_bytes());
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        char::from_u32(r.u32()?)
    }
}

impl __Wire for String {
    fn __enc(&self, out: &mut Vec<u8>) {
        out.extend_from_slice(&(self.len() as u32).to_be_bytes());
        out.extend_from_slice(self.as_bytes());
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        let n = r.len()?;
        let b = r.take(n)?;
        String::from_utf8(b.to_vec()).ok()
    }
}

/// `None` (the unit type) is nothing on the wire.
impl __Wire for () {
    fn __enc(&self, _out: &mut Vec<u8>) {}
    fn __dec(_r: &mut __Reader<'_>) -> Option<Self> {
        Some(())
    }
}

/// A `List<T>`, an array, and `Bytes` alike: a count then the elements —
/// `Bytes` being `Vec<u8>`, whose elements are one byte each, so the two
/// readings of `Vec<u8>` agree byte for byte.
impl<T: __Wire> __Wire for Vec<T> {
    fn __enc(&self, out: &mut Vec<u8>) {
        out.extend_from_slice(&(self.len() as u32).to_be_bytes());
        for v in self {
            v.__enc(out);
        }
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        let n = r.len()?;
        let mut out = Vec::with_capacity(n);
        for _ in 0..n {
            out.push(T::__dec(r)?);
        }
        Some(out)
    }
}

/// An optional — `T?`, or any union with a `None` arm — is a presence byte.
impl<T: __Wire> __Wire for Option<T> {
    fn __enc(&self, out: &mut Vec<u8>) {
        match self {
            None => out.push(0),
            Some(v) => {
                out.push(1);
                v.__enc(out);
            }
        }
    }
    fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
        match r.u8()? {
            0 => Some(None),
            1 => Some(Some(T::__dec(r)?)),
            _ => None,
        }
    }
}

macro_rules! __wire_tuple {
    ($($name:ident $idx:tt),+) => {
        impl<$($name: __Wire),+> __Wire for ($($name,)+) {
            fn __enc(&self, out: &mut Vec<u8>) {
                $(self.$idx.__enc(out);)+
            }
            fn __dec(r: &mut __Reader<'_>) -> Option<Self> {
                Some(($($name::__dec(r)?,)+))
            }
        }
    };
}
__wire_tuple!(A 0, B 1);
__wire_tuple!(A 0, B 1, C 2);
__wire_tuple!(A 0, B 1, C 2, D 3);
__wire_tuple!(A 0, B 1, C 2, D 3, E 4);
__wire_tuple!(A 0, B 1, C 2, D 3, E 4, F 5);
__wire_tuple!(A 0, B 1, C 2, D 3, E 4, F 5, G 6);
__wire_tuple!(A 0, B 1, C 2, D 3, E 4, F 5, G 6, H 7);

// ===== seq.rs =====
// Generated by the Salvo compiler: sequence helpers. (`List`'s operations are
// host code in std's `platform/core/list.rs` since 2026-10-04.)

/// [rs-elem-mut] Two `&mut` elements of one `Vec` at once — the rendering
/// of a call taking two mutable element handles the checker proved apart
/// (`Distinct`, [elem-distinct]): one `split_at_mut` at the higher index,
/// one element out of each half. `i != j` is checker-guaranteed; `None`
/// when either index is out of range, so the caller's `.expect` carries
/// the same message and timing as a single handle's `!`.
pub fn salvo_pair_mut<T>(xs: &mut [T], i: usize, j: usize) -> Option<(&mut T, &mut T)> {
    if i == j || i >= xs.len() || j >= xs.len() {
        return None;
    }
    if i < j {
        let (lo, hi) = xs.split_at_mut(j);
        Some((&mut lo[i], &mut hi[0]))
    } else {
        let (lo, hi) = xs.split_at_mut(i);
        Some((&mut hi[0], &mut lo[j]))
    }
}

// ===== collections.rs =====
// Generated by the Salvo compiler: insertion-ordered collections.
//
// Salvo's `Map<K, V>` and `Set<T>` iterate in **insertion order** on every
// backend [col-insertion-order]. Kotlin gets that from `LinkedHashMap` /
// `LinkedHashSet`; Rust's own `HashMap`/`HashSet` do not provide it (their
// order is unspecified and randomly seeded per process), and the standard
// library has no ordered hash map, so this file is the equivalent. The
// observable semantics are LinkedHashMap's, exactly:
//
//   * iteration yields entries in first-insertion order;
//   * overwriting an existing key updates the value and **keeps** the
//     key's original position;
//   * removal is O(1) and preserves the order of everything else;
//   * equality is order-insensitive content equality, like
//     `AbstractMap.equals` on the JVM.
//
// Representation: entries live in a `Vec` in insertion order, and a
// `HashMap` indexes key -> slot. A removed slot becomes `None` so the
// stored indices stay valid, and the slab is compacted once the dead slots
// outnumber the live ones — which keeps removal amortized O(1) without
// letting an add/remove loop grow the vector without bound.
//
// **Where the bounds sit matters.** The struct definitions carry none, and
// each operation carries only what it needs: hashing a key needs
// `Hash + Eq + Clone`, but *walking* a collection does not. That is what
// lets a generic Salvo function (`fn iter<T>(set: Set<T>)`, whose emitted
// signature has only the bounds Salvo knows about) iterate a `Set<T>` at
// all — a bound on the struct would have to be repeated by every generated
// signature that so much as mentions the type.

use std::cmp::Ordering;
use std::collections::{BTreeMap, BTreeSet, HashMap};
use std::fmt;
use std::hash::Hash;
use std::marker::PhantomData;
use std::sync::Arc;

// ===== the hash and equality a keyed container is kept by [cmp-carry] =====

/// One Salvo `hash`, as a **type**, exactly as `SalvoCmp` is one ordering: the
/// compiler emits a zero-sized marker per bound identity and implements this for
/// it, so hashing is a direct call and no key pays to store a function.
pub trait SalvoHash<T> {
    fn hash(value: &T) -> i64;
}

/// …and one `eq`. A hash container buckets by `hash` and confirms the bucket hit
/// by `eq`, which is why the two travel together [col-membership].
pub trait SalvoEq<T> {
    fn eq(a: &T, b: &T) -> bool;
}

/// The **canonical** pair: the host's own hashing and equality, which is what
/// every keyed container used before a hash could be named — and for a generated
/// `auto fn hash`/`auto fn eq` it is the same function [cmp-auto].
pub struct HostHash;

impl<T: Hash> SalvoHash<T> for HostHash {
    fn hash(value: &T) -> i64 {
        let mut hasher = std::collections::hash_map::DefaultHasher::new();
        value.hash(&mut hasher);
        std::hash::Hasher::finish(&hasher) as i64
    }
}

pub struct HostEq;

impl<T: PartialEq> SalvoEq<T> for HostEq {
    fn eq(a: &T, b: &T) -> bool {
        a == b
    }
}

/// A key wearing a hash and an equality. `#[repr(transparent)]` for the same
/// reason `OrdBy` is: it lets a borrowed key be *viewed* as a borrowed wrapper,
/// so a lookup costs no clone.
#[repr(transparent)]
struct HashBy<H, E, T>(T, PhantomData<(H, E)>);

impl<H, E, T> HashBy<H, E, T> {
    fn wrap(value: T) -> Self {
        HashBy(value, PhantomData)
    }

    /// A borrowed key as a borrowed wrapper.
    fn probe(value: &T) -> &Self {
        // SAFETY: `HashBy` is `#[repr(transparent)]` over `T` — the
        // `PhantomData` is zero-sized, so `T` is its only non-zero-sized field.
        // The language therefore guarantees identical size, alignment and
        // validity, so the memory behind a live `&T` is a valid
        // `HashBy<H, E, T>`; the result borrows it for the same lifetime, and
        // both references are shared. As with `OrdBy`, there is deliberately no
        // mutable form: writing through one could break the index's invariant.
        unsafe { &*(value as *const T as *const HashBy<H, E, T>) }
    }
}

impl<H: SalvoHash<T>, E, T> Hash for HashBy<H, E, T> {
    fn hash<S: std::hash::Hasher>(&self, state: &mut S) {
        state.write_i64(H::hash(&self.0));
    }
}

impl<H, E: SalvoEq<T>, T> PartialEq for HashBy<H, E, T> {
    fn eq(&self, other: &Self) -> bool {
        E::eq(&self.0, &other.0)
    }
}

impl<H, E: SalvoEq<T>, T> Eq for HashBy<H, E, T> {}

// ===== the store, generic over the pair =====

/// The insertion-ordered map behind `SalvoMap`, with the hash and equality its
/// keys are kept by erased at this boundary — so `SalvoMap<K, V>` is one Rust
/// type however its keys are hashed, and a Salvo fn over a map is emitted with no
/// parameter and no bound for the difference.
trait MapStore<K, V> {
    fn get(&self, key: &K) -> Option<&V>;
    fn get_mut(&mut self, key: &K) -> Option<&mut V>;
    fn insert(&mut self, key: K, value: V);
    fn replace(&mut self, key: K, value: V) -> Option<V>;
    fn remove(&mut self, key: &K) -> Option<V>;
    fn contains_key(&self, key: &K) -> bool;
    fn len(&self) -> usize;
    /// The slab, in insertion order: what iteration walks. Exposing it keeps
    /// `SalvoMap::iter` an ordinary iterator rather than a boxed one.
    fn slots(&self) -> &[Option<(K, V)>];
    fn take_values(&mut self) -> Vec<V>;
    fn clone_box(&self) -> Box<dyn MapStore<K, V> + Send>;
}

struct HashedStore<H, E, K, V> {
    slots: Vec<Option<(K, V)>>,
    index: HashMap<HashBy<H, E, K>, usize>,
}

impl<H, E, K, V> HashedStore<H, E, K, V> {
    fn new() -> Self {
        HashedStore {
            slots: Vec::new(),
            index: HashMap::new(),
        }
    }
}

impl<H, E, K, V> MapStore<K, V> for HashedStore<H, E, K, V>
where
    H: SalvoHash<K> + Send + 'static,
    E: SalvoEq<K> + Send + 'static,
    K: Clone + Send + 'static,
    V: Clone + Send + 'static,
{
    fn get(&self, key: &K) -> Option<&V> {
        let i = *self.index.get(HashBy::<H, E, K>::probe(key))?;
        self.slots[i].as_ref().map(|(_, v)| v)
    }

    fn get_mut(&mut self, key: &K) -> Option<&mut V> {
        let i = *self.index.get(HashBy::<H, E, K>::probe(key))?;
        self.slots[i].as_mut().map(|(_, v)| v)
    }

    fn insert(&mut self, key: K, value: V) {
        match self.index.get(HashBy::<H, E, K>::probe(&key)) {
            Some(&i) => self.slots[i] = Some((key, value)),
            None => {
                self.slots.push(Some((key.clone(), value)));
                self.index.insert(HashBy::wrap(key), self.slots.len() - 1);
            }
        }
    }

    fn replace(&mut self, key: K, value: V) -> Option<V> {
        match self.index.get(HashBy::<H, E, K>::probe(&key)) {
            Some(&i) => self.slots[i].replace((key, value)).map(|(_, v)| v),
            None => {
                self.slots.push(Some((key.clone(), value)));
                self.index.insert(HashBy::wrap(key), self.slots.len() - 1);
                None
            }
        }
    }

    fn remove(&mut self, key: &K) -> Option<V> {
        let i = self.index.remove(HashBy::<H, E, K>::probe(key))?;
        let taken = self.slots[i].take().map(|(_, v)| v);
        self.compact_if_sparse();
        taken
    }

    fn contains_key(&self, key: &K) -> bool {
        self.index.contains_key(HashBy::<H, E, K>::probe(key))
    }

    fn len(&self) -> usize {
        self.index.len()
    }

    fn slots(&self) -> &[Option<(K, V)>] {
        &self.slots
    }

    fn take_values(&mut self) -> Vec<V> {
        self.index.clear();
        std::mem::take(&mut self.slots)
            .into_iter()
            .flatten()
            .map(|(_, v)| v)
            .collect()
    }

    fn clone_box(&self) -> Box<dyn MapStore<K, V> + Send> {
        let mut store = HashedStore::<H, E, K, V>::new();
        store.slots = self.slots.clone();
        for (i, slot) in store.slots.iter().enumerate() {
            if let Some((k, _)) = slot {
                store.index.insert(HashBy::wrap(k.clone()), i);
            }
        }
        Box::new(store)
    }
}

impl<H, E, K, V> HashedStore<H, E, K, V>
where
    H: SalvoHash<K>,
    E: SalvoEq<K>,
    K: Clone,
{
    fn compact_if_sparse(&mut self) {
        let live = self.index.len();
        if self.slots.len() <= 2 * live + 8 {
            return;
        }
        self.slots.retain(|s| s.is_some());
        self.index.clear();
        for (i, slot) in self.slots.iter().enumerate() {
            if let Some((k, _)) = slot {
                self.index.insert(HashBy::wrap(k.clone()), i);
            }
        }
    }
}

/// [cmp-carry] A store whose identity is a **pair of functions** rather than a
/// pair of marker types, for a keyed container built inside a *generic*
/// function: there the identity is a capability the function was handed, so
/// there is no type to name it by (added 2026-09-26).
///
/// Its representation matches the Kotlin runtime's `SalvoHashMap`, which has
/// always held closures: entries live in a slab in first-insertion order and a
/// bucket index maps a Salvo hash to the slots holding it, confirming a bucket
/// hit with `eq`. That is also why it cannot reuse `HashedStore` — `HashBy`'s
/// `Hash`/`Eq` impls dispatch through *types*, and a closure held elsewhere is
/// not reachable from them.
///
/// `Arc` rather than `Box` so `clone_box` can share the identity: two clones of
/// a map are keyed the same way by construction.
struct FnStore<K, V> {
    slots: Vec<Option<(K, V)>>,
    buckets: HashMap<i64, Vec<usize>>,
    hash: Arc<dyn Fn(&K) -> i64 + Send + Sync>,
    eq: Arc<dyn Fn(&K, &K) -> bool + Send + Sync>,
    live: usize,
}

impl<K, V> FnStore<K, V> {
    fn new(
        hash: Arc<dyn Fn(&K) -> i64 + Send + Sync>,
        eq: Arc<dyn Fn(&K, &K) -> bool + Send + Sync>,
    ) -> Self {
        FnStore {
            slots: Vec::new(),
            buckets: HashMap::new(),
            hash,
            eq,
            live: 0,
        }
    }

    /// The slot holding a key equal to `key`, if any.
    fn slot_of(&self, key: &K) -> Option<usize> {
        let bucket = self.buckets.get(&(self.hash)(key))?;
        bucket.iter().copied().find(|&i| {
            self.slots[i]
                .as_ref()
                .is_some_and(|(k, _)| (self.eq)(k, key))
        })
    }

    fn compact_if_sparse(&mut self) {
        if self.slots.len() <= 2 * self.live + 8 {
            return;
        }
        self.slots.retain(|s| s.is_some());
        self.buckets.clear();
        for i in 0..self.slots.len() {
            if let Some((k, _)) = &self.slots[i] {
                let h = (self.hash)(k);
                self.buckets.entry(h).or_default().push(i);
            }
        }
    }
}

impl<K: Clone + Send + 'static, V: Clone + Send + 'static> MapStore<K, V> for FnStore<K, V> {
    fn get(&self, key: &K) -> Option<&V> {
        let i = self.slot_of(key)?;
        self.slots[i].as_ref().map(|(_, v)| v)
    }

    fn get_mut(&mut self, key: &K) -> Option<&mut V> {
        let i = self.slot_of(key)?;
        self.slots[i].as_mut().map(|(_, v)| v)
    }

    fn insert(&mut self, key: K, value: V) {
        match self.slot_of(&key) {
            // An overwrite keeps the key's position [col-insertion-order].
            Some(i) => self.slots[i] = Some((key, value)),
            None => {
                let h = (self.hash)(&key);
                self.slots.push(Some((key, value)));
                self.buckets.entry(h).or_default().push(self.slots.len() - 1);
                self.live += 1;
            }
        }
    }

    fn replace(&mut self, key: K, value: V) -> Option<V> {
        match self.slot_of(&key) {
            Some(i) => self.slots[i].replace((key, value)).map(|(_, v)| v),
            None => {
                self.insert(key, value);
                None
            }
        }
    }

    fn remove(&mut self, key: &K) -> Option<V> {
        let i = self.slot_of(key)?;
        let h = (self.hash)(key);
        if let Some(bucket) = self.buckets.get_mut(&h) {
            bucket.retain(|&j| j != i);
            if bucket.is_empty() {
                self.buckets.remove(&h);
            }
        }
        let taken = self.slots[i].take().map(|(_, v)| v);
        self.live -= 1;
        self.compact_if_sparse();
        taken
    }

    fn contains_key(&self, key: &K) -> bool {
        self.slot_of(key).is_some()
    }

    fn len(&self) -> usize {
        self.live
    }

    fn slots(&self) -> &[Option<(K, V)>] {
        &self.slots
    }

    fn take_values(&mut self) -> Vec<V> {
        self.buckets.clear();
        self.live = 0;
        self.slots
            .drain(..)
            .flatten()
            .map(|(_, v)| v)
            .collect()
    }

    fn clone_box(&self) -> Box<dyn MapStore<K, V> + Send> {
        Box::new(FnStore {
            slots: self.slots.clone(),
            buckets: self.buckets.clone(),
            hash: Arc::clone(&self.hash),
            eq: Arc::clone(&self.eq),
            live: self.live,
        })
    }
}

pub struct SalvoMap<K, V> {
    // `+ Send` on the box rather than on the trait: a map is sendable when its
    // keys and values are, and stating it here keeps every operation bound-free —
    // so a Salvo fn over a map is emitted with no bounds of its own.
    store: Box<dyn MapStore<K, V> + Send>,
}

// Building one names the hash and the equality its keys are kept by, which is the
// only place the markers appear.
impl<K: Clone + Send + 'static, V: Clone + Send + 'static> SalvoMap<K, V> {
    pub fn new<H, E>() -> Self
    where
        H: SalvoHash<K> + Send + 'static,
        E: SalvoEq<K> + Send + 'static,
    {
        SalvoMap {
            store: Box::new(HashedStore::<H, E, K, V>::new()),
        }
    }

    /// [cmp-carry] The same map, keyed by a **pair of functions**: what a
    /// keyed container built inside a generic function is given, where the
    /// identity is a capability rather than a name (2026-09-26).
    pub fn with_fns(
        hash: Arc<dyn Fn(&K) -> i64 + Send + Sync>,
        eq: Arc<dyn Fn(&K, &K) -> bool + Send + Sync>,
    ) -> Self {
        SalvoMap {
            store: Box::new(FnStore::new(hash, eq)),
        }
    }

    /// The constructor lowering's entry point: `map_of(("a", 1), ...)`.
    /// A repeated key keeps the position of its first appearance and takes
    /// the value of its last [col-duplicate-keys].
    pub fn from_entries<H, E, I>(entries: I) -> Self
    where
        H: SalvoHash<K> + Send + 'static,
        E: SalvoEq<K> + Send + 'static,
        I: IntoIterator<Item = (K, V)>,
    {
        let mut map = SalvoMap::new::<H, E>();
        for (k, v) in entries {
            map.insert(k, v);
        }
        map
    }
}

// Using one needs nothing of `K` or `V`: every operation goes through the store.
impl<K, V> SalvoMap<K, V> {
    pub fn len(&self) -> usize {
        self.store.len()
    }

    pub fn is_empty(&self) -> bool {
        self.len() == 0
    }

    /// Entries in insertion order.
    pub fn iter(&self) -> impl Iterator<Item = (&K, &V)> + '_ {
        self.store
            .slots()
            .iter()
            .filter_map(|s| s.as_ref().map(|(k, v)| (k, v)))
    }

    pub fn keys(&self) -> impl Iterator<Item = &K> + '_ {
        self.iter().map(|(k, _)| k)
    }

    pub fn values(&self) -> impl Iterator<Item = &V> + '_ {
        self.iter().map(|(_, v)| v)
    }

    /// Inserts or overwrites. An overwrite keeps the key's original
    /// position, so iteration order is stable under updates.
    pub fn insert(&mut self, key: K, value: V) {
        self.store.insert(key, value)
    }

    pub fn get(&self, key: &K) -> Option<&V> {
        self.store.get(key)
    }

    pub fn get_mut(&mut self, key: &K) -> Option<&mut V> {
        self.store.get_mut(key)
    }

    /// Removes the entry and hands its value back — the shape Salvo's
    /// `remove(map, key) -> V?` needs, so a caller can take ownership of
    /// what the map was holding.
    pub fn remove(&mut self, key: &K) -> Option<V> {
        self.store.remove(key)
    }

    /// [linear-container] Inserts and answers what it **displaced** — the
    /// shape `replace(map, key, value) -> V?` needs, and the only write a map
    /// of obligations can have: an overwrite that dropped the old value would
    /// be a silent discard. Like `insert`, an existing key keeps its position.
    pub fn replace(&mut self, key: K, value: V) -> Option<V> {
        self.store.replace(key, value)
    }

    /// [linear-container] Consumes the map and answers its values in
    /// insertion order — what `drain(map, each)` hands to its callback, one
    /// at a time.
    pub fn into_values(mut self) -> Vec<V> {
        self.store.take_values()
    }

    pub fn contains_key(&self, key: &K) -> bool {
        self.store.contains_key(key)
    }
}

// Through the store, so no key is rehashed and no bound is needed here.
impl<K, V> Clone for SalvoMap<K, V> {
    fn clone(&self) -> Self {
        SalvoMap {
            store: self.store.clone_box(),
        }
    }
}

/// Order-insensitive, matching the JVM's `AbstractMap.equals` so `==` on a
/// map means the same thing on both backends [col-equality].
impl<K, V: PartialEq> PartialEq for SalvoMap<K, V> {
    fn eq(&self, other: &Self) -> bool {
        self.len() == other.len() && self.iter().all(|(k, v)| other.get(k) == Some(v))
    }
}

impl<K, V: Eq> Eq for SalvoMap<K, V> {}

/// `{a: 1, b: 2}` — the language's format, in insertion order, matching
/// the map literal that would build it [col-to-str]. Walking only, so no
/// hashing bound.
impl<K: fmt::Display, V: fmt::Display> fmt::Display for SalvoMap<K, V> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{{")?;
        for (i, (k, v)) in self.iter().enumerate() {
            if i > 0 {
                write!(f, ", ")?;
            }
            write!(f, "{}: {}", k, v)?;
        }
        write!(f, "}}")
    }
}

// A struct derives `Debug`, so a struct holding a map needs this. Nothing
// renders a Salvo value through `Debug` any more — interpolation goes through
// `to_str` [interp-to-str] — so the bound is `Debug`, not the `Display` it was
// while `{:?}` rendered structs: that bound made every struct with a
// `Map<Str, SomeStruct>` field a rustc error (found 2026-09-29, the aws
// generator's `message_attributes`).
impl<K: fmt::Debug, V: fmt::Debug> fmt::Debug for SalvoMap<K, V> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_map().entries(self.iter()).finish()
    }
}

pub struct SalvoSet<T> {
    // A set is a map to nothing: one representation, so the two cannot
    // drift apart on ordering or removal semantics.
    entries: SalvoMap<T, ()>,
}

// Building one names the pair its elements are kept by.
impl<T: Clone + Send + 'static> SalvoSet<T> {
    pub fn new<H, E>() -> Self
    where
        H: SalvoHash<T> + Send + 'static,
        E: SalvoEq<T> + Send + 'static,
    {
        SalvoSet {
            entries: SalvoMap::new::<H, E>(),
        }
    }

    /// [cmp-carry] Keyed by a pair of functions, for a generic body.
    pub fn with_fns(
        hash: Arc<dyn Fn(&T) -> i64 + Send + Sync>,
        eq: Arc<dyn Fn(&T, &T) -> bool + Send + Sync>,
    ) -> Self {
        SalvoSet {
            entries: SalvoMap::with_fns(hash, eq),
        }
    }

    pub fn from_elements<H, E, I>(elems: I) -> Self
    where
        H: SalvoHash<T> + Send + 'static,
        E: SalvoEq<T> + Send + 'static,
        I: IntoIterator<Item = T>,
    {
        let mut set = SalvoSet::new::<H, E>();
        for e in elems {
            set.insert(e);
        }
        set
    }
}

// Using one needs nothing of `T`.
impl<T> SalvoSet<T> {
    pub fn len(&self) -> usize {
        self.entries.len()
    }

    pub fn is_empty(&self) -> bool {
        self.entries.is_empty()
    }

    /// Elements in insertion order.
    pub fn iter(&self) -> impl Iterator<Item = &T> + '_ {
        self.entries.keys()
    }

    /// `true` when the element was newly added, which is what Salvo's
    /// `add(set, elem) -> Bool` reports.
    pub fn insert(&mut self, elem: T) -> bool {
        if self.entries.contains_key(&elem) {
            return false;
        }
        self.entries.insert(elem, ());
        true
    }

    /// `true` when the element was present.
    pub fn remove(&mut self, elem: &T) -> bool {
        self.entries.remove(elem).is_some()
    }

    pub fn contains(&self, elem: &T) -> bool {
        self.entries.contains_key(elem)
    }
}

impl<T> Clone for SalvoSet<T> {
    fn clone(&self) -> Self {
        SalvoSet {
            entries: self.entries.clone(),
        }
    }
}

/// Order-insensitive, like the JVM's `AbstractSet.equals`.
impl<T> PartialEq for SalvoSet<T> {
    fn eq(&self, other: &Self) -> bool {
        self.len() == other.len() && self.iter().all(|e| other.contains(e))
    }
}

impl<T> Eq for SalvoSet<T> {}

/// `{1, 2, 3}` — the set literal that would build it.
impl<T: fmt::Display> fmt::Display for SalvoSet<T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{{")?;
        for (i, e) in self.iter().enumerate() {
            if i > 0 {
                write!(f, ", ")?;
            }
            write!(f, "{}", e)?;
        }
        write!(f, "}}")
    }
}

impl<T: fmt::Debug> fmt::Debug for SalvoSet<T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_set().entries(self.entries.keys()).finish()
    }
}

// ===== the sorted collections, and the ordering they are kept by =====
//
// [cmp-carry] [col-membership] A `SortedSet<T>(?cmp)` / `SortedMap<K, V>(?cmp)`
// is kept by the ordering its type names, and its members are **`cmp`-distinct**:
// two elements are one member when `cmp(a, b) == 0`. That is what both hosts do
// natively — `BTreeSet` decides duplicates by `Ord` alone — so it is the rule
// the language states rather than one this file invents.
//
// The ordering is a **type**, not a value: the compiler emits a zero-sized
// marker per bound identity (`__Cmp_by_age`) and implements `SalvoCmp` for it,
// so comparisons are direct calls the optimizer can inline and no element pays
// to store a comparator. The marker then stops at the container's edge, behind a
// boxed store — which is why a Salvo fn generic over a sorted collection is
// emitted with no extra type parameter, and why swapping the store (a B-tree
// today) changes nothing outside this file.

// ===== the ordering as a type [cmp-carry] =====

/// One Salvo ordering, as a **type**: the compiler generates a zero-sized
/// marker per bound identity and implements this for it, so a comparison is a
/// direct call the optimizer can inline and no element pays for storing one.
pub trait SalvoCmp<T> {
    fn cmp(a: &T, b: &T) -> i32;
}

/// The **canonical** ordering, as a marker: the host's own `Ord`. A sorted
/// collection whose type names no ordering is kept by this one, which is what
/// every such collection was kept by before orderings could be named — and for a
/// generated `auto fn cmp` it *is* the same function, since that member lowers to
/// the host's derived comparison [cmp-auto].
pub struct HostOrd;

impl<T: Ord> SalvoCmp<T> for HostOrd {
    fn cmp(a: &T, b: &T) -> i32 {
        match Ord::cmp(a, b) {
            Ordering::Less => -1,
            Ordering::Equal => 0,
            Ordering::Greater => 1,
        }
    }
}

/// An element wearing an ordering. `#[repr(transparent)]` is load-bearing:
/// with exactly one non-zero-sized field this type has `T`'s size, alignment
/// and validity, which is what lets `probe` view a borrowed `T` as a borrowed
/// wrapper without copying it.
#[repr(transparent)]
pub struct OrdBy<C, T>(T, PhantomData<C>);

impl<C, T> OrdBy<C, T> {
    fn wrap(value: T) -> Self {
        OrdBy(value, PhantomData)
    }

    fn get(&self) -> &T {
        &self.0
    }

    /// A borrowed element as a borrowed wrapper, for probing a tree without
    /// building an owned wrapper (which would mean cloning the element).
    fn probe(value: &T) -> &Self {
        // SAFETY: `OrdBy` is `#[repr(transparent)]` over `T` — `PhantomData<C>`
        // is zero-sized, so `T` is the only non-zero-sized field. The language
        // therefore guarantees this type has `T`'s size, alignment and validity
        // invariant, so the memory behind a live `&T` is a valid `OrdBy<C, T>`.
        // The returned reference borrows that same memory for the same lifetime
        // (tied by the signature), and both references are shared, so no
        // `&mut` aliasing is created. There is deliberately no `probe_mut`:
        // writing through such a reference could break the tree's ordering.
        unsafe { &*(value as *const T as *const OrdBy<C, T>) }
    }
}

impl<C: SalvoCmp<T>, T> PartialEq for OrdBy<C, T> {
    fn eq(&self, other: &Self) -> bool {
        C::cmp(&self.0, &other.0) == 0
    }
}

impl<C: SalvoCmp<T>, T> Eq for OrdBy<C, T> {}

impl<C: SalvoCmp<T>, T> PartialOrd for OrdBy<C, T> {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        Some(Ord::cmp(self, other))
    }
}

impl<C: SalvoCmp<T>, T> Ord for OrdBy<C, T> {
    fn cmp(&self, other: &Self) -> Ordering {
        C::cmp(&self.0, &other.0).cmp(&0)
    }
}

// ===== the store, generic over the ordering =====

trait SortedStore<T> {
    fn insert(&mut self, value: T) -> bool;
    fn remove(&mut self, value: &T) -> bool;
    fn contains(&self, value: &T) -> bool;
    fn len(&self) -> usize;
    fn min(&self) -> Option<&T>;
    fn max(&self) -> Option<&T>;
    fn to_vec(&self) -> Vec<T>;
    /// [platform-iterable] The elements in order, borrowed.
    fn iter(&self) -> Box<dyn Iterator<Item = &T> + '_>;
    fn clone_box(&self) -> Box<dyn SortedStore<T> + Send>;
}

struct BTreeStore<C, T> {
    inner: BTreeSet<OrdBy<C, T>>,
}

impl<C, T> BTreeStore<C, T> {
    fn new() -> Self {
        BTreeStore {
            inner: BTreeSet::new(),
        }
    }
}

impl<C, T> SortedStore<T> for BTreeStore<C, T>
where
    C: SalvoCmp<T> + Send + 'static,
    T: Clone + Send + 'static,
{
    fn insert(&mut self, value: T) -> bool {
        self.inner.insert(OrdBy::wrap(value))
    }

    fn remove(&mut self, value: &T) -> bool {
        self.inner.remove(OrdBy::<C, T>::probe(value))
    }

    fn contains(&self, value: &T) -> bool {
        self.inner.contains(OrdBy::<C, T>::probe(value))
    }

    fn len(&self) -> usize {
        self.inner.len()
    }

    fn min(&self) -> Option<&T> {
        self.inner.iter().next().map(OrdBy::get)
    }

    fn max(&self) -> Option<&T> {
        self.inner.iter().next_back().map(OrdBy::get)
    }

    fn to_vec(&self) -> Vec<T> {
        self.inner.iter().map(|w| w.get().clone()).collect()
    }

    fn iter(&self) -> Box<dyn Iterator<Item = &T> + '_> {
        Box::new(self.inner.iter().map(|w| w.get()))
    }

    fn clone_box(&self) -> Box<dyn SortedStore<T> + Send> {
        Box::new(BTreeStore::<C, T> {
            inner: self
                .inner
                .iter()
                .map(|w| OrdBy::wrap(w.get().clone()))
                .collect(),
        })
    }
}

/// [cmp-carry] The sorted store whose ordering is a **function** rather than a
/// marker type — the sorted half of `FnStore`, for a container built inside a
/// generic function (added 2026-09-26). A sorted `Vec` with binary search by the
/// held comparator: `BTreeSet` cannot serve, because `OrdBy`'s `Ord` dispatches
/// through a *type*.
struct FnSortedStore<T> {
    items: Vec<T>,
    cmp: Arc<dyn Fn(&T, &T) -> i32 + Send + Sync>,
}

impl<T> FnSortedStore<T> {
    fn new(cmp: Arc<dyn Fn(&T, &T) -> i32 + Send + Sync>) -> Self {
        FnSortedStore {
            items: Vec::new(),
            cmp,
        }
    }

    /// `Ok(i)` when an element comparing equal sits at `i`, `Err(i)` where one
    /// would be inserted — `slice::binary_search_by` against the held ordering.
    fn find(&self, value: &T) -> Result<usize, usize> {
        self.items.binary_search_by(|probe| match (self.cmp)(probe, value) {
            n if n < 0 => Ordering::Less,
            0 => Ordering::Equal,
            _ => Ordering::Greater,
        })
    }
}

impl<T: Clone + Send + 'static> SortedStore<T> for FnSortedStore<T> {
    fn insert(&mut self, value: T) -> bool {
        match self.find(&value) {
            // A set: an element comparing equal is already there
            // [col-membership].
            Ok(_) => false,
            Err(at) => {
                self.items.insert(at, value);
                true
            }
        }
    }

    fn remove(&mut self, value: &T) -> bool {
        match self.find(value) {
            Ok(at) => {
                self.items.remove(at);
                true
            }
            Err(_) => false,
        }
    }

    fn contains(&self, value: &T) -> bool {
        self.find(value).is_ok()
    }

    fn len(&self) -> usize {
        self.items.len()
    }

    fn min(&self) -> Option<&T> {
        self.items.first()
    }

    fn max(&self) -> Option<&T> {
        self.items.last()
    }

    fn to_vec(&self) -> Vec<T> {
        self.items.clone()
    }

    fn iter(&self) -> Box<dyn Iterator<Item = &T> + '_> {
        Box::new(self.items.iter())
    }

    fn clone_box(&self) -> Box<dyn SortedStore<T> + Send> {
        Box::new(FnSortedStore {
            items: self.items.clone(),
            cmp: Arc::clone(&self.cmp),
        })
    }
}

// ===== the container the emitted code sees =====

pub struct SalvoSortedSet<T> {
    // `+ Send` on the *box* rather than on the trait: a container is sendable
    // when its elements are, and stating it here keeps the bound off every
    // method — so a Salvo fn over a sorted collection is emitted with no bounds
    // of its own, which is the whole point of hiding the marker.
    store: Box<dyn SortedStore<T> + Send>,
}

// Building one names the ordering, which is the only place the marker — and the
// bounds the boxed store needs — appear.
impl<T: Clone + Send + 'static> SalvoSortedSet<T> {
    pub fn new<C: SalvoCmp<T> + Send + 'static>() -> Self {
        SalvoSortedSet {
            store: Box::new(BTreeStore::<C, T>::new()),
        }
    }

    /// [cmp-carry] Ordered by a **function**, for a generic body.
    pub fn with_cmp(cmp: Arc<dyn Fn(&T, &T) -> i32 + Send + Sync>) -> Self {
        SalvoSortedSet {
            store: Box::new(FnSortedStore::new(cmp)),
        }
    }

    pub fn from_elements<C: SalvoCmp<T> + Send + 'static, I: IntoIterator<Item = T>>(
        elems: I,
    ) -> Self {
        let mut set = SalvoSortedSet::new::<C>();
        for e in elems {
            set.insert(e);
        }
        set
    }
}

// Using one needs nothing of `T`: every operation goes through the store.
impl<T> SalvoSortedSet<T> {
    pub fn insert(&mut self, value: T) -> bool {
        self.store.insert(value)
    }
    pub fn remove(&mut self, value: &T) -> bool {
        self.store.remove(value)
    }
    pub fn contains(&self, value: &T) -> bool {
        self.store.contains(value)
    }
    pub fn len(&self) -> usize {
        self.store.len()
    }
    pub fn min(&self) -> Option<&T> {
        self.store.min()
    }
    pub fn max(&self) -> Option<&T> {
        self.store.max()
    }
    pub fn to_vec(&self) -> Vec<T> {
        self.store.to_vec()
    }
    /// [platform-iterable] The elements in order, borrowed.
    pub fn iter(&self) -> impl Iterator<Item = &T> + '_ {
        self.store.iter()
    }
}

// [platform-value-type] Compared and printed element-wise, in order, as a
// struct holding one needs.
impl<T: PartialEq> PartialEq for SalvoSortedSet<T> {
    fn eq(&self, other: &Self) -> bool {
        self.iter().eq(other.iter())
    }
}
impl<T: Eq> Eq for SalvoSortedSet<T> {}
impl<T: fmt::Debug> fmt::Debug for SalvoSortedSet<T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_set().entries(self.iter()).finish()
    }
}

impl<T> Clone for SalvoSortedSet<T> {
    fn clone(&self) -> Self {
        SalvoSortedSet {
            store: self.store.clone_box(),
        }
    }
}

impl<T: fmt::Display> fmt::Display for SalvoSortedSet<T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        let items: Vec<String> = self.to_vec().iter().map(|e| e.to_string()).collect();
        write!(f, "{{{}}}", items.join(", "))
    }
}

// ===== the sorted map, the same way =====

trait SortedMapStore<K, V> {
    fn get(&self, key: &K) -> Option<&V>;
    fn insert(&mut self, key: K, value: V) -> Option<V>;
    fn remove(&mut self, key: &K) -> Option<V>;
    fn contains_key(&self, key: &K) -> bool;
    fn len(&self) -> usize;
    fn first_key(&self) -> Option<&K>;
    fn last_key(&self) -> Option<&K>;
    fn keys(&self) -> Vec<K>;
    fn entries(&self) -> Vec<(K, V)>;
    /// [platform-iterable] The entries in key order, borrowed.
    fn iter(&self) -> Box<dyn Iterator<Item = (&K, &V)> + '_>;
    fn clone_box(&self) -> Box<dyn SortedMapStore<K, V> + Send>;
}

/// [cmp-carry] The sorted *map* store ordered by a **function**, completing the
/// set of four (added 2026-09-26). A sorted `Vec` of entries, searched by the
/// held comparator, for the same reason `FnSortedStore` is one.
struct FnSortedMapStore<K, V> {
    entries: Vec<(K, V)>,
    cmp: Arc<dyn Fn(&K, &K) -> i32 + Send + Sync>,
}

impl<K, V> FnSortedMapStore<K, V> {
    fn find(&self, key: &K) -> Result<usize, usize> {
        self.entries
            .binary_search_by(|(probe, _)| match (self.cmp)(probe, key) {
                n if n < 0 => Ordering::Less,
                0 => Ordering::Equal,
                _ => Ordering::Greater,
            })
    }
}

impl<K: Clone + Send + 'static, V: Clone + Send + 'static> SortedMapStore<K, V>
    for FnSortedMapStore<K, V>
{
    fn get(&self, key: &K) -> Option<&V> {
        self.find(key).ok().map(|at| &self.entries[at].1)
    }

    fn insert(&mut self, key: K, value: V) -> Option<V> {
        match self.find(&key) {
            Ok(at) => Some(std::mem::replace(&mut self.entries[at], (key, value)).1),
            Err(at) => {
                self.entries.insert(at, (key, value));
                None
            }
        }
    }

    fn remove(&mut self, key: &K) -> Option<V> {
        match self.find(key) {
            Ok(at) => Some(self.entries.remove(at).1),
            Err(_) => None,
        }
    }

    fn contains_key(&self, key: &K) -> bool {
        self.find(key).is_ok()
    }

    fn len(&self) -> usize {
        self.entries.len()
    }

    fn first_key(&self) -> Option<&K> {
        self.entries.first().map(|(k, _)| k)
    }

    fn last_key(&self) -> Option<&K> {
        self.entries.last().map(|(k, _)| k)
    }

    fn keys(&self) -> Vec<K> {
        self.entries.iter().map(|(k, _)| k.clone()).collect()
    }

    fn entries(&self) -> Vec<(K, V)> {
        self.entries.clone()
    }

    fn iter(&self) -> Box<dyn Iterator<Item = (&K, &V)> + '_> {
        Box::new(self.entries.iter().map(|(k, v)| (k, v)))
    }

    fn clone_box(&self) -> Box<dyn SortedMapStore<K, V> + Send> {
        Box::new(FnSortedMapStore {
            entries: self.entries.clone(),
            cmp: Arc::clone(&self.cmp),
        })
    }
}

struct BTreeMapStore<C, K, V> {
    inner: BTreeMap<OrdBy<C, K>, V>,
}

impl<C, K, V> SortedMapStore<K, V> for BTreeMapStore<C, K, V>
where
    C: SalvoCmp<K> + Send + 'static,
    K: Clone + Send + 'static,
    V: Clone + Send + 'static,
{
    fn get(&self, key: &K) -> Option<&V> {
        self.inner.get(OrdBy::<C, K>::probe(key))
    }
    fn insert(&mut self, key: K, value: V) -> Option<V> {
        self.inner.insert(OrdBy::wrap(key), value)
    }
    fn remove(&mut self, key: &K) -> Option<V> {
        self.inner.remove(OrdBy::<C, K>::probe(key))
    }
    fn contains_key(&self, key: &K) -> bool {
        self.inner.contains_key(OrdBy::<C, K>::probe(key))
    }
    fn len(&self) -> usize {
        self.inner.len()
    }
    fn first_key(&self) -> Option<&K> {
        self.inner.keys().next().map(OrdBy::get)
    }
    fn last_key(&self) -> Option<&K> {
        self.inner.keys().next_back().map(OrdBy::get)
    }
    fn keys(&self) -> Vec<K> {
        self.inner.keys().map(|k| k.get().clone()).collect()
    }
    fn entries(&self) -> Vec<(K, V)> {
        self.inner
            .iter()
            .map(|(k, v)| (k.get().clone(), v.clone()))
            .collect()
    }

    fn iter(&self) -> Box<dyn Iterator<Item = (&K, &V)> + '_> {
        Box::new(self.inner.iter().map(|(k, v)| (k.get(), v)))
    }
    fn clone_box(&self) -> Box<dyn SortedMapStore<K, V> + Send> {
        Box::new(BTreeMapStore::<C, K, V> {
            inner: self
                .inner
                .iter()
                .map(|(k, v)| (OrdBy::wrap(k.get().clone()), v.clone()))
                .collect(),
        })
    }
}

pub struct SalvoSortedMap<K, V> {
    store: Box<dyn SortedMapStore<K, V> + Send>,
}

impl<K: Clone + Send + 'static, V: Clone + Send + 'static> SalvoSortedMap<K, V> {
    pub fn new<C: SalvoCmp<K> + Send + 'static>() -> Self {
        SalvoSortedMap {
            store: Box::new(BTreeMapStore::<C, K, V> {
                inner: BTreeMap::new(),
            }),
        }
    }
    /// [cmp-carry] Ordered by a **function**, for a generic body.
    pub fn with_cmp(cmp: Arc<dyn Fn(&K, &K) -> i32 + Send + Sync>) -> Self {
        SalvoSortedMap {
            store: Box::new(FnSortedMapStore {
                entries: Vec::new(),
                cmp,
            }),
        }
    }

    pub fn from_entries<C: SalvoCmp<K> + Send + 'static, I: IntoIterator<Item = (K, V)>>(
        entries: I,
    ) -> Self {
        let mut map = SalvoSortedMap::new::<C>();
        for (k, v) in entries {
            map.insert(k, v);
        }
        map
    }
}

impl<K, V> SalvoSortedMap<K, V> {
    pub fn get(&self, key: &K) -> Option<&V> {
        self.store.get(key)
    }
    pub fn insert(&mut self, key: K, value: V) -> Option<V> {
        self.store.insert(key, value)
    }
    pub fn remove(&mut self, key: &K) -> Option<V> {
        self.store.remove(key)
    }
    pub fn contains_key(&self, key: &K) -> bool {
        self.store.contains_key(key)
    }
    pub fn len(&self) -> usize {
        self.store.len()
    }
    pub fn first_key(&self) -> Option<&K> {
        self.store.first_key()
    }
    pub fn last_key(&self) -> Option<&K> {
        self.store.last_key()
    }
    pub fn keys(&self) -> Vec<K> {
        self.store.keys()
    }
    pub fn entries(&self) -> Vec<(K, V)> {
        self.store.entries()
    }
    /// [platform-iterable] The entries in key order, borrowed.
    pub fn iter(&self) -> impl Iterator<Item = (&K, &V)> + '_ {
        self.store.iter()
    }
}

impl<K: PartialEq, V: PartialEq> PartialEq for SalvoSortedMap<K, V> {
    fn eq(&self, other: &Self) -> bool {
        self.iter().eq(other.iter())
    }
}
impl<K: Eq, V: Eq> Eq for SalvoSortedMap<K, V> {}
impl<K: fmt::Debug, V: fmt::Debug> fmt::Debug for SalvoSortedMap<K, V> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_map().entries(self.iter()).finish()
    }
}

impl<K, V> Clone for SalvoSortedMap<K, V> {
    fn clone(&self) -> Self {
        SalvoSortedMap {
            store: self.store.clone_box(),
        }
    }
}

impl<K: fmt::Display, V: fmt::Display> fmt::Display for SalvoSortedMap<K, V> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        let items: Vec<String> = self
            .entries()
            .iter()
            .map(|(k, v)| format!("{k}: {v}"))
            .collect();
        write!(f, "{{{}}}", items.join(", "))
    }
}

// [platform-check] [rs-platform-check] Collecting into a Salvo collection under
// the canonical identity — the host's own hash and equality, or its `Ord` —
// which is what host code builds a result with: `iter.collect::<SalvoSet<_>>()`
// (ABI D10 C1, C2). A collection keyed by a Salvo-defined identity is
// refused at the boundary, so these are the only ones a host builds.
impl<T: Clone + Send + 'static + std::hash::Hash + PartialEq> FromIterator<T> for SalvoSet<T> {
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> Self {
        SalvoSet::from_elements::<HostHash, HostEq, _>(iter)
    }
}

impl<K: Clone + Send + 'static + std::hash::Hash + PartialEq, V: Clone + Send + 'static> FromIterator<(K, V)>
    for SalvoMap<K, V>
{
    fn from_iter<I: IntoIterator<Item = (K, V)>>(iter: I) -> Self {
        SalvoMap::from_entries::<HostHash, HostEq, _>(iter)
    }
}

impl<T: Clone + Send + 'static + Ord> FromIterator<T> for SalvoSortedSet<T> {
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> Self {
        SalvoSortedSet::from_elements::<HostOrd, _>(iter)
    }
}

impl<K: Clone + Send + 'static + Ord, V: Clone + Send + 'static> FromIterator<(K, V)> for SalvoSortedMap<K, V> {
    fn from_iter<I: IntoIterator<Item = (K, V)>>(iter: I) -> Self {
        SalvoSortedMap::from_entries::<HostOrd, _>(iter)
    }
}

// ===== hosttime.rs =====
// Generated by the Salvo compiler: the two clock readings std's `time`
// module is built on [time-types] [rs-time].
//
// Both answer nanoseconds in an `i64`, which is what `Instant`, `Tick` and
// `Duration` carry — one field each, so the seam between the language and the
// host is a number and nothing else.

use std::sync::OnceLock;
use std::time::Instant;

/// [time-ticker] The monotonic clock, in nanoseconds from an arbitrary
/// origin — this process's first reading, established here.
///
/// The origin has to live somewhere: Rust's `Instant` is opaque and cannot be
/// turned into a number, so a *process-wide* base is what makes two readings
/// comparable. One `OnceLock` for the whole program is the point — a base per
/// call site would put two origins in one program and make `between` answer
/// nonsense.
///
/// Never negative, and monotonically non-decreasing: `Instant` guarantees it,
/// and `duration_since` on the process base cannot underflow.
pub fn salvo_mono_nanos() -> i64 {
    static ORIGIN: OnceLock<Instant> = OnceLock::new();
    let origin = ORIGIN.get_or_init(Instant::now);
    Instant::now().duration_since(*origin).as_nanos() as i64
}

// ===== platform/core/console.rs =====
// [platform-tree] std's console, for `core.console`'s
// `threadsafe platform handler StdOutConsole` (ROADMAP 0.5): standard output,
// with no buffering of its own, so a line printed before a trap is seen.

use std::io::Write;

pub struct StdOutConsole;

impl StdOutConsole {
    pub fn new() -> Self {
        StdOutConsole
    }
}

impl crate::core_console::ConsolePlatformSync for StdOutConsole {
    fn print(&self, message: &String) {
        let mut out = std::io::stdout().lock();
        let _ = out.write_all(message.as_bytes());
    }
}

// ===== platform/core/list.rs =====
// [platform-value-type] std's list, for `core.list`'s
// `platform type List<T> canbe Mut` (ROADMAP 0.7): a `Vec`. `Mut List` is the
// same type, passed as `&mut`.

pub type List<T> = Vec<T>;
pub type MutList<T> = Vec<T>;

// [platform-iterable] The host's loop over a list, by reference.
pub fn each<T>(list: &List<T>) -> std::slice::Iter<'_, T> {
    list.iter()
}

pub fn each_mut<T>(list: &mut List<T>) -> std::slice::IterMut<'_, T> {
    list.iter_mut()
}

pub fn into_each<T>(list: List<T>) -> std::vec::IntoIter<T> {
    list.into_iter()
}

pub fn get<T>(list: &List<T>, index: i32) -> Option<&T> {
    if index < 0 { None } else { list.get(index as usize) }
}

pub fn first<T>(list: &List<T>) -> Option<&T> {
    list.first()
}

pub fn size<T>(list: &List<T>) -> i32 {
    list.len() as i32
}

pub fn add<T>(list: &mut List<T>, elem: T) {
    list.push(elem);
}

pub fn remove_first<T>(list: &mut List<T>) -> Option<T> {
    if list.is_empty() { None } else { Some(list.remove(0)) }
}

pub fn remove_last<T>(list: &mut List<T>) -> Option<T> {
    list.pop()
}

pub fn remove_at<T>(list: &mut List<T>, index: i32) -> Option<T> {
    if index < 0 || index as usize >= list.len() { None } else { Some(list.remove(index as usize)) }
}

// [col-insert] The element back when the index is outside `0..=len`.
pub fn insert_at<T>(list: &mut List<T>, index: i32, elem: T) -> Option<T> {
    if index < 0 || index as usize > list.len() {
        return Some(elem);
    }
    list.insert(index as usize, elem);
    None
}

// [col-remove-range] Clamped to the list.
pub fn remove_range<T>(list: &mut List<T>, from: i32, to: i32) -> List<T> {
    let len = list.len() as i64;
    let from = (from as i64).clamp(0, len) as usize;
    let to = (to as i64).clamp(from as i64, len) as usize;
    list.drain(from..to).collect()
}

// [col-bounds] Out of range moves nothing and answers `false`.
pub fn swap_at<T>(list: &mut List<T>, i: i32, j: i32) -> bool {
    let n = list.len() as i32;
    if i < 0 || j < 0 || i >= n || j >= n {
        return false;
    }
    list.swap(i as usize, j as usize);
    true
}

pub fn into_mut<T>(list: List<T>) -> List<T> {
    list
}

// [linear-container] Ending one that still holds elements would drop them.
pub fn end_empty<T>(list: List<T>) {
    assert!(list.is_empty(), "salvo: a list was ended with elements in it");
}

// A stable sort, in the language's ordering, of a copy.
pub fn sort_by<T: Clone>(list: &List<T>, cmp: &mut dyn FnMut(&T, &T) -> i32) -> List<T> {
    let mut out = list.clone();
    out.sort_by(|a, b| cmp(a, b).cmp(&0));
    out
}

// A **lower bound**: an equal run is entered from the front, so both backends
// land on the same index.
pub fn insert_sorted_by<T>(list: &mut List<T>, elem: T, cmp: &mut dyn FnMut(&T, &T) -> i32) {
    let at = list.partition_point(|x| cmp(x, &elem) < 0);
    list.insert(at, elem);
}

// Lower bound, then a tie in the same ordering [col-membership].
pub fn search_sorted_by<T>(list: &List<T>, elem: &T, cmp: &mut dyn FnMut(&T, &T) -> i32) -> Option<i32> {
    let at = list.partition_point(|x| cmp(x, elem) < 0);
    if at < list.len() && cmp(&list[at], elem) == 0 { Some(at as i32) } else { None }
}

// ===== platform/core/map.rs =====
// [platform-value-type] std's map, for `core.map`'s `platform type Map<K,
// V>(?hash, ?eq) canbe Mut` (ROADMAP 0.7): the runtime's insertion-ordered
// `SalvoMap`, which carries the identities it was built with
// [platform-slots]. `Mut Map` is the same type, passed as `&mut`.

pub type Map<K, V> = crate::collections::SalvoMap<K, V>;
pub type MutMap<K, V> = crate::collections::SalvoMap<K, V>;

// [platform-iterable] [col-map-iter] The host's loop over a map: its keys,
// in insertion order.
pub fn each<K, V>(map: &Map<K, V>) -> impl Iterator<Item = &K> + '_ {
    map.keys()
}

pub fn each_mut<K, V>(_map: &mut Map<K, V>) -> std::iter::Empty<&mut K> {
    // A key is written in place nowhere: it would move in the map.
    unreachable!("salvo: a map's keys are not written in place")
}

pub fn into_each<K: Clone, V>(map: Map<K, V>) -> std::vec::IntoIter<K> {
    map.keys().cloned().collect::<Vec<K>>().into_iter()
}

pub fn get<'a, K, V>(map: &'a Map<K, V>, key: &K) -> Option<&'a V> {
    map.get(key)
}

// The claim proved the key present [qual-depend].
pub fn get_present<'a, K, V>(map: &'a Map<K, V>, key: &K) -> &'a V {
    map.get(key).expect("salvo: a `KeyOf` key is absent")
}

pub fn put<K, V>(map: &mut Map<K, V>, key: K, value: V) {
    map.insert(key, value);
}

pub fn replace<K, V>(map: &mut Map<K, V>, key: K, value: V) -> Option<V> {
    map.replace(key, value)
}

pub fn remove<K, V>(map: &mut Map<K, V>, key: &K) -> Option<V> {
    map.remove(key)
}

pub fn contains_key<K, V>(map: &Map<K, V>, key: &K) -> bool {
    map.contains_key(key)
}

pub fn size<K, V>(map: &Map<K, V>) -> i32 {
    map.len() as i32
}

pub fn keys<K: Clone, V>(map: &Map<K, V>) -> Vec<K> {
    map.keys().cloned().collect()
}

// [linear-container] The values, owned, in insertion order.
pub fn into_values<K, V>(map: Map<K, V>) -> Vec<V> {
    map.into_values()
}

// ===== platform/core/set.rs =====
// [platform-value-type] std's set, for `core.set`'s `platform type Set<T>(?hash,
// ?eq) canbe Mut` (ROADMAP 0.7): the runtime's insertion-ordered `SalvoSet`,
// which carries the identities it was built with [platform-slots]. `Mut Set`
// is the same type, passed as `&mut`.

pub type Set<T> = crate::collections::SalvoSet<T>;
pub type MutSet<T> = crate::collections::SalvoSet<T>;

// [platform-iterable] The host's loop over a set, in insertion order.
pub fn each<T>(set: &Set<T>) -> impl Iterator<Item = &T> + '_ {
    set.iter()
}

pub fn each_mut<T>(_set: &mut Set<T>) -> std::iter::Empty<&mut T> {
    // An element is a key: writing through one would move it in the set.
    unreachable!("salvo: a set's elements are not written in place")
}

pub fn into_each<T: Clone>(set: Set<T>) -> std::vec::IntoIter<T> {
    set.iter().cloned().collect::<Vec<T>>().into_iter()
}

pub fn add<T>(set: &mut Set<T>, elem: T) -> bool {
    set.insert(elem)
}

pub fn remove<T>(set: &mut Set<T>, elem: &T) -> bool {
    set.remove(elem)
}

pub fn contains<T>(set: &Set<T>, elem: &T) -> bool {
    set.contains(elem)
}

pub fn size<T>(set: &Set<T>) -> i32 {
    set.len() as i32
}

// In insertion order [col-insertion-order].
pub fn to_list<T: Clone>(set: &Set<T>) -> Vec<T> {
    set.iter().cloned().collect()
}

// ===== platform/core/sorted.rs =====
// [platform-value-type] std's sorted pair, for `core.sorted`'s `platform type
// SortedSet<T>(?cmp)` and `SortedMap<K, V>(?cmp)` (ROADMAP 0.7): the runtime's
// containers, which carry the ordering they were built with
// [platform-slots]. A `Mut` one is the same type, passed as `&mut`.

pub type SortedSet<T> = crate::collections::SalvoSortedSet<T>;
pub type MutSortedSet<T> = crate::collections::SalvoSortedSet<T>;
pub type SortedMap<K, V> = crate::collections::SalvoSortedMap<K, V>;
pub type MutSortedMap<K, V> = crate::collections::SalvoSortedMap<K, V>;

// [platform-iterable] The host's loops: a set's elements and a map's keys,
// in order. Elements and keys are not written in place.
pub fn each_sorted_set<T>(set: &SortedSet<T>) -> impl Iterator<Item = &T> + '_ {
    set.iter()
}

pub fn each_sorted_set_mut<T>(_set: &mut SortedSet<T>) -> std::iter::Empty<&mut T> {
    unreachable!("salvo: a sorted set's elements are not written in place")
}

pub fn into_each_sorted_set<T: Clone>(set: SortedSet<T>) -> std::vec::IntoIter<T> {
    set.to_vec().into_iter()
}

pub fn each_sorted_map<K, V>(map: &SortedMap<K, V>) -> impl Iterator<Item = &K> + '_ {
    map.iter().map(|(k, _)| k)
}

pub fn each_sorted_map_mut<K, V>(_map: &mut SortedMap<K, V>) -> std::iter::Empty<&mut K> {
    unreachable!("salvo: a sorted map's keys are not written in place")
}

pub fn into_each_sorted_map<K, V>(map: SortedMap<K, V>) -> std::vec::IntoIter<K> {
    map.keys().into_iter()
}

pub fn add<T>(set: &mut SortedSet<T>, elem: T) -> bool {
    set.insert(elem)
}

pub fn remove_elem<T>(set: &mut SortedSet<T>, elem: &T) -> bool {
    set.remove(elem)
}

pub fn contains<T>(set: &SortedSet<T>, elem: &T) -> bool {
    set.contains(elem)
}

pub fn set_size<T>(set: &SortedSet<T>) -> i32 {
    set.len() as i32
}

pub fn min<T: Clone>(set: &SortedSet<T>) -> Option<T> {
    set.min().cloned()
}

pub fn max<T: Clone>(set: &SortedSet<T>) -> Option<T> {
    set.max().cloned()
}

pub fn to_list<T>(set: &SortedSet<T>) -> Vec<T> {
    set.to_vec()
}

pub fn get<'a, K, V>(map: &'a SortedMap<K, V>, key: &K) -> Option<&'a V> {
    map.get(key)
}

pub fn put<K, V>(map: &mut SortedMap<K, V>, key: K, value: V) {
    map.insert(key, value);
}

pub fn remove_key<K, V>(map: &mut SortedMap<K, V>, key: &K) -> Option<V> {
    map.remove(key)
}

pub fn contains_key<K, V>(map: &SortedMap<K, V>, key: &K) -> bool {
    map.contains_key(key)
}

pub fn map_size<K, V>(map: &SortedMap<K, V>) -> i32 {
    map.len() as i32
}

pub fn first_key<K: Clone, V>(map: &SortedMap<K, V>) -> Option<K> {
    map.first_key().cloned()
}

pub fn last_key<K: Clone, V>(map: &SortedMap<K, V>) -> Option<K> {
    map.last_key().cloned()
}

pub fn keys<K, V>(map: &SortedMap<K, V>) -> Vec<K> {
    map.keys()
}

// ===== platform/core/string.rs =====
// [platform-value-type] std's string, for `core.string`'s
// `platform type Str canbe Mut` (ROADMAP 0.7). A `Str` is a `String`, and so
// is a `Mut Str`, passed as `&mut`. Indices count characters, not bytes.

pub type Str = String;
pub type MutStr = String;

// [platform-iterable] The host's loop over a string: its characters.
pub fn each(str: &String) -> std::str::Chars<'_> {
    str.chars()
}

pub fn empty_str() -> MutStr {
    String::new()
}

pub fn size(str: &String) -> i32 {
    str.chars().count() as i32
}

// The UTF-8 byte count, which the filesystem's offsets are in [fs-token].
pub fn byte_size(str: &String) -> i64 {
    str.len() as i64
}

pub fn char_at(str: &String, index: i32) -> Option<char> {
    if index < 0 { None } else { str.chars().nth(index as usize) }
}

pub fn split(str: &String, sep: &String) -> Vec<String> {
    str.split(&sep[..]).map(|p| p.to_string()).collect()
}

fn chars_before(s: &str, byte: usize) -> i32 {
    s[..byte].chars().count() as i32
}

pub fn index_of(str: &String, needle: &String) -> Option<i32> {
    str.find(&needle[..]).map(|b| chars_before(str, b))
}

// [str-search] From a character offset; below 0 is the start.
pub fn index_of_from(str: &String, needle: &String, from: i32) -> Option<i32> {
    let from = from.max(0) as usize;
    if from > str.chars().count() {
        return None;
    }
    let start = str.char_indices().nth(from).map(|(b, _)| b).unwrap_or(str.len());
    str[start..].find(&needle[..]).map(|k| chars_before(str, start + k))
}

pub fn last_index_of(str: &String, needle: &String) -> Option<i32> {
    str.rfind(&needle[..]).map(|b| chars_before(str, b))
}

pub fn replace(str: &String, from: &String, to: &String) -> String {
    str.replace(&from[..], &to[..])
}

pub fn trim_start(str: &String) -> String {
    str.trim_start().to_string()
}

pub fn trim_end(str: &String) -> String {
    str.trim_end().to_string()
}

pub fn contains(str: &String, needle: &String) -> bool {
    str.contains(&needle[..])
}

pub fn starts_with(str: &String, prefix: &String) -> bool {
    str.starts_with(&prefix[..])
}

pub fn ends_with(str: &String, suffix: &String) -> bool {
    str.ends_with(&suffix[..])
}

pub fn trim(str: &String) -> String {
    str.trim().to_string()
}

// Unchanged when the affix is absent.
pub fn trim_prefix(str: &String, prefix: &String) -> String {
    str.strip_prefix(&prefix[..]).unwrap_or(str).to_string()
}

pub fn trim_suffix(str: &String, suffix: &String) -> String {
    str.strip_suffix(&suffix[..]).unwrap_or(str).to_string()
}

// Out of range is `None`, not a panic.
pub fn substr(str: &String, start: i32, end: i32) -> Option<String> {
    let n = str.chars().count() as i32;
    if start >= 0 && end >= start && end <= n {
        Some(str.chars().skip(start as usize).take((end - start) as usize).collect())
    } else {
        None
    }
}

pub fn to_upper(str: &String) -> String {
    str.to_uppercase()
}

pub fn to_lower(str: &String) -> String {
    str.to_lowercase()
}

pub fn join(parts: &Vec<String>, sep: &String) -> String {
    parts.join(&sep[..])
}

pub fn parse_int(str: &String) -> Option<i32> {
    str.parse::<i32>().ok()
}

pub fn append(str: &mut String, text: &String) {
    str.push_str(text);
}

// [col-bounds] Out of range writes nothing and answers `false`.
pub fn set(str: &mut String, index: i32, chr: char) -> bool {
    if index < 0 || index as usize >= str.chars().count() {
        return false;
    }
    let i = index as usize;
    *str = str.chars().enumerate().map(|(k, c)| if k == i { chr } else { c }).collect();
    true
}

pub fn clear(str: &mut String) {
    str.clear();
}
