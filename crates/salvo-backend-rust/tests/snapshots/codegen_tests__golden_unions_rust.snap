// ===== core/console.rs =====

pub trait Console {
    fn print(&mut self, message: &String);
}

pub struct StdOutConsole {
}

impl StdOutConsole {
    pub fn new() -> Self {
        Self { }
    }
}

impl Console for StdOutConsole {
    fn print(&mut self, message: &String) {
        print!("{}", message)
    }
}

pub fn println(console: &mut dyn Console, message: &String) {
    console.print(message);
    console.print(&("\n".to_string()));
}

// ===== main.rs =====
#![allow(non_snake_case, non_camel_case_types, unused_mut, unused_parens, unused_imports, dead_code, unreachable_code, unused_variables, path_statements, unused_must_use, suspicious_double_ref_op)]
#[path = "unions.rs"]
pub mod unions;
#[path = "core/console.rs"]
pub mod core_console;

use crate::core_console::*;
use crate::unions::*;

pub fn ok<T: Clone>(value: T) -> T {
    return value;
}

pub fn err<T: Clone>(value: T) -> T {
    return value;
}

pub fn parse_age(input: i32) -> Union2<i32, String> {
    if input >= 0 {
        return Union2::<i32, String>::U1(ok(input));
    }
    return Union2::<i32, String>::U2(err("negative age".to_string()));
}

pub fn describe(result: &Union2<i32, String>) -> String {
    let mut msg = match result {
    Union2::U1(_) => {
format!("age {}", *result.u1())
    }
    Union2::U2(_) => {
format!("error: {}", result.u2().clone())
    }
};
    return msg;
}

pub fn main() {
    let mut console = StdOutConsole::new();
    let mut good = parse_age(36);
    println(&mut console, &(describe(&good)));
    let mut bad = parse_age(-1);
    println(&mut console, &(describe(&bad)));
    let mut precise: Union3<String, String, bool> = Union3::<String, String, bool>::U1(ok("yes".to_string()));
    if matches!(precise, Union3::U2(_)) {
        println(&mut console, &(format!("err str: {}", precise.u2().clone())));
    } else if matches!(precise, Union3::U1(_)) {
        println(&mut console, &(format!("ok: {}", precise.u1().clone())));
    } else {
        println(&mut console, &(format!("err bool: {}", *precise.u3())));
    }
    let mut value = match good {
    Union2::U1(_) => {
*good.u1()
    }
    Union2::U2(_) => {
return;
    }
};
    println(&mut console, &(format!("value plus one is {}", value + 1)));
}

// ===== unions.rs =====
// Generated by the Salvo compiler: enums for union types.

#[derive(Clone, Debug)]
pub enum Union2<T1, T2> {
    U1(T1),
    U2(T2),
}

impl<T1, T2> Union2<T1, T2> {
    pub fn u1(&self) -> &T1 {
        match self {
            Union2::U1(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u2(&self) -> &T2 {
        match self {
            Union2::U2(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
}

impl<T1, T2> std::fmt::Display for Union2<T1, T2>
where
    T1: std::fmt::Display,
    T2: std::fmt::Display,
{
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Union2::U1(v) => write!(f, "{}", v),
            Union2::U2(v) => write!(f, "{}", v),
        }
    }
}

#[derive(Clone, Debug)]
pub enum Union3<T1, T2, T3> {
    U1(T1),
    U2(T2),
    U3(T3),
}

impl<T1, T2, T3> Union3<T1, T2, T3> {
    pub fn u1(&self) -> &T1 {
        match self {
            Union3::U1(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u2(&self) -> &T2 {
        match self {
            Union3::U2(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
    pub fn u3(&self) -> &T3 {
        match self {
            Union3::U3(v) => v,
            _ => panic!("unreachable union arm"),
        }
    }
}

impl<T1, T2, T3> std::fmt::Display for Union3<T1, T2, T3>
where
    T1: std::fmt::Display,
    T2: std::fmt::Display,
    T3: std::fmt::Display,
{
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Union3::U1(v) => write!(f, "{}", v),
            Union3::U2(v) => write!(f, "{}", v),
            Union3::U3(v) => write!(f, "{}", v),
        }
    }
}
