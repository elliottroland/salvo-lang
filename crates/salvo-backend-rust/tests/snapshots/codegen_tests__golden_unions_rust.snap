use crate::unions::*;
use crate::core_console::ConsolePlatformSync as _;
use crate::core_console::__Stateful_Console as _;
use crate::core_console::__Stateless_Console as _;
use crate::core_console::println;
use crate::core_result::err;
use crate::core_result::ok;

pub fn parse_age(input: i32) -> Union2<i32, String> {
    if input >= 0 {
        return Union2::<i32, String>::U1(ok(input));
    }
    return Union2::<i32, String>::U2(err("negative age".to_string()));
}

pub fn describe(result: &Union2<i32, String>) -> String {
    let mut msg = match result {
        Union2::U1(_) => {
            format!("age {}", *result.u1())
        }
        Union2::U2(_) => {
            format!("error: {}", result.u2().clone())
        }
    };
    return msg;
}

pub fn main() {
    let console = crate::core_console::Console::shared(crate::core_console::__Platform_StdOutConsole::new());
    let mut good = parse_age(36);
    println(&console, &(describe(&good)));
    let mut bad = parse_age(-1);
    println(&console, &(describe(&bad)));
    let mut precise: Union3<String, String, bool> = Union3::<String, String, bool>::U1(ok("yes".to_string()));
    if matches!(precise, Union3::U2(_)) {
        println(&console, &(format!("err str: {}", precise.u2().clone())));
    } else if matches!(precise, Union3::U1(_)) {
        println(&console, &(format!("ok: {}", precise.u1().clone())));
    } else {
        println(&console, &(format!("err bool: {}", *precise.u3())));
    }
    let mut value = match good {
        Union2::U1(_) => {
            *good.u1()
        }
        Union2::U2(_) => {
            return;
        }
    };
    println(&console, &(format!("value plus one is {}", i32::wrapping_add(value, 1))));
}

