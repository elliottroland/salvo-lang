// ===== core/console.rs =====

pub trait Console {
    fn print(&mut self, message: &String);
}

pub struct StdOutConsole {
}

impl StdOutConsole {
    pub fn new() -> Self {
        Self { }
    }
}

impl Console for StdOutConsole {
    fn print(&mut self, message: &String) {
        print!("{}", message)
    }
}

pub fn println(console: &mut dyn Console, message: &String) {
    console.print(message);
    console.print(&("\n".to_string()));
}

// ===== main.rs =====
#![allow(non_snake_case, non_camel_case_types, unused_mut, unused_parens, unused_imports, dead_code, unreachable_code, unused_variables, path_statements, unused_must_use, suspicious_double_ref_op)]
#[path = "core/console.rs"]
pub mod core_console;

use crate::core_console::*;

pub trait Random<T> {
    fn next_random(&mut self) -> T;
}

pub struct CyclicRandom<T: Clone> {
    values: Vec<T>,
    i: i32,
}

impl<T: Clone> CyclicRandom<T> {
    pub fn new(values: Vec<T>) -> Self {
        Self {
            values,
            i: 0,
        }
    }
}

impl<T: Clone> Random<T> for CyclicRandom<T> {

    fn next_random(&mut self) -> T {
        let mut value = self.values.get((self.i % (self.values.len() as i32)) as usize).cloned().unwrap();
        self.i = self.i + 1;
        return value;
    }
}

pub fn draw(random_i32: &mut dyn Random<i32>, random_string: &mut dyn Random<String>, console: &mut dyn Console) {
    let mut n: i32 = random_i32.next_random();
    let mut s: String = random_string.next_random();
    println(console, &(format!("{}: {}", s, n)));
}

pub fn lucky_number(random_i32: &mut dyn Random<i32>) -> i32 {
    return random_i32.next_random();
}

pub fn main() {
    let mut console = StdOutConsole::new();
    let mut random_i32 = CyclicRandom::new(vec![10, 20, 30]);
    let mut random_string = CyclicRandom::new(vec!["a".to_string(), "b".to_string()]);
    draw(&mut random_i32, &mut random_string, &mut console);
    draw(&mut random_i32, &mut random_string, &mut console);
    println(&mut console, &(format!("lucky: {}", random_i32.next_random())));
    println(&mut console, &(format!("again: {}", lucky_number(&mut random_i32))));
}
