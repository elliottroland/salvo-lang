// ===== core/console.kt =====
package salvo.core.console

interface Console {
    fun print(message: String)
}

class StdOutConsole : Console {
    override fun print(message: String) {
        kotlin.io.print(message)
    }
}

fun println(console: Console, message: String) {
    console.print(message)
    console.print("\n")
}

// ===== core/result.kt =====
package salvo.core.result

fun<T> ok(value: T): T {
    return value
}

fun<T> err(value: T): T {
    return value
}

// ===== main.kt =====
package salvo.main

import salvo.*
import salvo.core.console.*
import salvo.core.result.*

fun range(start: Int, end: Int): Iterable<Int> {
    return Iterable<Int> {
        iterator {
            var i = start
            while (i++ < end) {
                yield(i - 1)
            }
        }
    }
}

fun main() {
    val console: Console = StdOutConsole()
    var i = 0
    val last = run {
var __loop1: Int? = null
var __loop1_ran = false
while (i++ < 4) {
__loop1_ran = true
__loop1 = i * 10
}
if (!__loop1_ran) {
__loop1 = -1
}
__loop1!!
}
    println(console, "last: $last")
    val j = 9
    val never = run {
var __loop2: Int? = null
var __loop2_ran = false
while (j < 3) {
__loop2_ran = true
__loop2 = j
}
if (!__loop2_ran) {
__loop2 = -1
}
__loop2!!
}
    println(console, "never: $never")
    val found = run {
var __loop3: Int? = null
for (x in range(0, 10)) {
if (x * x > 10) {
    __loop3 = x
    break
}
__loop3 = x
}
__loop3
}
    if (found != null) {
        val f = found as Int
        println(console, "found: $f")
    }
    var __loop4_ran = false
    for (x in range(0, 0)) {
        __loop4_ran = true
        println(console, "unreachable")
    }
    if (!__loop4_ran) {
        println(console, "empty range")
    }
    var k = 0
    val capped = run {
var __loop5: Int? = null
while (k < 5) {
k++
if (k == 3) {
    break
}
__loop5 = k
}
__loop5
}
    println(console, "capped: ${capped!!}")
    var n = 0
    val verdict: Union2<Int, String> = run {
var __loop6: Union2<String, Int>? = null
var __loop6_ran = false
while (n < 3) {
__loop6_ran = true
if (n == 2) {
    __loop6 = U2_2<String, Int>(ok(n))
    break
}
n++
__loop6 = U2_1<String, Int>(err("not yet"))
}
if (!__loop6_ran) {
__loop6 = U2_1<String, Int>(err("empty"))
}
__loop6!!
}.let { when (it) { is U2_1<*, *> -> U2_2<Int, String>(it.value as String); is U2_2<*, *> -> U2_1<Int, String>(it.value as Int); } }
    when (verdict) {
        is U2_1<*, *> -> {
            println(console, "ok: ${(verdict.value as Int)}")
        }
        is U2_2<*, *> -> {
            println(console, "err: ${(verdict.value as String)}")
        }
    }
}

// ===== unions.kt =====
// Generated by the Salvo compiler: sealed wrappers for union types.
package salvo

sealed interface Union2<out T1, out T2> {
    val value: Any?
}
data class U2_1<out T1, out T2>(override val value: T1) : Union2<T1, T2>
data class U2_2<out T1, out T2>(override val value: T2) : Union2<T1, T2>
