data class Span(
    val start: Int,
    val end: Int,
)

fun SpanOf_qualifies(span: Span, str: String): Boolean {
    return span.start >= 0 && span.start <= span.end && span.end <= str.length
}

fun substr(str: String, at: Span): String {
