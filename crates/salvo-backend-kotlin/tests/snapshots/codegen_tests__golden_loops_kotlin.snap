package salvo.core.string

import salvo.*
import salvo.core.iterator.*
import salvo.core.list.*

fun iter__3(str: String): StrPass {
    return StrPass(text = str, at = 0)
}

data class StrPass(
    var text: String,
    var at: Int,
)

fun next__5(pass: StrPass): Union2<Char, Finished> {
    val chr = pass.text.getOrNull(pass.at)
    if (chr == null) {
        return U2_2<Char, Finished>(finished())
    }
    pass.at = pass.at + 1
    return U2_1<Char, Finished>(emitted(chr))
}

// ===== main.kt =====
package salvo.main

import salvo.*
import salvo.core.console.*
import salvo.core.iterator.*
import salvo.core.result.*
import salvo.core.string.*

data class Range(
    val start: Int,
    val end: Int,
)

fun range(start: Int, end: Int): Range {
    return Range(start = start, end = end)
}

class __Pass_Range(private var r: Range) {
    private var i: Int = 0
    private var __state: Int = 0
    private var __current: Any? = null

    fun __advance(): Boolean {
        while (true) {
            when (__state) {
                0 -> {
                    i = r.start
                    __state = 1
                    continue
                }
                1 -> {
                    if (!(i++ < r.end)) {
                        __state = 2
                        continue
                    }
                    __current = i - 1
                    __state = 1
                    return true
                }
                2 -> {
                    __state = 2
                    return false
                }
                else -> return false
            }
        }
    }

    fun __close() {
        __state = 2
    }

    @Suppress("UNCHECKED_CAST")
    fun __current(): Int = __current as Int
}

fun main() {
    val console: Console = StdOutConsole()
    var i = 0
    val last = run {
var __loop1: Int? = null
var __loop1_ran = false
while (i++ < 4) {
__loop1_ran = true
__loop1 = i * 10
}
if (!__loop1_ran) {
__loop1 = -1
}
__loop1!!
}
    println(console, "last: $last")
    val j = 9
    val never = run {
var __loop2: Int? = null
var __loop2_ran = false
while (j < 3) {
__loop2_ran = true
__loop2 = j
}
if (!__loop2_ran) {
__loop2 = -1
}
__loop2!!
}
    println(console, "never: $never")
    val found = run {
var __loop3: Int? = null
for (x in arrayOf(0, 1, 2, 3, 4, 5)) {
if (x * x > 10) {
    __loop3 = x
    break
}
__loop3 = x
}
__loop3
}
    if (found != null) {
        val f = found as Int
        println(console, "found: $f")
    }
    var __loop4_ran = false
    val __loop5_pass = __Pass_Range(range(0, 0))
    try {
    while (__loop5_pass.__advance()) {
        val x = __loop5_pass.__current()
        __loop4_ran = true
        println(console, "unreachable")
    }
    } finally {
        __loop5_pass.__close()
    }
    if (!__loop4_ran) {
        println(console, "empty range")
    }
    var k = 0
    val capped = run {
var __loop6: Int? = null
while (k < 5) {
k++
if (k == 3) {
    break
}
__loop6 = k
}
__loop6
}
    println(console, "capped: ${capped!!}")
    var n = 0
    val verdict: Union2<Int, String> = run {
var __loop7: Union2<String, Int>? = null
var __loop7_ran = false
while (n < 3) {
__loop7_ran = true
if (n == 2) {
    __loop7 = U2_2<String, Int>(ok(n))
    break
}
n++
__loop7 = U2_1<String, Int>(err("not yet"))
}
if (!__loop7_ran) {
__loop7 = U2_1<String, Int>(err("empty"))
}
__loop7!!
}.let { when (it) { is U2_1<*, *> -> U2_2<Int, String>(it.value as String); is U2_2<*, *> -> U2_1<Int, String>(it.value as Int); } }
    when (verdict) {
        is U2_1<*, *> -> {
            println(console, "ok: ${(verdict.value as Int)}")
        }
        is U2_2<*, *> -> {
            println(console, "err: ${(verdict.value as String)}")
        }
    }
}

// ===== unions.kt =====
// Generated by the Salvo compiler: sealed wrappers for union types.
package salvo

sealed interface Union2<out T1, out T2> {
    val value: Any?
}
data class U2_1<out T1, out T2>(override val value: T1) : Union2<T1, T2>
data class U2_2<out T1, out T2>(override val value: T2) : Union2<T1, T2>
