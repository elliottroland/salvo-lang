// ===== core/array.kt =====
package salvo.core.array

import salvo.*
import salvo.core.iterator.*
import salvo.core.list.*

fun<T> iter(array: Array<T>): ArrayPass<T> {
    return ArrayPass(items = array, at = 0)
}

data class ArrayPass<T>(
    var items: Array<T>,
    var at: Int,
)

fun<T> next(pass: ArrayPass<T>): Union2<T, Finished> {
    val elem = pass.items.getOrNull(pass.at)
    if (elem == null) {
        return U2_2<T, Finished>(finished())
    }
    pass.at = pass.at + 1
    return U2_1<T, Finished>(emitted(elem))
}

// ===== core/console.kt =====
package salvo.core.console

import salvo.core.string.*

interface Console {
    fun print(message: String)
}

class StdOutConsole : Console {
    override fun print(message: String) {
        kotlin.io.print(message)
    }
}

fun println(console: Console, message: String) {
    console.print(message)
    console.print("\n")
}

// ===== core/iterator.kt =====
package salvo.core.iterator

class Finished

fun<T> emitted(value: T): T {
    return value
}

fun finished(): Finished {
    return Finished()
}

