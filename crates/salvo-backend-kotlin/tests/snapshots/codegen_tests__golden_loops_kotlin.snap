}

// ===== main.kt =====
package salvo.main

import salvo.*
import salvo.core.console.*
import salvo.core.iterator.*
import salvo.core.result.*
import salvo.core.string.*

data class Upto(
    val start: Int,
    val end: Int,
)

fun upto(start: Int, end: Int): Upto {
    return Upto(start = start, end = end)
}

data class __Pass_Upto(
    var end: Int,
    var at: Int,
)

fun iter__10(r: Upto): __Pass_Upto {
    return __Pass_Upto(end = r.end, at = r.start)
}

fun next__13(__p: __Pass_Upto): Union2<Int, Finished> {
    if (__p.at >= __p.end) {
        return U2_2<Int, Finished>(finished())
    }
    val v = __p.at
    __p.at = __p.at + 1
    return U2_1<Int, Finished>(emitted(v))
}

@Suppress("UNCHECKED_CAST", "USELESS_CAST")
fun main() {
    val console: Console = StdOutConsole()
    var i = 0
    val last = run {
var __loop1: Int? = null
var __loop1_ran = false
while (i++ < 4) {
__loop1_ran = true
__loop1 = i * 10
}
if (!__loop1_ran) {
__loop1 = -1
}
__loop1!!
}
    println(console, "last: $last")
    val j = 9
    val never = run {
var __loop2: Int? = null
var __loop2_ran = false
while (j < 3) {
__loop2_ran = true
__loop2 = j
}
if (!__loop2_ran) {
__loop2 = -1
}
__loop2!!
}
    println(console, "never: $never")
    val found = run {
var __loop3: Int? = null
for (x in listOf<Int>(0, 1, 2, 3, 4, 5)) {
if (x * x > 10) {
    __loop3 = x
    break
}
__loop3 = x
}
__loop3
}
    if (found != null) {
        val f = found as Int
        println(console, "found: $f")
    }
    var __loop4_ran = false
    var __loop5_pass = iter__10(upto(0, 0))
    while (true) {
        val __loop5_step = next__13(__loop5_pass)
        if (__loop5_step !is U2_1<Int, Finished>) { break }
        val x = __loop5_step.value
        __loop4_ran = true
        println(console, "unreachable")
    }
    if (!__loop4_ran) {
        println(console, "empty range")
    }
    var k = 0
    val capped = run {
var __loop6: Int? = null
while (k < 5) {
k++
if (k == 3) {
    break
}
__loop6 = k
}
__loop6
}
    println(console, "capped: ${(capped ?: throw AssertionError("salvo: value is absent at main:74:24"))}")
    var n = 0
    val verdict: Union2<Int, String> = run {
var __loop7: Union2<String, Int>? = null
var __loop7_ran = false
while (n < 3) {
__loop7_ran = true
if (n == 2) {
    __loop7 = U2_2<String, Int>(ok(n))
    break
}
n++
__loop7 = U2_1<String, Int>(err("not yet"))
}
if (!__loop7_ran) {
__loop7 = U2_1<String, Int>(err("empty"))
}
__loop7!!
}.let { when (it) { is U2_1<*, *> -> U2_2<Int, String>(it.value as String); is U2_2<*, *> -> U2_1<Int, String>(it.value as Int); } }
    when (verdict) {
        is U2_1<*, *> -> {
            println(console, "ok: ${(verdict.value as Int)}")
        }
        is U2_2<*, *> -> {
            println(console, "err: ${(verdict.value as String)}")
        }
    }
}

