@Suppress("UNCHECKED_CAST", "USELESS_CAST")
fun main() {
    val console: Console = StdOutConsole()
    var i = 0
    val last = run {
var __loop1: Int? = null
var __loop1_ran = false
while (i++ < 4) {
__loop1_ran = true
__loop1 = i * 10
}
if (!__loop1_ran) {
__loop1 = -1
}
__loop1!!
}
    println(console, "last: $last")
    val j = 9
    val never = run {
var __loop2: Int? = null
var __loop2_ran = false
while (j < 3) {
__loop2_ran = true
__loop2 = j
}
if (!__loop2_ran) {
__loop2 = -1
}
__loop2!!
}
    println(console, "never: $never")
    val found = run {
var __loop3: Int? = null
for (x in listOf<Int>(0, 1, 2, 3, 4, 5)) {
if (x * x > 10) {
    __loop3 = x
    break
}
__loop3 = x
}
__loop3
}
    if (found != null) {
        val f = found as Int
        println(console, "found: $f")
    }
    var __loop4_ran = false
    var __loop5_pass = iter__10(upto(0, 0))
    while (true) {
        val __loop5_step = next__17(__loop5_pass)
        if (__loop5_step !is Union2.U1<Int, Finished>) { break }
        val x = __loop5_step.value
        __loop4_ran = true
        println(console, "unreachable")
    }
    if (!__loop4_ran) {
        println(console, "empty range")
    }
    var k = 0
    val capped = run {
var __loop6: Int? = null
while (k < 5) {
k++
if (k == 3) {
    break
}
__loop6 = k
}
__loop6
}
    println(console, "capped: ${(capped ?: throw AssertionError("salvo: value is absent at main:74:24"))}")
    var n = 0
    val verdict: Union2<Int, String> = run {
var __loop7: Union2<String, Int>? = null
var __loop7_ran = false
while (n < 3) {
__loop7_ran = true
if (n == 2) {
    __loop7 = Union2.U2<String, Int>(ok(n))
    break
}
n++
__loop7 = Union2.U1<String, Int>(err("not yet"))
}
if (!__loop7_ran) {
__loop7 = Union2.U1<String, Int>(err("empty"))
}
__loop7!!
}.let { when (it) { is Union2.U1<*, *> -> Union2.U2<Int, String>(it.value as String); is Union2.U2<*, *> -> Union2.U1<Int, String>(it.value as Int); } }
    when (verdict) {
        is Union2.U1<*, *> -> {
            println(console, "ok: ${(verdict.value as Int)}")
        }
        is Union2.U2<*, *> -> {
            println(console, "err: ${(verdict.value as String)}")
        }
    }
}

// ===== unions.kt =====
// Generated by the Salvo compiler: sealed wrappers for union types.
package salvo

sealed interface Union2<out T1, out T2> {
    val value: Any?
    data class U1<out T1, out T2>(override val value: T1) : Union2<T1, T2>
    data class U2<out T1, out T2>(override val value: T2) : Union2<T1, T2>
}

class Union2Codec<T1, T2>(private val c1: WireCodec<T1>, private val c2: WireCodec<T2>) : WireCodec<Union2<T1, T2>> {
    override fun enc(v: Union2<T1, T2>, out: WireOut) {
        when (v) {
            is Union2.U1 -> { out.u8(0); c1.enc(v.value, out) }
            is Union2.U2 -> { out.u8(1); c2.enc(v.value, out) }
        }
    }
    override fun dec(inp: WireIn): Union2<T1, T2> = when (inp.u8()) {
            0 -> Union2.U1(c1.dec(inp))
            1 -> Union2.U2(c2.dec(inp))
            else -> throw WireError()
        }
}

// ===== bytes.kt =====
// Generated by the Salvo compiler: the `Bytes` buffer.
package salvo

/**
 * [kt-bytes] Salvo's `Bytes` and `Mut Bytes`, both of them: one class with
 * mutating methods, immutability enforced by the Salvo checker rather than by
 * the JVM type — the shape `SortedSet`/`SortedMap` already use, where `Mut`
 * needs no different type and dropping it renders nothing [str-drop-mut].
 *
 * Why a class at all, rather than `List<UByte>` or `UByteArray`:
 *
 *  * `List<UByte>` boxes every element (a value class has no box cache, so
 *    each byte is a fresh object) — the cost the `Bytes` type exists to
 *    remove.
 *  * `UByteArray` is fixed-size and, worse, is not a `List<T>`, so it cannot
 *    be passed to anything generic on an erased-generics backend. A buffer
 *    has to grow, so neither of the stdlib shapes fits.
 *
 * The storage is therefore a plain `ByteArray` plus a length, which is what a
 * growable byte buffer is on the JVM; the unsigned reading is applied at the
 * boundary, since Salvo's `Byte` is a `UByte` here [kt-byte-unsigned].
 *
 * `equals`/`hashCode` are **structural**, so `==` on two buffers means the
 * same thing it means on Rust's `Vec<u8>` [backend-parity] — the reason this
 * is a class and not a raw array, which would have compared by identity.
 */
class SalvoBytes {
    private var buf: ByteArray
    private var len: Int

    constructor() {
        buf = ByteArray(16)
        len = 0
    }

    /** A copy: `copy(bytes)` must not alias, since the buffer can be written. */
    constructor(other: SalvoBytes) {
        buf = other.buf.copyOf(other.len)
        len = other.len
    }

    /** Takes ownership of `bytes` — used by the host filesystem and by decoding. */
    constructor(bytes: ByteArray) {
        buf = bytes
        len = bytes.size
    }

    val size: Int get() = len

    fun getOrNull(index: Int): UByte? =
        if (index >= 0 && index < len) buf[index].toUByte() else null

    /** Out of range does nothing: growing here would make a `set` an `add`. */
    // [col-bounds] Answers whether it wrote: out of range the buffer is
    // untouched and the caller is told.
    fun setAt(index: Int, byte: UByte): Boolean {
        if (index < 0 || index >= len) return false
        buf[index] = byte.toByte()
        return true
    }

    fun add(byte: UByte) {
        ensure(len + 1)
        buf[len] = byte.toByte()
        len += 1
    }

    fun append(more: SalvoBytes) {
        ensure(len + more.len)
        System.arraycopy(more.buf, 0, buf, len, more.len)
        len += more.len
    }

    /** The host's fill: appends `count` bytes of `bytes`, answering how many. */
    fun appendArray(bytes: ByteArray, count: Int) {
        ensure(len + count)
        System.arraycopy(bytes, 0, buf, len, count)
        len += count
    }

    /** Keeps the room it had, which is what makes a buffer reusable. */
    fun clear() {
        len = 0
    }

    fun slice(start: Int, end: Int): SalvoBytes? =
        if (start >= 0 && end >= start && end <= len) SalvoBytes(buf.copyOfRange(start, end))
        else null

    fun indexOf(byte: UByte): Int? {
        val b = byte.toByte()
        for (i in 0 until len) {
            if (buf[i] == b) return i
        }
        return null
    }

    /** A defensive copy: the caller may keep it while this buffer moves on. */
    fun toByteArray(): ByteArray = buf.copyOf(len)

    /** Strict UTF-8: a malformed byte is `null`, never a replacement char. */
    fun asString(): String? =
        try {
            java.nio.charset.StandardCharsets.UTF_8.newDecoder()
                .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
                .onUnmappableCharacter(java.nio.charset.CodingErrorAction.REPORT)
                .decode(java.nio.ByteBuffer.wrap(buf, 0, len))
                .toString()
        } catch (e: java.nio.charset.CharacterCodingException) {
            null
        }

    fun toHex(): String {
        val out = StringBuilder(len * 2)
        for (i in 0 until len) {
            val v = buf[i].toInt() and 0xFF
            out.append("0123456789abcdef"[v ushr 4])
            out.append("0123456789abcdef"[v and 0xF])
        }
        return out.toString()
    }

    /** `[0, 255, 200]` — the text a `List<Byte>` printed, kept deliberately. */
    override fun toString(): String {
        val out = StringBuilder()
        out.append("[")
        for (i in 0 until len) {
            if (i > 0) out.append(", ")
            out.append(buf[i].toInt() and 0xFF)
        }
        out.append("]")
        return out.toString()
    }

    override fun equals(other: Any?): Boolean {
        if (other !is SalvoBytes) return false
        if (len != other.len) return false
        for (i in 0 until len) {
            if (buf[i] != other.buf[i]) return false
        }
        return true
    }

    override fun hashCode(): Int {
        var h = 1
        for (i in 0 until len) {
            h = 31 * h + buf[i].toInt()
        }
        return h
    }

    /**
     * Native `for` support: `for b in data` is Kotlin's own loop
     * [kt-iter-native], as it is for a list or a string, so iterating a buffer
     * allocates no pass. The `BytesYield` pass in `core.bytes` is still what
     * the combinators (`map`, `filter`, `reduce`) drive.
     */
    operator fun iterator(): Iterator<UByte> = object : Iterator<UByte> {
        private var at = 0
        override fun hasNext(): Boolean = at < len
        override fun next(): UByte {
            val b = buf[at].toUByte()
            at += 1
            return b
        }
    }

    private fun ensure(need: Int) {
        if (need <= buf.size) return
        var cap = if (buf.size < 16) 16 else buf.size
        while (cap < need) cap *= 2
        buf = buf.copyOf(cap)
    }

    companion object {
        /**
         * An `Array<UByte>` rather than a `vararg UByte`: a vararg of an
         * unsigned type *is* a `UByteArray` under the hood, and that type
         * still needs an `@ExperimentalUnsignedTypes` opt-in — at the call
         * site, i.e. in generated code. A boxed array costs one allocation in
         * a constructor and needs no opt-in anywhere.
         */
        fun of(elems: Array<UByte>): SalvoBytes {
            val out = SalvoBytes()
            for (e in elems) out.add(e)
            return out
        }

        fun joined(vararg parts: SalvoBytes): SalvoBytes {
            val out = SalvoBytes()
            for (p in parts) out.append(p)
            return out
        }

        fun ofUtf8(text: String): SalvoBytes =
            SalvoBytes(text.toByteArray(Charsets.UTF_8))
    }
}

// ===== wire.kt =====
// Generated by the Salvo compiler: the wire — the canonical encoding's codecs
// [wire-format] [kt-wire].
//
// The other half of the encoding: the Kotlin runtime's codecs for every type the language defines without the
// program's help. Byte for byte what the Rust runtime's `wire.rs` produces
// and reads — the encoding is stated once, in `salvo-core`'s `wire.rs`, and
// implemented twice. Struct, union and message codecs are *generated* by the
// emitter beside their declarations as `__Codec_X` objects and classes.
//
// Kotlin has no type-directed trait dispatch for decoding, so a codec is a
// **value** (`WireCodec<T>`), composed for compound types: `ListCodec(IntCodec)`
// is the codec of `List<Int>`. The emitter renders that composition at each
// site from the checked type.
//
// Every integer is big-endian; every length is a `u32`; an optional is a
// presence byte; a union is a tag byte holding the arm's declared index.
// Decoding is total: a malformed input throws `WireError` inside and answers
// `null` from `salvoDecode`, which also refuses trailing bytes.
package salvo

import java.io.ByteArrayOutputStream

class WireError : Exception()

class WireOut {
    private val buf = ByteArrayOutputStream()

    fun u8(b: Int) {
        buf.write(b and 0xff)
    }

    fun i32(v: Int) {
        u8(v ushr 24); u8(v ushr 16); u8(v ushr 8); u8(v)
    }

    fun i64(v: Long) {
        i32((v ushr 32).toInt()); i32(v.toInt())
    }

    fun raw(bytes: ByteArray) {
        buf.write(bytes)
    }

    fun toBytes(): SalvoBytes = SalvoBytes(buf.toByteArray())
}

class WireIn(private val data: ByteArray) {
    private var pos = 0

    private fun take(n: Int): ByteArray {
        if (n < 0 || pos + n > data.size) throw WireError()
        val out = data.copyOfRange(pos, pos + n)
        pos += n
        return out
    }

    fun u8(): Int {
        if (pos >= data.size) throw WireError()
        return data[pos++].toInt() and 0xff
    }

    fun i32(): Int = (u8() shl 24) or (u8() shl 16) or (u8() shl 8) or u8()

    fun i64(): Long = (i32().toLong() shl 32) or (i32().toLong() and 0xffffffffL)

    /** A length prefix, bounded by what is left. */
    fun len(): Int {
        val n = i32()
        if (n < 0 || n > data.size - pos) throw WireError()
        return n
    }

    fun raw(n: Int): ByteArray = take(n)

    val done: Boolean get() = pos == data.size
}

interface WireCodec<T> {
    fun enc(v: T, out: WireOut)
    fun dec(inp: WireIn): T
}

/** `encode(value)`: the whole value, as one frame. */
fun <T> salvoEncode(v: T, c: WireCodec<T>): SalvoBytes {
    val out = WireOut()
    c.enc(v, out)
    return out.toBytes()
}

/** `decode<T>(bytes)`: `null` on a malformed input, including trailing bytes. */
fun <T> salvoDecode(b: SalvoBytes, c: WireCodec<T>): T? {
    val inp = WireIn(b.toByteArray())
    return try {
        val v = c.dec(inp)
        if (!inp.done) null else v
    } catch (e: WireError) {
        null
    }
}

/** [addr-routable] A decode whose failure is told apart from a decoded `null`. */
fun <T> salvoDecodeChecked(b: SalvoBytes, c: WireCodec<T>): Pair<Boolean, Any?> {
    val inp = WireIn(b.toByteArray())
    return try {
        val v = c.dec(inp)
        if (!inp.done) Pair(false, null) else Pair(true, v)
    } catch (e: WireError) {
        Pair(false, null)
    }
}

object BoolCodec : WireCodec<Boolean> {
    override fun enc(v: Boolean, out: WireOut) = out.u8(if (v) 1 else 0)
    override fun dec(inp: WireIn): Boolean = when (inp.u8()) {
        0 -> false
        1 -> true
        else -> throw WireError()
    }
}

object ByteCodec : WireCodec<UByte> {
    override fun enc(v: UByte, out: WireOut) = out.u8(v.toInt())
    override fun dec(inp: WireIn): UByte = inp.u8().toUByte()
}

object IntCodec : WireCodec<Int> {
    override fun enc(v: Int, out: WireOut) = out.i32(v)
    override fun dec(inp: WireIn): Int = inp.i32()
}

object LongCodec : WireCodec<Long> {
    override fun enc(v: Long, out: WireOut) = out.i64(v)
    override fun dec(inp: WireIn): Long = inp.i64()
}

object FloatCodec : WireCodec<Float> {
    override fun enc(v: Float, out: WireOut) = out.i32(v.toRawBits())
    override fun dec(inp: WireIn): Float = Float.fromBits(inp.i32())
}

object DoubleCodec : WireCodec<Double> {
    override fun enc(v: Double, out: WireOut) = out.i64(v.toRawBits())
    override fun dec(inp: WireIn): Double = Double.fromBits(inp.i64())
}

/** A `Char` is its code point: what Rust's `char` carries, on four bytes. */
object CharCodec : WireCodec<Char> {
    override fun enc(v: Char, out: WireOut) = out.i32(v.code)
    override fun dec(inp: WireIn): Char {
        val cp = inp.i32()
        if (cp < 0 || cp > 0xffff) throw WireError()
        return cp.toChar()
    }
}

object StrCodec : WireCodec<String> {
    override fun enc(v: String, out: WireOut) {
        val bytes = v.toByteArray(Charsets.UTF_8)
        out.i32(bytes.size)
        out.raw(bytes)
    }
    override fun dec(inp: WireIn): String {
        val n = inp.len()
        val bytes = inp.raw(n)
        // Strict: what Rust's `String::from_utf8` refuses, this refuses.
        val decoder = Charsets.UTF_8.newDecoder()
        return try {
            decoder.decode(java.nio.ByteBuffer.wrap(bytes)).toString()
        } catch (e: java.nio.charset.CharacterCodingException) {
            throw WireError()
        }
    }
}

/** A `Mut Str` is a `StringBuilder` on this backend; its bytes are a string's. */
object MutStrCodec : WireCodec<StringBuilder> {
    override fun enc(v: StringBuilder, out: WireOut) = StrCodec.enc(v.toString(), out)
    override fun dec(inp: WireIn): StringBuilder = StringBuilder(StrCodec.dec(inp))
}

object BytesCodec : WireCodec<SalvoBytes> {
    override fun enc(v: SalvoBytes, out: WireOut) {
        val bytes = v.toByteArray()
        out.i32(bytes.size)
        out.raw(bytes)
    }
    override fun dec(inp: WireIn): SalvoBytes = SalvoBytes(inp.raw(inp.len()))
}

/** `None` (the unit type) is nothing on the wire. */
object UnitCodec : WireCodec<Unit> {
    override fun enc(v: Unit, out: WireOut) {}
    override fun dec(inp: WireIn) = Unit
}

class ListCodec<T>(private val elem: WireCodec<T>) : WireCodec<List<T>> {
    override fun enc(v: List<T>, out: WireOut) {
        out.i32(v.size)
        for (e in v) elem.enc(e, out)
    }
    override fun dec(inp: WireIn): List<T> {
        val n = inp.len()
        val out = ArrayList<T>(n)
        for (i in 0 until n) out.add(elem.dec(inp))
        return out
    }
}

/** A `Mut List<T>` decodes to a mutable list; the bytes are a list's. */
class MutListCodec<T>(private val elem: WireCodec<T>) : WireCodec<MutableList<T>> {
    override fun enc(v: MutableList<T>, out: WireOut) {
        out.i32(v.size)
        for (e in v) elem.enc(e, out)
    }
    override fun dec(inp: WireIn): MutableList<T> {
        val n = inp.len()
        val out = ArrayList<T>(n)
        for (i in 0 until n) out.add(elem.dec(inp))
        return out
    }
}

/** An optional — `T?`, or a union with a `None` arm — is a presence byte. */
class OptCodec<T : Any>(private val inner: WireCodec<T>) : WireCodec<T?> {
    override fun enc(v: T?, out: WireOut) {
        if (v == null) {
            out.u8(0)
        } else {
            out.u8(1)
            inner.enc(v, out)
        }
    }
    override fun dec(inp: WireIn): T? = when (inp.u8()) {
        0 -> null
        1 -> inner.dec(inp)
        else -> throw WireError()
    }
}

class PairCodec<A, B>(private val a: WireCodec<A>, private val b: WireCodec<B>) : WireCodec<Pair<A, B>> {
    override fun enc(v: Pair<A, B>, out: WireOut) {
        a.enc(v.first, out); b.enc(v.second, out)
    }
    override fun dec(inp: WireIn): Pair<A, B> = Pair(a.dec(inp), b.dec(inp))
}

class TripleCodec<A, B, C>(
    private val a: WireCodec<A>,
    private val b: WireCodec<B>,
    private val c: WireCodec<C>,
) : WireCodec<Triple<A, B, C>> {
    override fun enc(v: Triple<A, B, C>, out: WireOut) {
        a.enc(v.first, out); b.enc(v.second, out); c.enc(v.third, out)
    }
    override fun dec(inp: WireIn): Triple<A, B, C> = Triple(a.dec(inp), b.dec(inp), c.dec(inp))
}

// ===== hoststreams.kt =====
// Generated by the Salvo compiler: the host stream table [stream-table].
//
// The process's host streams — the Rust runtime's table, mirrored: one table
// every host producer registers into (a file `HostRawFs` opened, a network
// body, a buffer) and `stream.host`'s `HostRawStreams` reads, whoever
// registered it. Shipped with the scheduler, whose handle counter it draws
// from (`SalvoStreams.freshHandle()` [stream-handle]). The table is locked only
// to find an entry, and each entry is its own monitor, so a slow read of one
// stream never blocks another.
package salvo

/** [stream-table] A failure recorded against a stream, in host terms. */
sealed class SalvoFault {
    object Utf8 : SalvoFault()
    class Failed(val message: String) : SalvoFault()
}

/**
 * [stream-table] A readable host stream. [position] counts bytes *handed to
 * the reader* — bytes read ahead for a line count only once consumed — so a
 * file's position is exactly the offset `open_read_at` takes.
 */
class SalvoIn(val source: String, val input: java.io.InputStream, var position: Long) {
    private var ahead = ByteArray(0)
    var failed: SalvoFault? = null

    private fun fault(e: Exception): SalvoFault {
        val f = SalvoFault.Failed(e.message ?: e.toString())
        failed = f
        return f
    }

    /** Records a strict-decode failure and answers it. */
    fun utf8Failed(): SalvoFault {
        failed = SalvoFault.Utf8
        return SalvoFault.Utf8
    }

    private fun take(n: Int): ByteArray {
        val out = ahead.copyOfRange(0, n)
        ahead = ahead.copyOfRange(n, ahead.size)
        position += n.toLong()
        return out
    }

    /** The next line's bytes without `\n` or `\r\n`, or null at the end. Throws [SalvoFaultException]. */
    fun readLineBytes(): ByteArray? {
        failed?.let { throw SalvoFaultException(it) }
        while (true) {
            val at = ahead.indexOf(10.toByte())
            if (at >= 0) {
                var line = take(at + 1)
                line = line.copyOf(line.size - 1)
                if (line.isNotEmpty() && line[line.size - 1] == 13.toByte()) {
                    line = line.copyOf(line.size - 1)
                }
                return line
            }
            val chunk = ByteArray(8192)
            val n = try {
                input.read(chunk)
            } catch (e: Exception) {
                throw SalvoFaultException(fault(e))
            }
            if (n < 0) {
                if (ahead.isEmpty()) return null
                return take(ahead.size)
            }
            ahead += chunk.copyOf(n)
        }
    }

    /** Everything left. Throws [SalvoFaultException]. */
    fun readAllBytes(): ByteArray {
        failed?.let { throw SalvoFaultException(it) }
        val rest = try {
            input.readBytes()
        } catch (e: Exception) {
            throw SalvoFaultException(fault(e))
        }
        val out = ahead + rest
        ahead = ByteArray(0)
        position += out.size.toLong()
        return out
    }

    /** Up to [max] bytes; empty at the end. Throws [SalvoFaultException]. */
    fun readUpTo(max: Int): ByteArray {
        failed?.let { throw SalvoFaultException(it) }
        if (max <= 0) return ByteArray(0)
        if (ahead.isNotEmpty()) {
            return take(minOf(max, ahead.size))
        }
        val scratch = ByteArray(max)
        val n = try {
            input.read(scratch, 0, max)
        } catch (e: Exception) {
            throw SalvoFaultException(fault(e))
        }
        if (n <= 0) return ByteArray(0)
        position += n.toLong()
        return scratch.copyOf(n)
    }

    fun closeInput() {
        try {
            input.close()
        } catch (e: Exception) {
            if (failed == null) fault(e)
        }
    }
}

/** [stream-table] A readable stream's recorded failure, as an exception the stream host maps. */
class SalvoFaultException(val fault: SalvoFault) : Exception()

/** [stream-table] A writable host stream; [position] counts bytes accepted. */
class SalvoOut(val source: String, val output: java.io.OutputStream, var position: Long) {
    var failed: SalvoFault? = null

    /** Accepts [data], answering how many bytes: 0 once a failure is recorded. */
    fun writeData(data: ByteArray): Long {
        if (failed != null) return 0
        return try {
            output.write(data)
            position += data.size.toLong()
            data.size.toLong()
        } catch (e: Exception) {
            failed = SalvoFault.Failed(e.message ?: e.toString())
            0
        }
    }

    /** Pushes accepted bytes on, answering (and clearing) a recorded failure. */
    fun flushData(): SalvoFault? {
        try {
            output.flush()
        } catch (e: Exception) {
            failed = SalvoFault.Failed(e.message ?: e.toString())
        }
        val f = failed
        failed = null
        return f
    }

    fun closeOutput(): SalvoFault? {
        val f = flushData()
        try {
            output.close()
        } catch (e: Exception) {
            return f ?: SalvoFault.Failed(e.message ?: e.toString())
        }
        return f
    }
}

object SalvoStreams {
    private val nextHandle = java.util.concurrent.atomic.AtomicLong(1)

    /**
     * [stream-handle] A handle for a new stream, unique in the process: every
     * stream table, host and in-memory, draws from this counter, so a handle
     * reaching the wrong table is unknown there rather than another stream's.
     */
    fun freshHandle(): Long = nextHandle.getAndIncrement()

    private val ins = HashMap<Long, SalvoIn>()
    private val outs = HashMap<Long, SalvoOut>()

    /**
     * [stream-provider] A handle this table never minted is another provider's
     * stream — a `MemFs` token handed to the host — a program bug, which traps.
     */
    private fun notOurs(handle: Long): Nothing =
        error(
            "salvo: stream handle $handle is not the host's: a stream belongs to the provider " +
                "that minted it [stream-provider]"
        )

    fun registerIn(source: String, input: java.io.InputStream, position: Long): Long {
        val handle = SalvoStreams.freshHandle()
        synchronized(this) { ins[handle] = SalvoIn(source, input, position) }
        return handle
    }

    fun registerOut(source: String, output: java.io.OutputStream, position: Long): Long {
        val handle = SalvoStreams.freshHandle()
        synchronized(this) { outs[handle] = SalvoOut(source, output, position) }
        return handle
    }

    fun inStream(handle: Long): SalvoIn = synchronized(this) { ins[handle] } ?: notOurs(handle)
    fun outStream(handle: Long): SalvoOut = synchronized(this) { outs[handle] } ?: notOurs(handle)
    fun takeIn(handle: Long): SalvoIn = synchronized(this) { ins.remove(handle) } ?: notOurs(handle)
    fun takeOut(handle: Long): SalvoOut = synchronized(this) { outs.remove(handle) } ?: notOurs(handle)
}

// ===== hosttime.kt =====
// Generated by the Salvo compiler: the two clock readings std's `time`
// module is built on [time-types] [kt-time].
//
// The mirror of the Rust backend's `time.rs`, answering the same numbers: a
// `Long` of nanoseconds in both cases, since `Instant`, `Tick` and `Duration`
// each carry exactly one.
package salvo

object SalvoTime {
    // [time-ticker] The monotonic clock, in nanoseconds from an arbitrary
    // origin. `System.nanoTime()` is documented as "some fixed but arbitrary
    // origin time", which is exactly the language's claim about a `Tick`: two
    // readings subtract into a real span, one on its own means nothing.
    //
    // Unlike the Rust side this needs no process-wide base, because the JVM's
    // reading is already a number on one timeline. The *origin* therefore
    // differs between the backends — as the language says it may — while
    // every `between` answers the same span.
    fun monoNanos(): Long = System.nanoTime()

    // [time-clock] The wall clock, in nanoseconds since the Unix epoch.
    // `java.time.Instant` carries seconds plus a nanosecond field, so this is
    // the precise reading rather than `currentTimeMillis()` scaled up.
    fun epochNanos(): Long {
        val now = java.time.Instant.now()
        return now.epochSecond * 1_000_000_000L + now.nano.toLong()
    }
}
