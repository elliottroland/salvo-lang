// ===== core/console.kt =====
package salvo

interface Console {
    fun print(message: String)
}

class StdOutConsole : Console {
    override fun print(message: String) {
        kotlin.io.print(message)
    }
}

fun println(console: Console, message: String) {
    console.print(message)
    console.print("\n")
}

// ===== main.kt =====
package salvo

data class Person(
    val name: String,
    val surname: String? = null,
    val age: Int,
)

fun Surname_qualifies(person: Person): Boolean {
    return person.surname != null
}

fun Positive_qualifies(int: Int): Boolean {
    return int > 0
}

fun<T> ok(value: T): T {
    return value
}

fun<T> err(value: T): T {
    return value
}

fun full_name(person: Person): String {
    return person.name
}

fun full_name__Surname(person: Person): String {
    return "${person.name} ${(person.surname as String)}"
}

fun describe(console: Console, person: Person) {
    if (Surname_qualifies(person)) {
        println(console, full_name__Surname(person))
    } else {
        println(console, full_name(person))
    }
}

fun check(console: Console, n: Int) {
    if (Positive_qualifies(n)) {
        println(console, "$n is positive")
    } else {
        println(console, "$n is not positive")
    }
}

fun main() {
    val console: Console = StdOutConsole()
    describe(console, Person(name = "Roland", surname = "Elliott", age = 36))
    describe(console, Person(name = "Anon", age = 3))
    check(console, 5)
    check(console, -2)
    var current: Int? = 3
    while (current != null) {
        val c = current as Int
        println(console, "tick $c")
        current = if (c > 1) {
c - 1
} else {
null
}
    }
    val inner: Union2<String, Int> = U2_1<String, Int>(ok("yes"))
    val nested: Union2<Union2<String, Int>, Boolean> = U2_1<Union2<String, Int>, Boolean>(ok(inner))
    if (nested is U2_1<*, *>) {
        val back: Union2<String, Int> = (nested.value as Union2<String, Int>)
        if (back is U2_1<*, *>) {
            println(console, "inner ok: ${(back.value as String)}")
        }
    }
}

// ===== unions.kt =====
// Generated by the Salvo compiler: sealed wrappers for union types.
package salvo

sealed interface Union2<out T1, out T2> {
    val value: Any?
}
data class U2_1<out T1, out T2>(override val value: T1) : Union2<T1, T2>
data class U2_2<out T1, out T2>(override val value: T2) : Union2<T1, T2>
