        return Union2.U2<K, Finished>(finished())
    }
    p.at = p.at + 1
    return Union2.U1<K, Finished>(emitted(key))
}

fun<K, V> NonEmpty_qualifies(map: Map<K, V>): Boolean {
    return map.size > 0
}

