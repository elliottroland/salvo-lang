// ===== core/console.kt =====
package salvo.core.console

interface Console {
    fun print(message: String)
}

class StdOutConsole : Console {
    override fun print(message: String) {
        kotlin.io.print(message)
    }
}

fun println(console: Console, message: String) {
    console.print(message)
    console.print("\n")
}

// ===== main.kt =====
package salvo.main

import salvo.*
import salvo.core.console.*

fun<T> ok(value: T): T {
    return value
}

fun<T> err(value: T): T {
    return value
}

fun parse_age(input: Int): Union2<Int, String> {
    if (input >= 0) {
        return U2_1<Int, String>(ok(input))
    }
    return U2_2<Int, String>(err("negative age"))
}

fun describe(result: Union2<Int, String>): String {
    val msg = when (result) {
    is U2_1<*, *> -> {
"age ${(result.value as Int)}"
    }
    is U2_2<*, *> -> {
"error: ${(result.value as String)}"
    }
}
    return msg
}

fun main() {
    val console: Console = StdOutConsole()
    val good = parse_age(36)
    println(console, describe(good))
    val bad = parse_age(-1)
    println(console, describe(bad))
    val precise: Union3<String, String, Boolean> = U3_1<String, String, Boolean>(ok("yes"))
    if (precise is U3_2<*, *, *>) {
        println(console, "err str: ${(precise.value as String)}")
    } else if (precise is U3_1<*, *, *>) {
        println(console, "ok: ${(precise.value as String)}")
    } else {
        println(console, "err bool: ${(precise.value as Boolean)}")
    }
    val value = when (good) {
    is U2_1<*, *> -> {
(good.value as Int)
    }
    is U2_2<*, *> -> {
return
    }
}
    println(console, "value plus one is ${value + 1}")
}

// ===== unions.kt =====
// Generated by the Salvo compiler: sealed wrappers for union types.
package salvo

sealed interface Union2<out T1, out T2> {
    val value: Any?
}
data class U2_1<out T1, out T2>(override val value: T1) : Union2<T1, T2>
data class U2_2<out T1, out T2>(override val value: T2) : Union2<T1, T2>

sealed interface Union3<out T1, out T2, out T3> {
    val value: Any?
}
data class U3_1<out T1, out T2, out T3>(override val value: T1) : Union3<T1, T2, T3>
data class U3_2<out T1, out T2, out T3>(override val value: T2) : Union3<T1, T2, T3>
data class U3_3<out T1, out T2, out T3>(override val value: T3) : Union3<T1, T2, T3>
