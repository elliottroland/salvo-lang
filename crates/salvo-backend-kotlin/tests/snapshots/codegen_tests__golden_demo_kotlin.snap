fun main() {
    val __use_1: salvo.core.console.__Platform_StdOutConsole = salvo.core.console.__Platform_StdOutConsole()
    val __handle_2: salvo.core.console.Console = __use_1
    val person: Person = Person(name = "Roland", surname = "Elliott", age = 36)
    greet(__handle_2, person)
    val anon: Person = run {
        val __spread_3: Person = person
        Person(name = __spread_3.name, surname = null, age = __spread_3.age)
    }
    greet(__handle_2, anon)
