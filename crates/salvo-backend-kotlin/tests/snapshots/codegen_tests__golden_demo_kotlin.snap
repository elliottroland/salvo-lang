package salvo.main

import salvo.*

data class Person(
    val name: String,
    val surname: String? = null,
    val age: Int,
)

object __Codec_Person : salvo.WireCodec<Person> {
    override fun enc(v: Person, out: salvo.WireOut) {
        salvo.StrCodec.enc(v.name, out)
        salvo.OptCodec(salvo.StrCodec).enc(v.surname, out)
        salvo.IntCodec.enc(v.age, out)
    }
    override fun dec(inp: salvo.WireIn): Person = Person(salvo.StrCodec.dec(inp), salvo.OptCodec(salvo.StrCodec).dec(inp), salvo.IntCodec.dec(inp))
}

fun fullName(person: Person): String {
    if ((person.surname != null)) {
        val surname: String = person.surname!!
        return "${person.name} ${surname}"
    }
    return person.name
}

@Suppress("UNCHECKED_CAST", "USELESS_CAST", "UNNECESSARY_SAFE_CALL")
fun greet(console: salvo.core.console.Console, person: Person) {
    salvo.core.console.println(console, "Hello, ${fullName(person)}!")
    val __pass_1: __Iter_iter_Upto = iter(upto(1, 4))
    while (true) {
        val __step_2: Union2<Int, salvo.core.iterator.Finished> = next(__pass_1)
        when {
