                val __emitted_3: Int = ((__step_2 as Union2.U1<*, *>).value as Int)
                val i: Int = __emitted_3
                salvo.core.console.println(console, "  ${i}: ${(person.age + i)}")
            }
            else -> {
                break
            }
        }
    }
}

