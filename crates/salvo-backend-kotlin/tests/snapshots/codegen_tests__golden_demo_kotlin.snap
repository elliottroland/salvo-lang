// ===== core/console.kt =====
package salvo.core.console

interface Console {
    fun print(message: String)
}

class StdOutConsole : Console {
    override fun print(message: String) {
        kotlin.io.print(message)
    }
}

fun println(console: Console, message: String) {
    console.print(message)
    console.print("\n")
}

// ===== main.kt =====
package salvo.main

import salvo.*
import salvo.core.console.*

data class Person(
    val name: String,
    val surname: String? = null,
    val age: Int,
)

fun full_name(person: Person): String {
    if (person.surname != null) {
        val surname = person.surname as String
        return "${person.name} $surname"
    }
    return person.name
}

fun greet(console: Console, person: Person) {
    println(console, "Hello, ${full_name(person)}!")
    for (i in range(1, 4)) {
        println(console, "  $i: ${person.age + i}")
    }
}

fun range(start: Int, end: Int): Iterable<Int> {
    return Iterable<Int> { __Pass_range(start, end) }
}

private class __Pass_range(private var start: Int, private var end: Int) : SalvoPass<Int>() {
    private var i: Int = 0
    private var __state: Int = 0

    override fun __advance(): Boolean {
        while (true) {
            when (__state) {
                0 -> {
                    i = start
                    __state = 1
                    continue
                }
                1 -> {
                    if (!(i++ < end)) {
                        __state = 2
                        continue
                    }
                    __current = i - 1
                    __state = 1
                    return true
                }
                2 -> {
                    __state = 2
                    return false
                }
                else -> return false
            }
        }
    }

    fun __close() {
        __state = 2
    }
}

fun main() {
    val console: Console = StdOutConsole()
    val person = Person(name = "Roland", surname = "Elliott", age = 36)
    greet(console, person)
    val anon = person.copy(surname = null)
    greet(console, anon)
    val names = listOf<String>("a", "b")
    println(console, "first: ${names.firstOrNull()!!}")
    val mut_names = mutableListOf<String>("x")
    mut_names.add("y")
    println(console, "size: ${mut_names.size}")
}

// ===== iter.kt =====
// Generated by the Salvo compiler: the base class of a generated pass.
package salvo

/// One pass over a `yield` function's body [iter-generator]: the compiler
/// writes a subclass whose `__advance` is the body as a flat state machine,
/// storing each element in `__current`.
///
/// The lookahead is what makes it a Kotlin `Iterator`: the machine reports
/// "there is another element" and hands it over in one step, while
/// `hasNext`/`next` are two. `__current` is `Any?` rather than `T` so that a
/// null element is an element like any other — `T` may itself be nullable,
/// which is exactly why the protocol tags the end (`Emitted T | Finished`)
/// instead of using absence to mean it.
abstract class SalvoPass<T> : Iterator<T> {
    protected var __current: Any? = null
    private var __ready = false
    private var __done = false

    protected abstract fun __advance(): Boolean

    override fun hasNext(): Boolean {
        if (__done) {
            return false
        }
        if (!__ready) {
            __ready = __advance()
            if (!__ready) {
                __done = true
            }
        }
        return __ready
    }

    @Suppress("UNCHECKED_CAST")
    override fun next(): T {
        if (!hasNext()) {
            throw NoSuchElementException("the pass is finished")
        }
        __ready = false
        return __current as T
    }
}
