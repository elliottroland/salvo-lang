module main

fn verdict@main(lent started: Tick, lent at: Tick, lent budget: Duration) -> Str {
  bind#1 let took: Duration = call between(Tick, Tick)@std.time(read started, read at)
  branch#2 cond#0 (call cmp(Duration, Duration)@std.time(read took, read budget) > 0) {
    return concat("late by ", call to_str@std.time(call minus(Duration, Duration)@std.time(read took, read budget)))
  }
  return concat("in time, ", call to_str@std.time(call minus(Duration, Duration)@std.time(read budget, read took)), " to spare")
}

fn overdue@main(lent ticker: Ticker; lent started: Tick, lent budget: Duration) -> Bool {
  return (call cmp(Duration, Duration)@std.time(call elapsed@std.time(read ticker, read started), read budget) > 0)
}

impl SteppingTicker(lent step: Duration) of Ticker stateful {
  state at: Long = 0L
  fn tick() -> Tick {
    assign at = (read at + read step.nanos)
    return construct Tick { nanos: read at }
  }
}

actor interface Session {
  send fn open(moved started: Tick, moved budget: Duration, moved out: Reply<Str>) -> None
  send fn expire(moved started: Tick, moved budget: Duration, moved out: Reply<Str>, moved f: Fired) -> None
}

impl Sessions() of Session@main deps [Timer] stateful {
  mailbox construct Mailbox { capacity: 8 }
  fn open(lent started: Tick, lent budget: Duration, lent out: Reply<Str>) -> None {
    obligation release [out]
    member after@Timer(read __dep0, call plus(Duration, Duration)@std.time(read budget, call seconds@std.time(1L)), replyto expire(!read started, !read budget, !read out))
  }
  fn expire(lent started: Tick, lent budget: Duration, lent out: Reply<Str>, lent f: Fired) -> None {
    obligation release [out]
    call send@std.core.actor<Str>(!read out, call verdict@main(read started, read f.at, read budget))
  }
}

impl TestTicker(lent timer: eff[Timer]) of Ticker {
  fn tick() -> Tick {
    bind#1 let fired: Fired = waitfor answer: Reply<Fired> {
      obligation gain [answer]
      obligation release [answer]
      send after@Timer(read timer, call nanos@std.time(0L), !read answer)
    }
    return read fired.at
  }
}

actor interface Sleeper {
  send fn nap(moved wait: Duration, moved out: Reply<Str>) -> None
  send fn woke(moved started: Tick, moved out: Reply<Str>, moved f: Fired) -> None
}

impl Napping() of Sleeper@main deps [Timer, Ticker] stateful {
  mailbox construct Mailbox { capacity: 8 }
  fn nap(lent wait: Duration, lent out: Reply<Str>) -> None {
    obligation release [out]
    member after@Timer(read __dep0, !read wait, replyto woke(member tick@Ticker(read __dep1), !read out))
  }
  fn woke(lent started: Tick, lent out: Reply<Str>, lent f: Fired) -> None {
    obligation release [out]
    call send@std.core.actor<Str>(!read out, concat("napped ", call to_str@std.time(call elapsed@std.time(read __dep1, read started))))
  }
}

fn main@main() -> None {
  bind#1 let __use~1: StdConsole = construct StdConsole { }
  bind#2 let __handle~2: Console = read __use~1
  bind#3 let budget: Duration = call millis@std.time(1500L)
  call println@std.core.console(read __handle~2, concat("budget ", call to_str@std.time(read budget), ", doubled ", call to_str@std.time(call times@std.time(read budget, 2L)), ", in millis ", call to_str(Long)@std.core.basic(call to_millis@std.time(read budget))))
  bind#4 let stamp: Instant = call epoch_milli@std.time(1700000000000L)
  call println@std.core.console(read __handle~2, concat("stamp ", call to_str(Long)@std.core.basic(call to_epoch_second@std.time(read stamp)), "s, a minute later ", call to_str(Long)@std.core.basic(call to_epoch_second@std.time(call plus(Instant, Duration)@std.time(read stamp, call minutes@std.time(1L)))), "s"))
  bind#5 let __use~3: DefaultClock = construct DefaultClock { }
  bind#6 let __handle~4: Clock = handle[Clock](read __use~3)
  bind#7 let __use~5: DefaultTicker = construct DefaultTicker { }
  bind#8 let __handle~6: Ticker = handle[Ticker](read __use~5)
  call println@std.core.console(read __handle~2, concat("wall clock is set: ", call to_str(Bool)@std.core.basic((call to_epoch_second@std.time(member now@Clock(read __handle~4)) > 1600000000L))))
  bind#9 let __use~7: SteppingTicker@main = construct SteppingTicker@main { step: call millis@std.time(500L) }
  bind#10 let __handle~8: Ticker = handle[Ticker](read __use~7)
  bind#11 let started: Tick = member tick@Ticker(read __handle~8)
  call println@std.core.console(read __handle~2, concat("overdue after one more read: ", call to_str(Bool)@std.core.basic(call overdue@main(read __handle~8, read started, read budget))))
  call println@std.core.console(read __handle~2, concat("overdue after three: ", call to_str(Bool)@std.core.basic(call overdue@main(read __handle~8, read started, read budget)), " ", call to_str(Bool)@std.core.basic(call overdue@main(read __handle~8, read started, read budget)), " ", call to_str(Bool)@std.core.basic(call overdue@main(read __handle~8, read started, read budget))))
  call println@std.core.console(read __handle~2, call verdict@main(construct Tick { nanos: 0L }, construct Tick { nanos: 1000000000L }, read budget))
  call println@std.core.console(read __handle~2, call verdict@main(construct Tick { nanos: 0L }, construct Tick { nanos: 2000000000L }, read budget))
  bind#12 let p: Pool = call pool(Int)@std.core.actor(1)
  bind#13 let __destructured~9: (eff[Timer], eff[TimerCtl]) = spawn[(eff[Timer], eff[TimerCtl])](construct ManualTime { }, on: read p) serves [Timer, TimerCtl]
  bind#14 let timer: eff[Timer] = !read __destructured~9.0
  bind#15 let ctl: eff[TimerCtl] = !read __destructured~9.1
  bind#16 let sessions: eff[Session@main] = spawn[eff[Session@main]](construct Sessions@main { __dep0: instance_at(read timer) }, on: read p) serves [Session@main]
  bind#17 let outcome: Str = waitfor answer: Reply<Str> {
    obligation gain [answer]
    obligation release [answer]
    send open@Session(read sessions, construct Tick { nanos: 0L }, !read budget, !read answer)
    waitfor settled: Reply<Idle> {
      obligation gain [settled]
      obligation release [settled]
      call on_idle@std.core.actor(read p, !read settled)
    }
    send advance@TimerCtl(read ctl, call millis@std.time(2500L))
  }
  call println@std.core.console(read __handle~2, concat("session: ", read outcome))
  bind#18 let sleeper: eff[Sleeper@main] = spawn[eff[Sleeper@main]](construct Napping@main { __dep0: instance_at(read timer), __dep1: handle[Ticker](construct TestTicker@main { timer: !read timer }) }, on: call thread@std.core.actor()) serves [Sleeper@main]
  bind#19 let napped: Str = waitfor answer: Reply<Str> {
    obligation gain [answer]
    obligation release [answer]
    send nap@Sleeper(read sleeper, call seconds@std.time(2L), !read answer)
    waitfor settled: Reply<Idle> {
      obligation gain [settled]
      obligation release [settled]
      call on_idle@std.core.actor(read p, !read settled)
    }
    send advance@TimerCtl(read ctl, call seconds@std.time(2L))
  }
  call println@std.core.console(read __handle~2, read napped)
}

