fn __dispatch_Sessions_Session(lent_mut __handler: Sessions@main, moved __msg: __Msg_Session@main) -> None {
  switch#1 read __msg {
    arm#0 (arm 0) {
      unpack#2 (started: Tick, budget: Duration, out: Reply<Str>) = __msg as variant 0
      obligation gain [out]
      obligation release [out]
      handler_call open@Session(read __handler, !read started, !read budget, !read out)
    }
    arm#1 (arm 1) {
      unpack#3 (started: Tick, budget: Duration, out: Reply<Str>, f: Fired) = __msg as variant 1
      obligation gain [out]
      obligation release [out]
      handler_call expire@Session(read __handler, !read started, !read budget, !read out, !read f)
    }
  }
}

