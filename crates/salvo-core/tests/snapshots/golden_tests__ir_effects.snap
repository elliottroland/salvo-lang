module main

interface Clock {
  fn now() -> Int
}

impl TickingClock() of Clock@main stateful {
  state tick: Int = 0
  fn now() -> Int {
    assign tick = (read tick + 5)
    return !read tick
  }
}

fn stamp@main(lent clock: Clock@main, lent console: Console; lent label: Str) -> None {
  bind#1 let t: Int = member now@Clock(read clock)
  call banner@main(read console, concat(read label, " at t=", call to_str(Int)@std.core.basic(read t)))
}

fn banner@main(lent console: Console; lent text: Str) -> None {
  call println@std.core.console(read console, concat("   ", read text))
}

interface Logger {
  fn log(lent message: Str) -> None
}

impl PlainLogger() of Logger@main deps [Console] {
  fn log(lent message: Str) -> None {
    call println@std.core.console(read __dep0, concat("   ", read message))
  }
}

impl QuietLogger() of Logger@main {
  fn log(lent message: Str) -> None {
  }
}

impl Stamped() of Logger@main deps [Logger@main, Clock@main] {
  fn log(lent message: Str) -> None {
    member log@Logger(read __dep0, concat("[t=", call to_str(Int)@std.core.basic(member now@Clock(read __dep1)), "] ", read message))
  }
}

impl Numbered() of Logger@main deps [Logger@main] stateful {
  state seen: Int = 0
  fn log(lent message: Str) -> None {
    assign seen = (read seen + 1)
    member log@Logger(read __dep0, concat("#", call to_str(Int)@std.core.basic(read seen), " ", read message))
  }
}

fn work@main(lent logger: Logger@main; lent step: Str) -> None {
  member log@Logger(read logger, read step)
}

fn interception@main(lent logger: Logger@main, lent clock: Clock@main) -> None {
  call work@main(read logger, "4. plain")
  bind#1 let __use~1: Stamped@main = construct Stamped@main { __dep0: read logger, __dep1: read clock }
  bind#2 let __handle~2: Logger@main = handle[Logger@main](read __use~1)
  call work@main(read __handle~2, "4. stamped")
  bind#3 let __use~3: Numbered@main = construct Numbered@main { __dep0: read __handle~2 }
  bind#4 let __handle~4: Logger@main = handle[Logger@main](read __use~3)
  call work@main(read __handle~4, "4. numbered, then stamped")
  call work@main(read __handle~4, "4. and again")
}

fn scoping@main(lent logger: Logger@main) -> None {
  call work@main(read logger, "5. before the block")
  branch#1 cond#0 true {
    bind#2 let __use~1: QuietLogger@main = construct QuietLogger@main { }
    bind#3 let __handle~2: Logger@main = handle[Logger@main](read __use~1)
    call work@main(read __handle~2, "5. this line is swallowed")
  }
  call work@main(read logger, "5. after the block, logging again")
}

interface Audit {
  fn record(lent what: Str) -> None
}

interface Metrics {
  fn record(lent what: Str) -> None
}

impl ConsoleAudit() of Audit@main deps [Console] {
  fn record(lent what: Str) -> None {
    call println@std.core.console(read __dep0, concat("   audit: ", read what))
  }
}

impl ConsoleMetrics() of Metrics@main deps [Console] {
  fn record(lent what: Str) -> None {
    call println@std.core.console(read __dep0, concat("   metric: ", read what))
  }
}

fn audit_only@main(lent audit: Audit@main; lent what: Str) -> None {
  member record@Audit(read audit, read what)
}

fn audit_and_measure@main(lent audit: Audit@main, lent metrics: Metrics@main; lent what: Str) -> None {
  member record@Audit(read audit, read what)
  member record@Metrics(read metrics, read what)
}

interface Setting<T> {
  fn setting(lent copy: (T) -> T) -> T
}

impl Fixed<T>(lent value: T) of Setting@main<T> {
  fn setting(; ?lent copy: (T) -> T) -> T {
    return call local copy(read value)
  }
}

fn settings@main(lent setting: Setting@main<Int>, lent setting__1: Setting@main<Str>, lent console: Console) -> None {
  bind#1 let retries: Int = member setting@Setting(read setting, fn copy@std.core.basic)
  bind#2 let region: Str = member setting@Setting(read setting__1, fn copy@std.core.basic)
  call println@std.core.console(read console, concat("   retries=", call to_str(Int)@std.core.basic(read retries), " region=", read region))
}

fn main@main() -> None {
  bind#1 let __use~1: StdConsole = construct StdConsole { }
  bind#2 let __handle~2: Console = read __use~1
  bind#3 let __use~3: TickingClock@main = construct TickingClock@main { }
  bind#4 let __handle~4: Clock@main = handle[Clock@main](read __use~3)
  call println@std.core.console(read __handle~2, concat("1. the clock reads ", call to_str(Int)@std.core.basic(member now@Clock(read __handle~4)), ", then ", call to_str(Int)@std.core.basic(member now@Clock(read __handle~4))))
  call println@std.core.console(read __handle~2, "2. two effects in one signature:")
  call stamp@main(read __handle~4, read __handle~2, "2. a labelled moment")
  call println@std.core.console(read __handle~2, "3. a logger whose handler needs the console:")
  bind#5 let __use~5: PlainLogger@main = construct PlainLogger@main { __dep0: read __handle~2 }
  bind#6 let __handle~6: Logger@main = handle[Logger@main](read __use~5)
  call work@main(read __handle~6, "3. logged through the console")
  call println@std.core.console(read __handle~2, "4. interception — each `use` wraps the one before it:")
  call interception@main(read __handle~6, read __handle~4)
  call println@std.core.console(read __handle~2, "5. shadowing is not wrapping:")
  call scoping@main(read __handle~6)
  call println@std.core.console(read __handle~2, "6. two effects, one member name:")
  bind#7 let __use~7: ConsoleAudit@main = construct ConsoleAudit@main { __dep0: read __handle~2 }
  bind#8 let __handle~8: Audit@main = handle[Audit@main](read __use~7)
  call audit_only@main(read __handle~8, "6. audited only")
  bind#9 let __use~9: ConsoleMetrics@main = construct ConsoleMetrics@main { __dep0: read __handle~2 }
  bind#10 let __handle~10: Metrics@main = handle[Metrics@main](read __use~9)
  call audit_and_measure@main(read __handle~8, read __handle~10, "6. audited and measured")
  call println@std.core.console(read __handle~2, "7. two instances of one generic effect:")
  bind#11 let __use~11: Fixed@main<Int> = construct Fixed@main<Int> { value: 3 }
  bind#12 let __handle~12: Setting@main<Int> = handle[Setting@main<Int>](read __use~11)
  bind#13 let __use~13: Fixed@main<Str> = construct Fixed@main<Str> { value: "eu-west-1" }
  bind#14 let __handle~14: Setting@main<Str> = handle[Setting@main<Str>](read __use~13)
  call settings@main(read __handle~12, read __handle~14, read __handle~2)
}
