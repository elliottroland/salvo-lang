  }
  call println@std.core.console(read console, concat("1. string: ", drop_mut(read letters)))
  bind#5 let arr: Int[] = call array_of@std.core.array<Int>(array[Int[]](10, 20, 30))
  bind#6 let from_array: Int = 0
  foreach#7 n: Int in read arr {
    assign from_array = (read from_array + read n)
  }
  call println@std.core.console(read console, concat("1. array sums to ", call to_str(Int)@std.core.basic(read from_array)))
}

struct Countdown canbe Mut wire {
