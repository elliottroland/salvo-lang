fn take@main(lent console: Console; lent_mut p: Mut Countdown@main, lent count: Int) -> None {
  bind#1 let seen: Int = 0
  loop#2 {
    bind#3 let __step~2: Int | Finished = call next(Mut Countdown)@main(read p)
