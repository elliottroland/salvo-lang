// main.sv
// Iteration, in every form Salvo has.
//
// There is no iterator type and no iteration protocol built into the
// compiler. An **iterator struct** is an ordinary struct that declares
// `: Next<self, T>` and has a `next`; `for` is sugar for calling that `next`
// until it answers `Finished`. Everything below is that one rule, seen from
// seven angles.

// ===== 1. a container, driven natively =====
//
// `for` straight over a `List`, an array or a `Str` is the shape the backends
// keep a native loop for: no iterator is allocated and the container is not
// consumed, so `xs` is still readable after the loop.
fn describe_container(xs: List<Int>) [Console] -> None => xs {
    let sum: Int = 0
    for n in xs {
        sum = plus@std.core.basic(sum, n)
    }
    println@std.core.console("1. list of ${to_str@std.core.basic(size@std.core.list<Int>(xs))} sums to ${to_str@std.core.basic(sum)}")

    let letters: Mut Str = Mut Str()
    for c in "salvo" {
        append@std.core.string(letters, "${to_str@std.core.basic(c)}.")
    }
    println@std.core.console("1. string: ${to_str@std.core.string(letters#{as Str})}")

    let arr: Int[] = array_of@std.core.array<Int>(10, 20, 30)
    let from_array: Int = 0
    for n in arr {
        from_array = plus@std.core.basic(from_array, n)
    }
    println@std.core.console("1. array sums to ${to_str@std.core.basic(from_array)}")
}

// ===== 2. an iterator struct of your own, written out =====
//
// The manual form: the position is a field, `next` is an ordinary function,
// and the struct says what it yields. This is what reads two sources at once
// or wants explicit control of its state — and it is also what `iter(xs)`
// hands back for a `List`. Write it out like this when the iterator needs a
// *name*: to store it in a field, to hand it to a function, to zip two of
// them.
struct Countdown : Next<self, Int> canbe Mut {
    // The next value to emit; the iterator is finished when it reaches zero.
    at: Int
}

fn countdown(from: Int) -> Mut Countdown {
    return Mut Countdown { at: from }
}

// Advancing is a mutation of the position, which is why the parameter is
// `Mut` and is handed back with `=> p: Mut`.
fn next(p: Mut Countdown) -> Emitted Int | Finished => p: Mut {
    if cmp@std.core.basic(p.at, 0) <= 0 {
        return finished@std.core.iterator()#{as Emitted Int | Finished}
    }
    let now: Int = copy@std.core.basic<Int>(p.at)
    p.at = minus@std.core.basic(p.at, 1)
    return emitted@std.core.iterator<Int>(now)#{as Emitted Int | Finished}
}

// A second step over the same struct, under another name. Only `next` is the
// canonical one `for p in …` drives; this one is driven by naming the call:
// `for n in skip(p)`.
fn skip(p: Mut Countdown) -> Emitted Int | Finished => p: Mut {
    if cmp@std.core.basic(p.at, 1) <= 0 {
        return finished@std.core.iterator()#{as Emitted Int | Finished}
    }
    let now: Int = copy@std.core.basic<Int>(p.at)
    p.at = minus@std.core.basic(p.at, 2)
    return emitted@std.core.iterator<Int>(now)#{as Emitted Int | Finished}
}

// An iterator is a value, so it can be driven in stages: this loop leaves the
// iterator where the `break` found it, and the caller carries on from there.
fn take(p: Mut Countdown, count: Int) [Console] -> None => p: Mut {
    let seen: Int = 0
    for n in p #{next@main} {
        println@std.core.console("2. got ${to_str@std.core.basic(n)}")
        seen = plus@std.core.basic(seen, 1)
        if eq@std.core.basic(seen, count) {
            break
        }
    }
}

// ===== 2b. the same thing, with the struct generated: `iter fn` =====
//
// An `iter fn` is the same hand-written `next` with the boilerplate removed:
// the declaration is the *minter*, under any name and with any parameters, the
// `state Halving { … }` block names the iterator struct and declares its own
// fields, and the body is its `next`. The compiler writes the struct, which
// holds the parameters beside the state.
//
// Nothing suspends, so there is no state machine: the body *is* the `next`.
iter fn halving(start: Int) -> Emitted Int | Finished {
    state Halving {
        // Evaluated once, when the iterator is minted, and readable and
        // writable for the rest of its life. The parameters are read-only.
        at: Int = start
    }
    if cmp@std.core.basic(at, 0) <= 0 {
        return finished@std.core.iterator()#{as Emitted Int | Finished}
    }
    let now: Int = copy@std.core.basic<Int>(at)
    at = divide@std.core.basic(at, 2)
    return emitted@std.core.iterator<Int>(now)#{as Emitted Int | Finished}
}

// The struct is an ordinary type, so a fn handing one out names it.
fn halving_from_ten() -> Mut Halving {
    return halving@main(10)
}

// ===== 2c. a source: `Iter` =====
//
// A type becomes a *source* — something `for` mints an iterator from — by
// declaring `: Iter<self, It, T>`, naming its iterator struct, and an `iter`
// over it. The `iter fn` named `iter` is the canonical minter the obligation
// asks for, and its `state` names the struct.
struct Bag : Iter<self, BagIter, Int> {
    items: List<Int>
}

iter fn iter(bag: Bag) -> Emitted Int | Finished {
    state BagIter {
        at: Int = 0
    }
    let e: Int? = get@std.core.list<Int>(bag.items, at)
    if e is None {
        return finished@std.core.iterator()#{as Emitted Int | Finished}
    }
    at = plus@std.core.basic(at, 1)
    return emitted@std.core.iterator<Int>(copy@std.core.basic<Int>(e#{narrowed from Int?}))#{as Emitted Int | Finished}
}

// ===== 3. an effectful iterator, and an unbounded one =====
//
// A `next` is an ordinary function, so effects are ordinary effects: declare
// them and the `for` that drives supplies the handler, once per turn.
iter fn fibs(count: Int) [Console] -> Emitted Int | Finished {
    state Fibs {
        a: Int = 0,
        b: Int = 1,
        made: Int = 0
    }
    if cmp@std.core.basic(made, count) >= 0 {
        println@std.core.console("3. finished")
        return finished@std.core.iterator()#{as Emitted Int | Finished}
    }
    let now: Int = copy@std.core.basic<Int>(a)
    let sum: Int = plus@std.core.basic(a, b)
    a = copy@std.core.basic<Int>(b)
    b = copy@std.core.basic<Int>(sum)
    made = plus@std.core.basic(made, 1)
    return emitted@std.core.iterator<Int>(now)#{as Emitted Int | Finished}
}

// Nothing runs until a consumer pulls, so an unbounded iterator is an ordinary
// thing to write: the `break` below is what ends it.
iter fn naturals(from: Int) -> Emitted Int | Finished {
    state Naturals {
        at: Int = from
    }
    let now: Int = copy@std.core.basic<Int>(at)
    at = plus@std.core.basic(at, 1)
    return emitted@std.core.iterator<Int>(now)#{as Emitted Int | Finished}
}

// ===== 4. combinators of your own =====
//
// `?Next<It, T>` is a spread of implicit parameters, not a bound and not a
// trait: it asks for the `next` that fits the subject, and the call site fills
// it. That spread is also the declaration `for` reads, so a generic iterator
// is driven exactly like a named one.
fn sum_of<It>(it: Mut It, ?Next<It, Int>) -> Int => it: Mut {
    let total: Int = 0
    for n in it #{local next} {
        total = plus@std.core.basic(total, n)
    }
    return total
}

// `?Iter<C, It, T>` is the same over a *source*: it brings in the `iter` that
// mints an `It` and the `next` that drives it, so a combinator can take the
// container itself — a `Bag`, a `List`, anything with an `iter`.
fn total<C, It>(c: C, ?Iter<C, It, Int>) -> Int => c {
    let total: Int = 0
    for n in c #{local iter, local next} {
        total = plus@std.core.basic(total, n)
    }
    return total
}

// Any iterator struct emitting `Int`: a generic with its `?Next` spread, so a
// hand-written struct and an `iter fn`'s both fit.
fn first<It>(it: Mut It, ?Next<It, Int>) -> Int => it: Mut {
    for n in it #{local next} {
        return n
    }
    return -1
}

fn main() [use] {
    use StdConsole()

    let xs: NonEmpty List<Int> = List@std.core.list<Int>(1, 2, 3, 4)
    describe_container@main(xs)

    // 2. a hand-written iterator, driven in two stages, then through a step
    // under another name: `for n in skip(p)` re-invokes the call each turn.
    let p: Mut Countdown@main = countdown@main(5)
    take@main(p, 2)
    println@std.core.console("2. rest sums to ${to_str@std.core.basic(sum_of@main<Countdown@main>(p, next = next@main))}")
    let q: Mut Countdown@main = countdown@main(6)
    for n in skip@main(q) {
        println@std.core.console("2. skip ${to_str@std.core.basic(n)}")
    }

    // 2b. the generated iterator: one declaration, and `halving(20)` mints one
    // — driven straight away, or held and driven by anything that takes one.
    for n in halving@main(20) #{next@main} {
        println@std.core.console("2b. halving ${to_str@std.core.basic(n)}")
    }
    let hp: Mut Halving@main = halving@main(20)
    println@std.core.console("2b. summed from a held iterator: ${to_str@std.core.basic(sum_of@main<Halving@main>(hp, next = next@main))}")
    println@std.core.console("2b. first from a fn returning one: ${to_str@std.core.basic(first@main<Halving@main>(halving_from_ten@main(), next = next@main))}")

    // 2c. a source: `for` over it mints with its `iter`, and so does a
    // combinator over any source.
    let bag: Bag@main = Bag { items: List@std.core.list<Int>(7, 8) }
    for n in bag #{iter@main, next@main} {
        println@std.core.console("2c. bag ${to_str@std.core.basic(n)}")
    }
    println@std.core.console("2c. total of a bag ${to_str@std.core.basic(total@main<Bag@main, BagIter@main>(bag, iter = iter@main, next = next@main))}, of a list ${to_str@std.core.basic(total@main<NonEmpty List<Int>, ListIter<Int>>(xs, iter = iter@std.core.list, next = next@std.core.list))}")

    // 3. an effectful iterator: `for` supplies the handler per turn. It cannot
    // fill a *pure* `?Next` position, so a combinator over it would have to
    // declare `[Console]` too — the ordinary effect rule.
    for n in fibs@main(6) #{next@main} {
        println@std.core.console("3. fib ${to_str@std.core.basic(n)}")
    }

    // An unbounded one, stopped by the consumer.
    for n in naturals@main(10) #{next@main} {
        if cmp@std.core.basic(n, 12) > 0 {
            break
        }
        println@std.core.console("3. natural ${to_str@std.core.basic(n)}")
    }

    // ===== 5. the sequence functions =====
    //
    // `map`/`filter`/`reduce` are eager and take an *iterator*: a container is
    // iterated by writing its `iter`. A `List` has a fast path under the same
    // name, which is why `map(xs, f)` still reads well.
    let doubled: Mut List<Int> = map@std.core.seq<Int, Int, ()>(xs, (n: Int) -> times@std.core.basic(n, 2))
    let odd: Mut List<Int> = filter@std.core.seq<Int, ()>(xs, (n: Int) -> eq@std.core.basic(n % 2, 1))
    let total: Int = reduce@std.core.seq<Int, Int, ()>(xs, 0, (acc: Int, n: Int) -> plus@std.core.basic(acc, n))
    println@std.core.console("5. list: ${to_str@std.core.basic(size@std.core.list<Int>(doubled#{as List<Int>}))} doubled, ${to_str@std.core.basic(size@std.core.list<Int>(odd#{as List<Int>}))} odd, total ${to_str@std.core.basic(total)}")

    let words: NonEmpty List<Str> = List@std.core.list<Str>("ann", "bo", "carol")
    let lengths: Mut List<Int> = map@std.core.seq<ListIter<Str>, proj Str, Int, ()>(iter@std.core.list<Str>(words), (w: proj Str) -> size@std.core.string(w#{as Str}), next = next@std.core.list)
    println@std.core.console("5. lengths: ${to_str@std.core.basic(reduce@std.core.seq<ListIter<Int>, Int, Int, ()>(iter@std.core.list<Int>(lengths#{as List<Int>}), 0, (acc: Int, n: Int) -> plus@std.core.basic(acc, n), next = next@std.core.list))}")

    // `filter` returns a *view* of the elements it keeps, so what it walks
    // has to outlive the result: a literal would die at the end of the line.
    let word: Str = "iteration"
    let vowels: Mut List<Char> = filter@std.core.seq<StrIter, Char, ()>(iter@std.core.string(word), (c: Char) -> eq@std.core.basic(c, 'i') || eq@std.core.basic(c, 'o'), next = next@std.core.string)
    println@std.core.console("5. vowels: ${to_str@std.core.basic(size@std.core.list<Char>(vowels#{as List<Char>}))}")

    // An `iter fn`'s iterator composes with them exactly like a container's.
    println@std.core.console("5. halving total ${to_str@std.core.basic(reduce@std.core.seq<Halving@main, Int, Int, ()>(halving@main(20), 0, (acc: Int, n: Int) -> plus@std.core.basic(acc, n), next = next@main))}")

    // ===== 6. mapping into a collection you provide =====
    //
    // `map_to` maps into a collection you provide and hands it back, reached
    // through an `add` the call site resolves — so the destination need not be
    // a `List`.
    let collected: Mut List<Int> = map_to@std.core.seq<List<Int>, Countdown@main, Int, Int>(Mut List<Int>(), countdown@main(3), (n: Int) -> times@std.core.basic(n, 10), add = add@std.core.list, next = next@main)
    println@std.core.console("6. collected ${to_str@std.core.basic(size@std.core.list<Int>(collected#{as List<Int>}))}")

    // ===== 7. ranges =====
    //
    // std's `range` is an `iter fn` with three parameters and two delegating
    // overloads returning its `Range`.
    let evens: Mut Str = Mut Str()
    for i in range@std.core.range(0, 10, 2) #{next@std.core.range} {
        append@std.core.string(evens, "${to_str@std.core.basic(i)} ")
    }
    println@std.core.console("7. evens ${to_str@std.core.string(evens#{as Str})}")
}
