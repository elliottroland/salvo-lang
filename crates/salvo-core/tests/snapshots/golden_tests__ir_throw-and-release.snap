module main

linear struct FileHandle wire {
  name: Str
}

fn open_file@main(lent console: Console; moved name: Str) -> FileHandle@main {
  call println@std.core.console(read console, concat("1. open ", read name))
  return construct FileHandle@main { name: !read name }
}

fn close@main(lent console: Console; moved handle: FileHandle@main) -> None {
  obligation gain-params [handle]
  call println@std.core.console(read console, concat("1. close ", read handle.name))
  obligation release [handle]
  call discard@std.core.basic<FileHandle@main>(!read handle)
}

fn read_size@main(lent console: Console; moved name: Str, lent want: Int) -> Int {
  bind#1 let there_is: Int = call size@std.core.string(read name)
  bind#2 let handle: FileHandle@main = call open_file@main(read console, !read name)
  obligation gain [handle]
  branch#3 cond#0 (read want > read there_is) {
    call println@std.core.console(read console, "1. asked for more than there is")
    obligation release [handle]
    call close@main(read console, !read handle)
    return !read there_is
  }
  obligation release [handle]
  call close@main(read console, !read handle)
  return read want
}

fn parse_port@main(lent text: Str) -> Int throws Str {
  bind#1 let n: Int? = call parse_int@std.core.string(read text)
  branch#2 cond#0 check#3 (read n is none) {
    throw(concat("not a number: ", read text))
  }
  narrow#5[after branch#2.cond#0] n~1: Int = n
  branch#4 cond#0 (read n~1 < 1) {
    throw("port must be positive")
  }
  narrow#6[after branch#4.cond#0] n~2: Int = n
  return !read n~2
}

fn port_of@main(lent config: Str) -> Int throws Str {
  bind#1 let port: Int = call parse_port@main(read config)
  return (read port * 1)
}

fn port_from_file@main(lent console: Console; moved name: Str, lent text: Str) -> Int throws Str {
  bind#1 let handle: FileHandle@main = call open_file@main(read console, !read name)
  obligation gain [handle]
  bind#2 let from: Str = call copy@std.core.basic<Str>(read handle.name)
  obligation release [handle]
  call close@main(read console, !read handle)
  call println@std.core.console(read console, concat("2. reading a port out of ", read from))
  return call parse_port@main(read text)
}

fn strict_port@main(lent text: Str) -> Int throws Str | Int {
  branch#1 cond#0 (call size@std.core.string(read text) == 0) {
    throw("empty")
  }
  bind#2 let n: Int? = call parse_int@std.core.string(read text)
  branch#3 cond#0 check#4 (read n is none) {
    throw(call size@std.core.string(read text))
  }
  narrow#5[after branch#3.cond#0] n~1: Int = n
  return !read n~1
}

fn report@main(lent console: Console; lent label: Str, lent config: Str) -> None {
  bind#1 let outcome: Int | Str = try[Int | Str] {
    value call port_of@main(read config)
  }
  switch#2 read outcome {
    arm#0 (arm 0) {
      narrow#3[switch#2.arm#0] outcome~1: Int = outcome
      call println@std.core.console(read console, concat("3. ", read label, ": port ", call to_str(Int)@std.core.basic(read outcome~1)))
    }
    arm#1 (arm 1) {
      narrow#4[switch#2.arm#1] outcome~2: Str = outcome
      call println@std.core.console(read console, concat("3. ", read label, ": rejected — ", read outcome~2))
    }
    arm#2 (else) {
      unreachable("unhandled union arm") at main:116:5
    }
  }
}

