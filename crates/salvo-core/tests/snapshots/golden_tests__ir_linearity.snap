module main

linear struct Ticket wire {
  id: Int
  seat: Str
}

fn issue@main(lent console: Console; lent id: Int, moved seat: Str) -> Ticket@main {
  call println@std.core.console(read console, concat("1. issued #", call to_str(Int)@std.core.basic(read id), " for ", read seat))
  return construct Ticket@main { id: read id, seat: !read seat }
}

fn redeem@main(lent console: Console; moved ticket: Ticket@main) -> None {
  obligation gain-params [ticket]
  call println@std.core.console(read console, concat("1. redeemed #", call to_str(Int)@std.core.basic(read ticket.id)))
  obligation release [ticket]
  call discard@std.core.basic<Ticket@main>(!read ticket)
}

fn one_use@main(lent console: Console) -> None {
  bind#1 let ticket: Ticket@main = call issue@main(read console, 1, "12A")
  obligation gain [ticket]
  obligation release [ticket]
  call redeem@main(read console, !read ticket)
  call println@std.core.console(read console, "2. gone after one use")
}

fn describe@main(lent console: Console; lent ticket: Ticket@main) -> None {
  call println@std.core.console(read console, concat("3. still holding #", call to_str(Int)@std.core.basic(read ticket.id), " (", read ticket.seat, ")"))
}

fn borrow_then_use@main(lent console: Console) -> None {
  bind#1 let ticket: Ticket@main = call issue@main(read console, 2, "3C")
  obligation gain [ticket]
  call describe@main(read console, read ticket)
  call describe@main(read console, read ticket)
  obligation release [ticket]
  call redeem@main(read console, !read ticket)
}

fn read_a_field@main(lent console: Console) -> None {
  bind#1 let ticket: Ticket@main = call issue@main(read console, 3, "1A")
  obligation gain [ticket]
  bind#2 let seat: Str = read ticket.seat
  call println@std.core.console(read console, concat("4. read ", read seat, ", and #", call to_str(Int)@std.core.basic(read ticket.id), " is still owed"))
  obligation release [ticket]
  call redeem@main(read console, !read ticket)
}

fn hand_over@main<T canbe linear>(lent console: Console; moved value: T, moved to: (T) [Console] -> None) -> None {
  obligation gain-params [value]
  obligation release [value]
  call local to(read console, !read value)
}

fn generic_handoff@main(lent console: Console) -> None {
  bind#1 let ticket: Ticket@main = call issue@main(read console, 4, "9B")
  obligation gain [ticket]
  obligation release [ticket]
  call hand_over@main<Ticket@main>(read console, !read ticket, lambda(lent __leff0: Console, lent t: Ticket@main) -> None {
    value call redeem@main(read __leff0, !read t)
  })
}

fn scrap@main(moved ticket: Ticket@main) -> None {
  obligation gain-params [ticket]
  obligation release [ticket]
  call discard@std.core.basic<Ticket@main>(!read ticket)
}

fn a_queue_of_tickets@main(lent console: Console) -> None {
  bind#1 let queue: Mut Deque<Ticket@main> = call mut_deque_of()@std.core.deque<Ticket@main>()
  obligation gain [queue]
  call add_last@std.core.deque<Ticket@main>(read queue, call issue@main(read console, 5, "2B"))
  call add_last@std.core.deque<Ticket@main>(read queue, call issue@main(read console, 6, "2C"))
  call println@std.core.console(read console, concat("6. queued ", call to_str(Int)@std.core.basic(call size@std.core.deque<Ticket@main>(drop_mut(read queue)))))
  bind#2 let first: Ticket@main? = call remove_first@std.core.deque<Ticket@main>(read queue)
  obligation gain [first.arms{0}]
  switch#3 read first {
    arm#0 (arm 0) {
      narrow#4[switch#3.arm#0] first~1: Ticket@main = first
      obligation discharge [first.arms{0}]
      obligation gain [first~1]
      obligation release [first~1]
      call redeem@main(read console, !read first~1)
    }
    arm#1 (none) {
    }
    arm#2 (else) {
      unreachable("unhandled union arm") at main:136:5
    }
  }
  loop#5 {
    bind#7 let __subject~2: Ticket@main? = call remove_first@std.core.deque<Ticket@main>(read queue)
    obligation gain [__subject~2.arms{0}]
    branch#9 cond#0 !(check#6 (read __subject~2 is arm 0)) {
      break
    }
    narrow#8[check#6] next: Ticket@main = __subject~2
    obligation discharge [__subject~2.arms{0}]
    obligation gain [next]
    obligation release [next]
    call redeem@main(read console, !read next)
  }
  obligation release [queue]
  call drain@std.core.deque<Ticket@main>(drop_mut(!read queue), fn scrap@main)
  call println@std.core.console(read console, "6. queue drained")
}

fn main@main() -> None {
  bind#1 let __use~1: StdConsole = construct StdConsole { }
  bind#2 let __handle~2: Console = read __use~1
  call one_use@main(read __handle~2)
  call borrow_then_use@main(read __handle~2)
  call read_a_field@main(read __handle~2)
  call generic_handoff@main(read __handle~2)
  call a_queue_of_tickets@main(read __handle~2)
}
