// main.sv
// Iteration, in every form Salvo has.
//
// There is no iterator type and no iteration protocol built into the
// compiler. An **iterator struct** is an ordinary struct that declares
// `: Next<self, T>` and has a `next`; `for` is sugar for calling that `next`
// until it answers `Finished`. Everything below is that one rule, seen from
// seven angles.

// ===== 1. a container, driven natively =====
//
// `for` straight over a `List`, an array or a `Str` is the shape the backends
// keep a native loop for: no iterator is allocated and the container is not
// consumed, so `xs` is still readable after the loop.
fn describe_container(xs: List<Int>) [Console] -> None => xs {
    let sum = 0
    for n in xs#{14:23} {
        sum#{15:9} = sum#{15:9} + n#{16:9}
    }
    println("1. list of ${size(xs#{14:23})} sums to ${sum#{15:9}}")
    let letters = Mut Str()
    for c in "salvo" {
        append(letters#{20:9}, "${c#{21:9}}.")
    }
    println("1. string: ${letters#{20:9}}")
    let arr = array_of(10, 20, 30)
    let from_array = 0
    for n in arr#{25:9} {
        from_array#{26:9} = from_array#{26:9} + n#{27:9}
    }
    println("1. array sums to ${from_array#{26:9}}")
}

// ===== 2. an iterator struct of your own, written out =====
//
// The manual form: the position is a field, `next` is an ordinary function,
// and the struct says what it yields. This is what reads two sources at once
// or wants explicit control of its state — and it is also what `iter(xs)`
// hands back for a `List`. Write it out like this when the iterator needs a
// *name*: to store it in a field, to hand it to a function, to zip two of
// them.
struct Countdown : Next<self, Int> canbe Mut {
    // The next value to emit; the iterator is finished when it reaches zero.
    at: Int
}

fn countdown(from: Int) -> Mut Countdown@main {
    return Mut Countdown@main { at: from#{46:14} }
}

// Advancing is a mutation of the position, which is why the parameter is
// `Mut` and is handed back with `=> p: Mut`.
fn next(p: Mut Countdown@main) -> Emitted Int | Finished => p: Mut {
    if p#{52:9}.at <= 0 {
        return finished()
    }
    let now = copy(p#{52:9}.at)
    p#{52:9}.at = p#{52:9}.at - 1
    return emitted(now#{56:9})
}

// A second step over the same struct, under another name. Only `next` is the
// canonical one `for p in …` drives; this one is driven by naming the call:
// `for n in skip(p)`.
fn skip(p: Mut Countdown@main) -> Emitted Int | Finished => p: Mut {
    if p#{64:9}.at <= 1 {
        return finished()
    }
    let now = copy(p#{64:9}.at)
    p#{64:9}.at = p#{64:9}.at - 2
    return emitted(now#{68:9})
}

// An iterator is a value, so it can be driven in stages: this loop leaves the
// iterator where the `break` found it, and the caller carries on from there.
fn take(p: Mut Countdown@main, count: Int) [Console] -> None => p: Mut {
    let seen = 0
    for n in p#{75:9} {
        println("2. got ${n#{77:9}}")
        seen#{76:9} = seen#{76:9} + 1
        if seen#{76:9} == count#{75:27} {
            break
        }
    }
}

// The iterator struct of `iter fn halving`, generated from it [iter-fn].
struct Halving : Next<self, Int> canbe Mut {
    // The `start` being iterated — a scalar, owned [iter-fn].
    start: Int
    // Evaluated once, when the iterator is minted, and readable and
    // writable for the rest of its life. The parameters are read-only.
    at: Int
}

// ===== 2b. the same thing, with the struct generated: `iter fn` =====
//
// An `iter fn` is the same hand-written `next` with the boilerplate removed:
// the declaration is the *minter*, under any name and with any parameters, the
// `state Halving { … }` block names the iterator struct and declares its own
// fields, and the body is its `next`. The compiler writes the struct, which
// holds the parameters beside the state.
//
// Nothing suspends, so there is no state machine: the body *is* the `next`.
//
// Mints a fresh `Halving` — generated from `iter fn halving` [iter-fn].
fn halving(start: Int) [] -> Mut Halving@main {
    return Mut Halving@main { start: start#{106:12}, at: start#{106:12} }
}

// The step of `iter fn halving`, generated from its body [iter-fn].
fn next(__p: Mut Halving@main) -> Emitted Int | Finished => __p: Mut {
    if __p#{111:9}.at <= 0 {
        return finished()
    }
    let now = copy(__p#{111:9}.at)
    __p#{111:9}.at = __p#{111:9}.at / 2
    return emitted(now#{115:9})
}

// The struct is an ordinary type, so a fn handing one out names it.
fn halving_from_ten() -> Mut Halving@main {
    return halving@main(10)
}

// ===== 2c. a source: `Iter` =====
//
// A type becomes a *source* — something `for` mints an iterator from — by
// declaring `: Iter<self, It, T>`, naming its iterator struct, and an `iter`
// over it. The `iter fn` named `iter` is the canonical minter the obligation
// asks for, and its `state` names the struct.
struct Bag : Iter<self, BagIter@main, Int> {
    items: List<Int>
}

// The iterator struct of `iter fn iter`, generated from it [iter-fn].
struct BagIter : Next<self, Int> canbe Mut {
    // The `bag` being iterated — borrowed, so the iterator is a view of it [proj-field]: nothing is copied at the mint, and the value cannot be moved or mutated while the iterator lives [iter-fn].
    bag: proj Bag@main
    at: Int
}

//
// Mints a fresh `BagIter` — generated from `iter fn iter` [iter-fn].
fn iter(bag: Bag@main) [] -> Mut BagIter@main => bag {
    return Mut BagIter@main { bag: bag#{144:9}, at: 0 }
}

// The step of `iter fn iter`, generated from its body [iter-fn].
fn next(__p: Mut BagIter@main) -> Emitted Int | Finished => __p: Mut {
    let e = get(__p#{149:9}.bag.items, __p#{149:9}.at)
    if e#{150:9} is None {
        return finished()
    }
    __p#{149:9}.at = __p#{149:9}.at + 1
    return emitted(copy(e#{150:9}))
}

// The iterator struct of `iter fn fibs`, generated from it [iter-fn].
struct Fibs : Next<self, Int, [Console]> canbe Mut {
    // The `count` being iterated — a scalar, owned [iter-fn].
    count: Int
    a: Int
    b: Int
    made: Int
}

// ===== 3. an effectful iterator, and an unbounded one =====
//
// A `next` is an ordinary function, so effects are ordinary effects: declare
// them and the `for` that drives supplies the handler, once per turn.
//
// Mints a fresh `Fibs` — generated from `iter fn fibs` [iter-fn].
fn fibs(count: Int) [] -> Mut Fibs@main {
    return Mut Fibs@main { count: count#{173:9}, a: 0, b: 1, made: 0 }
}

// The step of `iter fn fibs`, generated from its body [iter-fn].
fn next(__p: Mut Fibs@main) [Console] -> Emitted Int | Finished => __p: Mut {
    if __p#{178:9}.made >= __p#{178:9}.count {
        println("3. finished")
        return finished()
    }
    let now = copy(__p#{178:9}.a)
    let sum = __p#{178:9}.a + __p#{178:9}.b
    __p#{178:9}.a = copy(__p#{178:9}.b)
    __p#{178:9}.b = copy(sum#{184:9})
    __p#{178:9}.made = __p#{178:9}.made + 1
    return emitted(now#{183:9})
}

// The iterator struct of `iter fn naturals`, generated from it [iter-fn].
struct Naturals : Next<self, Int> canbe Mut {
    // The `from` being iterated — a scalar, owned [iter-fn].
    from: Int
    at: Int
}

// Nothing runs until a consumer pulls, so an unbounded iterator is an ordinary
// thing to write: the `break` below is what ends it.
//
// Mints a fresh `Naturals` — generated from `iter fn naturals` [iter-fn].
fn naturals(from: Int) [] -> Mut Naturals@main {
    return Mut Naturals@main { from: from#{202:13}, at: from#{202:13} }
}

// The step of `iter fn naturals`, generated from its body [iter-fn].
fn next(__p: Mut Naturals@main) -> Emitted Int | Finished => __p: Mut {
    let now = copy(__p#{207:9}.at)
    __p#{207:9}.at = __p#{207:9}.at + 1
    return emitted(now#{208:9})
}

// ===== 4. combinators of your own =====
//
// `?Next<It, T>` is a spread of implicit parameters, not a bound and not a
// trait: it asks for the `next` that fits the subject, and the call site fills
// it. That spread is also the declaration `for` reads, so a generic iterator
// is driven exactly like a named one.
fn sum_of<It>(it: Mut It, ?Next<It, Int>) -> Int => it: Mut {
    let total = 0
    for n in it#{219:15} {
        total#{220:9} = total#{220:9} + n#{221:9}
    }
    return total#{220:9}
}

// `?Iter<C, It, T>` is the same over a *source*: it brings in the `iter` that
// mints an `It` and the `next` that drives it, so a combinator can take the
// container itself — a `Bag`, a `List`, anything with an `iter`.
fn total<C, It>(c: C, ?Iter<C, It, Int>) -> Int => c {
    let total = 0
    for n in c#{230:17} {
        total#{231:9} = total#{231:9} + n#{232:9}
    }
    return total#{231:9}
}

// Any iterator struct emitting `Int`: a generic with its `?Next` spread, so a
// hand-written struct and an `iter fn`'s both fit.
fn first<It>(it: Mut It, ?Next<It, Int>) -> Int => it: Mut {
    for n in it#{240:14} {
        return n#{241:9}
    }
    return -1
}

fn main() [use] {
    use StdConsole()
    let xs = List(1, 2, 3, 4)
    describe_container@main(xs#{249:9})
    let p = countdown@main(5)
    take@main(p#{251:9}, 2)
    println("2. rest sums to ${sum_of@main(p#{251:9})}")
    let q = countdown@main(6)
    for n in skip@main(q#{254:9}) {
        println("2. skip ${n#{255:9}}")
    }
    for n in halving@main(20) {
        println("2b. halving ${n#{258:9}}")
    }
    let hp = halving@main(20)
    println("2b. summed from a held iterator: ${sum_of@main(hp#{261:9})}")
    println("2b. first from a fn returning one: ${first#{@main, @std.core.array, @std.core.deque, … 1 more}(halving_from_ten@main())}")
    let bag = Bag@main { items: List(7, 8) }
    for n in bag#{264:9} {
        println("2c. bag ${n#{265:9}}")
    }
    println("2c. total of a bag ${total@main(bag#{264:9})}, of a list ${total@main(xs#{249:9})}")
    for n in fibs@main(6) {
        println("3. fib ${n#{269:9}}")
    }
    for n in naturals@main(10) {
        if n#{272:9} > 12 {
            break
        }
        println("3. natural ${n#{272:9}}")
    }
    let doubled = map(xs#{249:9}, (n) -> n#{278:28} * 2)
    let odd = filter(xs#{249:9}, (n) -> n#{279:27} % 2 == 1)
    let total = reduce(xs#{249:9}, 0, (acc, n) -> acc#{280:32} + n#{280:37})
    println("5. list: ${size(doubled#{278:9})} doubled, ${size(odd#{279:9})} odd, total ${total#{280:9}}")
    let words = List("ann", "bo", "carol")
    let lengths = map(iter#{@main, @std.core.array, @std.core.buffer, … 7 more}(words#{282:9}), (w) -> size(w#{283:37}))
    println("5. lengths: ${reduce(iter#{@main, @std.core.array, @std.core.buffer, … 7 more}(lengths#{283:9}), 0, (acc, n) -> acc#{284:54} + n#{284:59})}")
    let word = "iteration"
    let vowels = filter(iter#{@main, @std.core.array, @std.core.buffer, … 7 more}(word#{285:9}), (c) -> c#{286:38} == 'i' || c#{286:38} == 'o')
    println("5. vowels: ${size(vowels#{286:9})}")
    println("5. halving total ${reduce(halving@main(20), 0, (acc, n) -> acc#{288:57} + n#{288:62})}")
    let collected = map_to(Mut List<Int>(), countdown@main(3), (n: Int) -> n#{289:60} * 10)
    println("6. collected ${size(collected#{289:9})}")
    let evens = Mut Str()
    for i in range(0, 10, 2) {
        append(evens#{291:9}, "${i#{292:9}} ")
    }
    println("7. evens ${evens#{291:9}}")
}
