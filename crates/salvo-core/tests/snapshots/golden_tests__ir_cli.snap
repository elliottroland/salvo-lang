module main

struct Tool wire {
  verbose: Bool
  command: Serve | Fetch | None
}

struct Serve wire {
  net: Net
  port: Int = 8080
  output: Str = "text"
  tls: Tls?
  files: List<Str>
}

struct Net wire {
  host: Str = "127.0.0.1"
  workers: Int?
}

struct Tls wire {
  cert: Str
  key: Str
}

struct Fetch wire {
  source: FromUrl | FromFile | FromStdin
  header: List<Str>
}

struct FromUrl wire {
  url: Str
  timeout: Int = 30
}

struct FromFile wire {
  file: Str
}

struct FromStdin wire {
}

