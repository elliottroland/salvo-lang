fn duel@main(lent_mut a: Mut Fighter@main, lent_mut d: Mut Fighter@main) -> None {
  assign a.hp = (read a.hp - 1)
  assign d.hp = (read d.hp - 2)
  return none[None]
}

fn strike@main(lent_mut c: List<Mut Fighter@main>, lent_mut a: ref<List<Mut Fighter@main>> Mut Fighter@main, lent_mut d: ref<List<Mut Fighter@main>> Mut Fighter@main) -> None anchors a in c, d in c {
  assign a.energy = (read a.energy - 1)
  assign d.hp = (read d.hp - 2)
  return none[None]
}

struct Squad canbe Mut wire {
  banner: Str
  members: List<Mut Fighter@main>
}

fn rotate@main(lent_mut members: List<Mut Fighter@main>, lent_mut from: ref<List<Mut Fighter@main>> Mut Fighter@main, lent_mut to: ref<List<Mut Fighter@main>> Mut Fighter@main) -> None anchors from in members, to in members {
  assign from.energy = (read from.energy - 1)
  assign to.energy = (read to.energy + 1)
  return none[None]
}

struct Camp canbe Mut wire {
  supplies: Int
  banners: Mut List<Str>
}

fn spend@main(lent_mut camp: Mut Camp@main, lent n: Int) -> None {
  assign camp.supplies = (read camp.supplies - read n)
  return none[None]
}

fn hoist@main(lent_mut camp: Mut Camp@main, moved banner: Str) -> None {
  call add@std.core.list<Str>(read camp.banners, !read banner)
  return none[None]
}

