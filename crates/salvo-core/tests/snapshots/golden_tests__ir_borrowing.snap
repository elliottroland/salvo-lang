}

fn heal@main(lent_mut f: Mut Fighter@main) -> None {
  assign f.hp = (read f.hp + 10)
  return none[None]
}

fn wounded@main(lent_mut squad: List<Mut Fighter@main>) -> ref<List<Mut Fighter@main>> Mut Fighter@main? borrows [squad] {
  foreach#1 f: ref<List<Mut Fighter@main>> Mut Fighter@main in read squad {
