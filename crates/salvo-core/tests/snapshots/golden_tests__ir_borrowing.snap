}

fn window@main(lent roster: List<Fighter@main>) -> Mut Window@main borrows [roster] {
  return construct Mut Window@main { roster: read roster, at: 0 }
}

fn peek@main(lent w: Window@main) -> proj Fighter@main? borrows [w] {
  return call get(List<T>, Int)@std.core.list<Fighter@main>(borrow_as[proj List<Fighter@main> -> List<Fighter@main>](read w.roster), read w.at)
}

fn heal@main(lent_mut f: Mut Fighter@main) -> None {
  assign f.hp = (read f.hp + 10)
  return none[None]
}

fn wounded@main(lent_mut squad: List<Mut Fighter@main>) -> ref<List<Mut Fighter@main>> Mut Fighter@main? borrows [squad] {
