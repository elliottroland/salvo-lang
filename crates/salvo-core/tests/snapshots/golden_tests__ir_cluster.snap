export impl __Route_Inventory(lent group: eff[ActorGroup<Inventory>]) of any Inventory deps [RouteSelector<Inventory>] stateful {
  mailbox construct Mailbox { capacity: 1 }
  state seen: Long = -1L
  fn reserve(moved sku: Str, lent qty: Int, moved out: Reply<Str>) -> None {
    obligation gain-params [out]
    bind#1 let __pick: RoutePick<Inventory> = call std.net::route_pick(eff[ActorGroup<E>], Long, Long)<Inventory>(read __dep0, read group, read seen, call std.net::key_hash<Str>(read sku))
    assign seen = read __pick.version
    obligation release [out]
    send main::Inventory#0(read __pick.to, !read sku, !read qty, !read out)
  }
}

