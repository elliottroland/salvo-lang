module main

actor interface Sequencer {
  send fn next(moved out: Reply<Str>) -> None
}

actor interface Inventory {
  send fn reserve(moved sku: Str, lent qty: Int, moved out: Reply<Str>) -> None
}

actor interface Search {
  send fn query(moved word: Str, moved out: Reply<Int>) -> None
}

actor interface Lookup {
  send fn lookup(moved key: Str, moved out: Reply<Str>) -> None
}

impl Sequencing(lent who: Str) of Sequencer@main stateful {
  mailbox construct Mailbox { capacity: 16 }
  state n: Int = 0
  fn next(lent out: Reply<Str>) -> None {
    assign n = (read n + 1)
    obligation release [out]
    call send@std.core.actor<Str>(!read out, concat(read who, "#", call to_str(Int)@std.core.basic(read n)))
  }
}

impl Stocking(lent shard: Str) of Inventory@main stateful {
  mailbox construct Mailbox { capacity: 32 }
  state served: Int = 0
  fn reserve(lent sku: Str, lent qty: Int, lent out: Reply<Str>) -> None {
    assign served = (read served + read qty)
    obligation release [out]
    call send@std.core.actor<Str>(!read out, concat(read shard, ":", call to_str(Int)@std.core.basic(read served)))
  }
}

impl Indexing(lent words: List<Str>) of Search@main {
  mailbox construct Mailbox { capacity: 16 }
  fn query(lent word: Str, lent out: Reply<Int>) -> None {
    bind#1 let n: Int = 0
    foreach#2 w: proj Str in read words {
      branch#3 cond#0 call eq@std.core.string(borrow_as[proj Str -> Str](read w), read word) {
        assign n = (read n + 1)
      }
    }
    obligation release [out]
    call send@std.core.actor<Int>(!read out, !read n)
  }
}

impl Looking(lent who: Str) of Lookup@main {
  mailbox construct Mailbox { capacity: 16 }
  fn lookup(lent key: Str, lent out: Reply<Str>) -> None {
    obligation release [out]
    call send@std.core.actor<Str>(!read out, concat(read key, " from ", read who))
  }
}

impl SlowLooking(lent who: Str, lent timer: eff[Timer]) of Lookup@main stateful {
  mailbox construct Mailbox { capacity: 16 }
  fn lookup(lent key: Str, lent out: Reply<Str>) -> None {
    obligation release [out]
    send after@Timer(read timer, call millis@std.time(150L), replyto answer(!read key, !read out))
  }
  fn answer(lent key: Str, lent out: Reply<Str>, lent fired: Fired) -> None {
    obligation release [out]
    call send@std.core.actor<Str>(!read out, concat(read key, " from ", read who))
  }
}

impl Scattering(lent group: eff[ActorGroup<Search@main>], lent gather: eff[Gather@main]) of any Search@main {
  mailbox construct Mailbox { capacity: 16 }
  fn query(lent word: Str, lent out: Reply<Int>) -> None {
    bind#1 let members: List<eff[Search@main]> = waitfor ms: Reply<List<eff[Search@main]>> {
      obligation gain [ms]
      obligation release [ms]
      send members@ActorGroup(read group, !read ms)
    }
    obligation release [out]
    send scatter@Gather(read gather, !read word, !read members, !read out)
  }
}

actor interface Gather {
  send fn scatter(moved word: Str, moved members: List<eff[Search@main]>, moved out: Reply<Int>) -> None
}

impl Gathering() of Gather@main stateful {
  mailbox construct Mailbox { capacity: 16 }
  state pending: Mut Deque<Reply<Int>> = call mut_deque_of()@std.core.deque<Reply<Int>>()
  state left: Int = 0
  state total: Int = 0
  fn scatter(lent word: Str, lent members: List<eff[Search@main]>, lent out: Reply<Int>) -> None {
    obligation release [out]
    call add_last@std.core.deque<Reply<Int>>(read pending, !read out)
    assign left = call size@std.core.list<eff[Search@main]>(read members)
    assign total = 0
    foreach#1 m: proj eff[Search@main] in read members {
      send query@Search(read m, call copy@std.core.basic<Str>(read word), replyto partial())
    }
  }
  fn partial(lent n: Int) -> None {
    assign total = (read total + read n)
    assign left = (read left - 1)
    branch#1 cond#0 (read left == 0) {
      bind#2 let out: Reply<Int>? = call remove_first@std.core.deque<Reply<Int>>(read pending)
      obligation gain [out.arms{0}]
      switch#3 read out {
        arm#0 (arm 0) {
          narrow#4[switch#3.arm#0] out~1: Reply<Int> = out
          obligation discharge [out.arms{0}]
          obligation gain [out~1]
          obligation release [out~1]
          call send@std.core.actor<Int>(!read out~1, call copy@std.core.basic<Int>(read total))
        }
        arm#1 (none) {
        }
        arm#2 (else) {
          unreachable("unhandled union arm") at main:141:13
        }
      }
    }
  }
}

impl Hedging(lent group: eff[ActorGroup<Lookup@main>], lent racer: eff[Race@main]) of any Lookup@main {
  mailbox construct Mailbox { capacity: 16 }
  fn lookup(lent key: Str, lent out: Reply<Str>) -> None {
    bind#1 let members: List<eff[Lookup@main]> = waitfor ms: Reply<List<eff[Lookup@main]>> {
      obligation gain [ms]
      obligation release [ms]
      send members@ActorGroup(read group, !read ms)
    }
    obligation release [out]
    send race@Race(read racer, !read key, !read members, !read out)
  }
}

actor interface Race {
  send fn race(moved key: Str, moved members: List<eff[Lookup@main]>, moved out: Reply<Str>) -> None
}

impl Racing() of Race@main stateful {
  mailbox construct Mailbox { capacity: 16 }
  state pending: Mut Deque<Reply<Str>> = call mut_deque_of()@std.core.deque<Reply<Str>>()
  fn race(lent key: Str, lent members: List<eff[Lookup@main]>, lent out: Reply<Str>) -> None {
    obligation release [out]
    call add_last@std.core.deque<Reply<Str>>(read pending, !read out)
    foreach#1 m: proj eff[Lookup@main] in read members {
      send lookup@Lookup(read m, call copy@std.core.basic<Str>(read key), replyto first())
    }
  }
  fn first(lent answer: Str) -> None {
    bind#1 let out: Reply<Str>? = call remove_first@std.core.deque<Reply<Str>>(read pending)
    obligation gain [out.arms{0}]
    switch#2 read out {
      arm#0 (arm 0) {
        narrow#3[switch#2.arm#0] out~1: Reply<Str> = out
        obligation discharge [out.arms{0}]
        obligation gain [out~1]
        obligation release [out~1]
        call send@std.core.actor<Str>(!read out~1, !read answer)
      }
      arm#1 (none) {
        call discard@std.core.basic<Str>(!read answer)
      }
      arm#2 (else) {
        unreachable("unhandled union arm") at main:177:9
      }
    }
  }
}

impl LastHost(lent nodes: eff[NodeGroup], lent me: NodeEndpoint) of Leader {
  fn leader() -> NodeId? {
    bind#1 let peers: List<Node> = waitfor out: Reply<List<Node>> {
      obligation gain [out]
      obligation release [out]
      send members@NodeGroup(read nodes, !read out)
    }
    bind#2 let best_host: Str = call copy@std.core.basic<Str>(read me.host)
    bind#3 let best: NodeId = call this_node@std.net()
    foreach#4 n: proj Node in read peers {
      branch#5 cond#0 (call cmp@std.core.string(read n.at.host, read best_host) > 0) {
        assign best_host = call copy@std.core.basic<Str>(read n.at.host)
        assign best = call copy@std.core.basic<NodeId>(read n.id)
      }
    }
    return present(!read best)
  }
}

fn fresh_id@main(lent sequencer: Sequencer@main) -> Str {
  return waitfor out: Reply<Str> {
    obligation gain [out]
    obligation release [out]
    member next@Sequencer(read sequencer, !read out)
  }
}

