    bind#1 let p: Pool = call std.core.actor::pool(Int)(1)
    bind#2 let group: eff[NodeGroup] = spawn[eff[NodeGroup]](construct StaticNodeGroup { name: "cluster", all: call std.core.basic::copy<List<NodeEndpoint>>(read all), __dep0: read __dep0 }, on: read p) serves [NodeGroup]
    assign nodes = present(call std.core.basic::copy<eff[NodeGroup]>(read group))
    bind#3 let seq: eff[ActorGroup<Sequencer>] = call std.net::actor_group(eff[NodeGroup])<Sequencer>(call std.core.basic::copy<eff[NodeGroup]>(read group), fn std.net::protocol)
    bind#4 let mine: eff[Sequencer] = spawn[eff[Sequencer]](construct Sequencing { who: "b" }, on: read p, in: read seq) serves [Sequencer]
    bind#5 let stock: eff[ActorGroup<Inventory>] = call std.net::actor_group(eff[NodeGroup])<Inventory>(call std.core.basic::copy<eff[NodeGroup]>(read group), fn std.net::protocol)
    spawn[eff[Inventory]](construct Stocking { shard: "shard-b" }, on: read p, in: read stock) serves [Inventory]
    bind#6 let index: eff[ActorGroup<Search>] = call std.net::actor_group(eff[NodeGroup])<Search>(call std.core.basic::copy<eff[NodeGroup]>(read group), fn std.net::protocol)
    spawn[eff[Search]](construct Indexing { words: call std.core.list::List(T, T[])<Str>("salvo", array[Str[]]("actors", "salvo", "nodes")) }, on: read p, in: read index) serves [Search]
    bind#7 let looks: eff[ActorGroup<Lookup>] = call std.net::actor_group(eff[NodeGroup])<Lookup>(!read group, fn std.net::protocol)
    bind#8 let timer: eff[Timer] = spawn[eff[Timer]](construct DefaultTimer { }, on: read p) serves [Timer]
    spawn[eff[Lookup]](construct SlowLooking { who: "b (slow)", timer: !read timer }, on: read p, in: read looks) serves [Lookup]
    obligation release [done]
    call std.core.actor::send<eff[Sequencer]>(!read done, !read mine)
  }
  fn stop(lent done: Reply<Bool>) -> None {
    bind#1 let group: eff[NodeGroup]? = read nodes
    branch#2 cond#0 !(check#3 (read group is none)) {
      narrow#4[branch#2.cond#0] group~1: eff[NodeGroup] = group
      send std.net::NodeGroup#2(read group~1)
    }
    obligation release [done]
    call std.core.actor::send<Bool>(!read done, true)
  }
}

