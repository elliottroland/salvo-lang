}

actor interface Boot {
  send fn boot(moved done: Reply<eff[Sequencer@main]>) -> None
  send fn stop(moved done: Reply<Bool>) -> None
}

impl Booting(lent at: NodeEndpoint, lent all: List<NodeEndpoint>, lent net: eff[MemNet]) of Boot@main deps [Transport] stateful {
  mailbox construct Mailbox { capacity: 2 }
  state nodes: eff[NodeGroup]? = none[None]
  fn boot(lent done: Reply<eff[Sequencer@main]>) -> None {
    bind#1 let p: Pool = call pool(Int)@std.core.actor(1)
    bind#2 let group: eff[NodeGroup] = spawn[eff[NodeGroup]](construct StaticNodeGroup { name: "cluster", all: call copy@std.core.basic<List<NodeEndpoint>>(read all), __dep0: read __dep0 }, on: read p) serves [NodeGroup]
    assign nodes = present(call copy@std.core.basic<eff[NodeGroup]>(read group))
    bind#3 let seq: eff[ActorGroup<Sequencer@main>] = call actor_group(eff[NodeGroup])@std.net<Sequencer@main>(call copy@std.core.basic<eff[NodeGroup]>(read group), fn protocol@std.net)
    bind#4 let mine: eff[Sequencer@main] = spawn[eff[Sequencer@main]](construct Sequencing@main { who: "b" }, on: read p, in: read seq) serves [Sequencer@main]
    bind#5 let stock: eff[ActorGroup<Inventory@main>] = call actor_group(eff[NodeGroup])@std.net<Inventory@main>(call copy@std.core.basic<eff[NodeGroup]>(read group), fn protocol@std.net)
    spawn[eff[Inventory@main]](construct Stocking@main { shard: "shard-b" }, on: read p, in: read stock) serves [Inventory@main]
    bind#6 let index: eff[ActorGroup<Search@main>] = call actor_group(eff[NodeGroup])@std.net<Search@main>(call copy@std.core.basic<eff[NodeGroup]>(read group), fn protocol@std.net)
    spawn[eff[Search@main]](construct Indexing@main { words: call List(T, T[])@std.core.list<Str>("salvo", array[Str[]]("actors", "salvo", "nodes")) }, on: read p, in: read index) serves [Search@main]
    bind#7 let looks: eff[ActorGroup<Lookup@main>] = call actor_group(eff[NodeGroup])@std.net<Lookup@main>(!read group, fn protocol@std.net)
    bind#8 let timer: eff[Timer] = spawn[eff[Timer]](construct DefaultTimer { }, on: read p) serves [Timer]
    spawn[eff[Lookup@main]](construct SlowLooking@main { who: "b (slow)", timer: !read timer }, on: read p, in: read looks) serves [Lookup@main]
    obligation release [done]
    call send@std.core.actor<eff[Sequencer@main]>(!read done, !read mine)
  }
  fn stop(lent done: Reply<Bool>) -> None {
    bind#1 let group: eff[NodeGroup]? = read nodes
    branch#2 cond#0 !(check#3 (read group is none)) {
      narrow#4[branch#2.cond#0] group~1: eff[NodeGroup] = group
      send leave@NodeGroup(read group~1)
    }
    obligation release [done]
    call send@std.core.actor<Bool>(!read done, true)
  }
}

fn settle@main(lent timer: eff[Timer]) -> None {
  bind#1 let _f: Fired = waitfor f: Reply<Fired> {
    obligation gain [f]
    obligation release [f]
    send after@Timer(read timer, call millis@std.time(400L), !read f)
  }
}

