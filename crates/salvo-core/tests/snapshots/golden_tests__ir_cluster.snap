actor interface Boot {
  send fn boot(moved done: Reply<eff[Sequencer]>) -> None
  send fn stop(moved done: Reply<Bool>) -> None
}

impl Booting(lent at: NodeEndpoint, lent all: List<NodeEndpoint>, lent net: eff[MemNet]) of Boot deps [Transport] stateful {
  mailbox construct Mailbox { capacity: 2 }
  state nodes: eff[NodeGroup]? = none[None]
