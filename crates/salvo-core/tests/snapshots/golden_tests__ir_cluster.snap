    }
  }
}

impl Hedging(lent group: eff[ActorGroup<Lookup>], lent racer: eff[Race]) of any Lookup {
  mailbox construct Mailbox { capacity: 16 }
  fn lookup(lent key: Str, lent out: Reply<Str>) -> None {
