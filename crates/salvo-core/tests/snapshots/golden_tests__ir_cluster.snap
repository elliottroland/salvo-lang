actor interface Race {
  send fn race(moved key: Str, moved members: List<eff[Lookup]>, moved out: Reply<Str>) -> None
}

impl Racing() of Race stateful {
  mailbox construct Mailbox { capacity: 16 }
  state pending: Mut Deque<Reply<Str>> = call std.core.deque::mut_deque_of()<Reply<Str>>()
  fn race(lent key: Str, lent members: List<eff[Lookup]>, lent out: Reply<Str>) -> None {
    obligation release [out]
    call std.core.deque::add_last<Reply<Str>>(read pending, !read out)
    foreach#1 m: proj eff[Lookup] in read members {
      send main::Lookup#0(read m, call std.core.basic::copy<Str>(read key), replyto first())
    }
  }
  fn first(lent answer: Str) -> None {
    bind#1 let out: Reply<Str>? = call std.core.deque::remove_first<Reply<Str>>(read pending)
    obligation gain [out.arms{0}]
    switch#2 read out {
      arm#0 (arm 0) {
        narrow#3[switch#2.arm#0] out~1: Reply<Str> = out
        obligation discharge [out.arms{0}]
        obligation gain [out~1]
        obligation release [out~1]
        call std.core.actor::send<Str>(!read out~1, !read answer)
      }
      arm#1 (none) {
        call std.core.basic::discard<Str>(!read answer)
      }
      arm#2 (else) {
        unreachable("unhandled union arm") at main:177:9
      }
    }
  }
}

impl LastHost(lent nodes: eff[NodeGroup], lent me: NodeEndpoint) of Leader {
  fn leader() -> NodeId? {
    bind#1 let peers: List<Node> = waitfor out: Reply<List<Node>> {
      obligation gain [out]
      obligation release [out]
      send std.net::NodeGroup#0(read nodes, !read out)
    }
    bind#2 let best_host: Str = call std.core.basic::copy<Str>(read me.host)
    bind#3 let best: NodeId = call std.net::this_node()
    foreach#4 n: proj Node in read peers {
      branch#5 cond#0 (call std.core.compare::cmp(Str, Str)(read n.at.host, read best_host) > 0) {
        assign best_host = call std.core.basic::copy<Str>(read n.at.host)
        assign best = call std.core.basic::copy<NodeId>(read n.id)
      }
    }
    return present(!read best)
  }
}

