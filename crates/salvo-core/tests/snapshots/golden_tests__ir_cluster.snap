    obligation release [out]
    call std.core.deque::add_last<Reply<Int>>(read pending, !read out)
    assign left = call std.core.list::size<eff[Search]>(read members)
    assign total = 0
    foreach#1 m: proj eff[Search] in read members {
      send main::Search#0(read m, call std.core.basic::copy<Str>(read word), replyto partial())
    }
  }
  fn partial(lent n: Int) -> None {
    assign total = (read total + read n)
    assign left = (read left - 1)
    branch#1 cond#0 (read left == 0) {
      bind#2 let out: Reply<Int>? = call std.core.deque::remove_first<Reply<Int>>(read pending)
      obligation gain [out.arms{0}]
      switch#3 read out {
        arm#0 (arm 0) {
          narrow#4[switch#3.arm#0] out~1: Reply<Int> = out
          obligation discharge [out.arms{0}]
          obligation gain [out~1]
          obligation release [out~1]
          call std.core.actor::send<Int>(!read out~1, call std.core.basic::copy<Int>(read total))
