module main

actor interface Sequencer {
  send fn next(moved out: Reply<Str>) -> None
}

actor interface Inventory {
  send fn reserve(moved sku: Str, lent qty: Int, moved out: Reply<Str>) -> None
}

actor interface Search {
  send fn query(moved word: Str, moved out: Reply<Int>) -> None
}

actor interface Lookup {
  send fn lookup(moved key: Str, moved out: Reply<Str>) -> None
}

impl Sequencing(lent who: Str) of Sequencer stateful {
  mailbox construct Mailbox { capacity: 16 }
  state n: Int = 0
  fn next(lent out: Reply<Str>) -> None {
    assign n = (read n + 1)
    obligation release [out]
    call std.core.actor::send<Str>(!read out, concat(read who, "#", call std.core.basic::to_str(Int)(read n)))
  }
}

impl Stocking(lent shard: Str) of Inventory stateful {
  mailbox construct Mailbox { capacity: 32 }
  state served: Int = 0
  fn reserve(lent sku: Str, lent qty: Int, lent out: Reply<Str>) -> None {
    assign served = (read served + read qty)
    obligation release [out]
    call std.core.actor::send<Str>(!read out, concat(read shard, ":", call std.core.basic::to_str(Int)(read served)))
  }
}

impl Indexing(lent words: List<Str>) of Search {
  mailbox construct Mailbox { capacity: 16 }
  fn query(lent word: Str, lent out: Reply<Int>) -> None {
    bind#1 let n: Int = 0
    foreach#2 w: proj Str in read words {
      branch#3 cond#0 call std.core.compare::eq(Str, Str)(borrow_as[proj Str -> Str](read w), read word) {
        assign n = (read n + 1)
      }
    }
    obligation release [out]
    call std.core.actor::send<Int>(!read out, !read n)
  }
}

impl Looking(lent who: Str) of Lookup {
  mailbox construct Mailbox { capacity: 16 }
  fn lookup(lent key: Str, lent out: Reply<Str>) -> None {
    obligation release [out]
    call std.core.actor::send<Str>(!read out, concat(read key, " from ", read who))
  }
}

impl SlowLooking(lent who: Str, lent timer: eff[Timer]) of Lookup stateful {
  mailbox construct Mailbox { capacity: 16 }
  fn lookup(lent key: Str, lent out: Reply<Str>) -> None {
    obligation release [out]
    send std.time::Timer#0(read timer, call std.time::millis(150L), replyto answer(!read key, !read out))
  }
  fn answer(lent key: Str, lent out: Reply<Str>, lent fired: Fired) -> None {
    obligation release [out]
    call std.core.actor::send<Str>(!read out, concat(read key, " from ", read who))
  }
}

impl Scattering(lent group: eff[ActorGroup<Search>], lent gather: eff[Gather]) of any Search {
  mailbox construct Mailbox { capacity: 16 }
  fn query(lent word: Str, lent out: Reply<Int>) -> None {
    bind#1 let members: List<eff[Search]> = waitfor ms: Reply<List<eff[Search]>> {
      obligation gain [ms]
      obligation release [ms]
      send std.net::ActorGroup#2(read group, !read ms)
    }
    obligation release [out]
    send main::Gather#0(read gather, !read word, !read members, !read out)
  }
}

actor interface Gather {
  send fn scatter(moved word: Str, moved members: List<eff[Search]>, moved out: Reply<Int>) -> None
}

impl Gathering() of Gather stateful {
  mailbox construct Mailbox { capacity: 16 }
  state pending: Mut Deque<Reply<Int>> = call std.core.deque::mut_deque_of()<Reply<Int>>()
  state left: Int = 0
