  call println@std.core.console(read __handle~2, "after b left:")
  call println@std.core.console(read __handle~2, concat("  sequencers: ", call to_str(Int)@std.core.basic(call size@std.core.list<eff[Sequencer@main]>(waitfor out: Reply<List<eff[Sequencer@main]>> {
    send members@ActorGroup(read seq, !read out)
  }))))
  call two_ids@main(read __handle~6, read __handle~2, !read seq)
}

