module main

actor interface Counter {
  send fn bump(lent n: Int) -> None
  send fn total(moved out: Reply<Int>) -> None
}

impl Counting() of Counter@main stateful {
  mailbox construct Mailbox { capacity: 8 }
  state sum: Int = 0
  fn bump(lent n: Int) -> None {
    assign sum = (read sum + read n)
  }
  fn total(lent out: Reply<Int>) -> None {
    obligation release [out]
    call send@std.core.actor<Int>(!read out, !read sum)
  }
}

actor interface Ledger {
  send fn report(moved label: Str, moved out: Reply<Str>) -> None
  send fn reported(moved label: Str, moved out: Reply<Str>, lent total: Int) -> None
}

impl Bookkeeping() of Ledger@main deps [Counter@main] stateful {
  mailbox construct Mailbox { capacity: 4 }
  fn report(lent label: Str, lent out: Reply<Str>) -> None {
    obligation release [out]
    member total@Counter(read __dep0, replyto reported(!read label, !read out))
  }
  fn reported(lent label: Str, lent out: Reply<Str>, lent total: Int) -> None {
    obligation release [out]
    call send@std.core.actor<Str>(!read out, concat(read label, "=", call to_str(Int)@std.core.basic(read total)))
  }
}

actor interface Desk {
  send fn ticket(moved out: Reply<Str>) -> None
  send fn serve(moved name: Str) -> None
  send fn close_up(moved reason: Str) -> None
}

impl Desking(lent room: Int) of Desk@main stateful {
  mailbox construct Mailbox { capacity: read room }
  state waiting: Mut Deque<Reply<Str>> = call mut_deque_of()@std.core.deque<Reply<Str>>()
  fn ticket(lent out: Reply<Str>) -> None {
    obligation release [out]
    call add_last@std.core.deque<Reply<Str>>(read waiting, !read out)
  }
  fn serve(lent name: Str) -> None {
    bind#1 let next: Reply<Str>? = call remove_first@std.core.deque<Reply<Str>>(read waiting)
    obligation gain [next.arms{0}]
    switch#2 read next {
      arm#0 (arm 0) {
        narrow#3[switch#2.arm#0] next~1: Reply<Str> = next
        obligation discharge [next.arms{0}]
        obligation gain [next~1]
        obligation release [next~1]
        call send@std.core.actor<Str>(!read next~1, concat("served ", read name))
      }
      arm#1 (none) {
        call discard@std.core.basic<Str>(!read name)
      }
      arm#2 (else) {
        unreachable("unhandled union arm") at main:118:9
      }
    }
  }
  fn close_up(lent reason: Str) -> None {
    obligation release [waiting]
    call drain@std.core.deque<Reply<Str>>(drop_mut(!read waiting), lambda(lent r: Reply<Str>) -> None captures [reason] {
      value call send@std.core.actor<Str>(!read r, concat("closed: ", read reason))
    })
    assign waiting = call mut_deque_of()@std.core.deque<Reply<Str>>()
  }
}

actor interface Fragile {
  send fn crash() -> None
}

impl Breaking() of Fragile@main {
  mailbox construct Mailbox { capacity: 1 }
  fn crash() -> None {
    bind#1 let empty: List<Int> = call List()@std.core.list<Int>()
    bind#8 let boom: Int = branch#7 cond#0 true {
      bind#2 let __pick~1: Int? = call get(List<T>, Int)@std.core.list<Int>(read empty, 7)
      value branch#3 cond#0 check#6 (read __pick~1 is arm 0) {
        narrow#4[branch#3.cond#0] __picked~2: Int = __pick~1
        value !read __picked~2
      } else {
        value unreachable() at main:149:37
      }
    }
    call discard@std.core.basic<Int>(!read boom)
  }
}

fn formatted@main(moved label: Str, moved out: Reply<Str>, moved total: Int) -> None {
  obligation gain-params [out]
  obligation release [out]
  call send@std.core.actor<Str>(!read out, concat(read label, " totalled ", call to_str(Int)@std.core.basic(read total)))
}

fn report_line@main(moved counter: eff[Counter@main], moved label: Str, moved out: Reply<Str>) -> None {
  obligation gain-params [out]
  obligation release [out]
  send total@Counter(read counter, replyto task formatted@main(!read label, !read out))
}

fn main@main() -> None {
  bind#1 let __use~1: StdConsole = construct StdConsole { }
  bind#2 let __handle~2: Console = read __use~1
  bind#3 let workers: Pool = call pool(Int)@std.core.actor(2)
  bind#4 let counter: eff[Counter@main] = spawn[eff[Counter@main]](construct Counting@main { }, on: read workers) serves [Counter@main]
  send bump@Counter(read counter, 2)
  send bump@Counter(read counter, 3)
  bind#5 let sum: Int = waitfor out: Reply<Int> {
    obligation gain [out]
    obligation release [out]
    send total@Counter(read counter, !read out)
  }
  call println@std.core.console(read __handle~2, concat("1. counter total is ", call to_str(Int)@std.core.basic(read sum)))
  bind#6 let ledger: eff[Ledger@main] = spawn[eff[Ledger@main]](construct Bookkeeping@main { __dep0: instance_at(read counter) }, on: read workers) serves [Ledger@main]
  bind#7 let line: Str = waitfor out: Reply<Str> {
    obligation gain [out]
    obligation release [out]
    send report@Ledger(read ledger, "counter", !read out)
  }
  call println@std.core.console(read __handle~2, concat("3. ledger says ", read line))
  bind#8 let desk: eff[Desk@main] = spawn[eff[Desk@main]](construct Desking@main { room: 8 }, on: read workers) serves [Desk@main]
  bind#10 let first: Str = waitfor a: Reply<Str> {
    obligation gain [a]
    obligation release [a]
    send ticket@Desk(read desk, !read a)
    bind#9 let second: Str = waitfor b: Reply<Str> {
      obligation gain [b]
      obligation release [b]
      send ticket@Desk(read desk, !read b)
      send serve@Desk(read desk, "ada")
      send close_up@Desk(read desk, "end of day")
    }
    call println@std.core.console(read __handle~2, concat("4. second waiter got: ", read second))
  }
  call println@std.core.console(read __handle~2, concat("4. first waiter got: ", read first))
  bind#11 let fragile: eff[Fragile@main] = spawn[eff[Fragile@main]](construct Breaking@main { }, on: read workers) serves [Fragile@main]
  bind#12 let exit: Exit = waitfor gone: Reply<Exit> {
    obligation gain [gone]
    obligation release [gone]
    call watch@std.core.actor<Fragile@main>(read fragile, !read gone)
    send crash@Fragile(read fragile)
  }
  call println@std.core.console(read __handle~2, concat("5. it died with a reason: ", call to_str(Bool)@std.core.basic((call size@std.core.string(read exit.reason) > 0))))
  send crash@Fragile(read fragile)
  bind#13 let __use~3: Counting@main = construct Counting@main { }
  bind#14 let __handle~4: Counter@main = handle[Counter@main](read __use~3)
  member bump@Counter(read __handle~4, 4)
  member bump@Counter(read __handle~4, 5)
  bind#15 let inline: Int = waitfor out: Reply<Int> {
    obligation gain [out]
    obligation release [out]
    member total@Counter(read __handle~4, !read out)
  }
  call println@std.core.console(read __handle~2, concat("6. inline total is ", call to_str(Int)@std.core.basic(read inline)))
  bind#16 let solo: Pool = call pool(Int)@std.core.actor(1)
  bind#17 let mine: eff[Counter@main] = spawn[eff[Counter@main]](construct Counting@main { }, on: read solo) serves [Counter@main]
  send bump@Counter(read mine, 6)
  bind#18 let local: Int = waitfor out: Reply<Int> {
    obligation gain [out]
    obligation release [out]
    send total@Counter(read mine, !read out)
  }
  call println@std.core.console(read __handle~2, concat("7. the solo pool's own actor totalled ", call to_str(Int)@std.core.basic(read local)))
  bind#19 let line8: Str = waitfor out: Reply<Str> {
    obligation gain [out]
    obligation release [out]
    call report_line@main(!read mine, "the counter", !read out)
  }
  call println@std.core.console(read __handle~2, concat("8. ", read line8))
  call println@std.core.console(read __handle~2, "done")
}

