fn __dispatch_Counting_Counter(lent_mut __handler: Counting@main, moved __msg: __Msg_Counter@main) -> None {
  switch#1 read __msg {
    arm#0 (arm 0) {
      unpack#2 (n: Int) = __msg as variant 0
      handler_call bump@Counter(read __handler, !read n)
    }
    arm#1 (arm 1) {
      unpack#3 (out: Reply<Int>) = __msg as variant 1
      obligation gain [out]
      obligation release [out]
      handler_call total@Counter(read __handler, !read out)
    }
  }
}

