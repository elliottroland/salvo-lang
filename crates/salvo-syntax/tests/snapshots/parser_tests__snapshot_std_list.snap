        Fn(
            FnDecl {
                docs: [
                    "Takes the last element out of the list, or answers `None` when it is",
                    "empty.",
                    "",
                    "O(1): nothing shifts. Like [remove_first], the element is moved out.",
                    "",
                    "```",
                    "let xs = Mut List(1, 2, 3)",
